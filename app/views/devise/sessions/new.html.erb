<% content_for :title, "Log in | Barangay Kalikid Sur" %>

<div class="flex min-h-screen flex-col bg-[#f5f4f7] font-sans text-slate-900">
  <header class="h-[74px] shrink-0 bg-white shadow-[0_5px_12px_rgba(15,23,42,0.18)] sm:h-[85px] lg:h-[94px]">
    <div class="mx-auto flex h-full w-full max-w-[1100px] items-center gap-2.5 px-5 sm:px-8">
      <div class="flex items-center gap-2.5">
        <span class="h-8 w-8 shrink-0 rounded-full bg-[#07349e] sm:h-10 sm:w-10" aria-hidden="true"></span>
        <span class="flex flex-col text-slate-900">
          <strong class="text-[16px] font-bold leading-tight tracking-[-0.04em] sm:text-[18px] lg:text-[30px]">Barangay Kalikid Sur</strong>
          <small class="mt-0.5 text-[8px] text-slate-600 sm:text-[9px] lg:text-[13px]">Digital System for Registered Residents</small>
        </span>
      </div>
    </div>
  </header>

  <main class="flex flex-1 items-center justify-center px-4 py-8 sm:px-6 lg:py-5">
    <section class="w-full max-w-[440px] rounded-xl bg-white px-5 pb-6 pt-7 shadow-[0_5px_18px_rgba(15,23,42,0.25)] sm:px-7 sm:pb-7 sm:pt-8 lg:px-6 lg:pb-7 lg:pt-8" aria-labelledby="login-title">
      <div class="mx-auto mb-4 h-[76px] w-[76px] rounded-full bg-white shadow-[0_2px_5px_rgba(15,23,42,0.2)] sm:h-[90px] sm:w-[90px] lg:mb-4 lg:h-[96px] lg:w-[96px]" aria-hidden="true"></div>

      <h1 id="login-title" class="mb-3 text-center text-[24px] font-bold leading-tight tracking-[-0.04em] sm:text-[27px] lg:text-[30px]">Welcome!</h1>
      <p class="mb-3 rounded-full bg-[#dce4ff] px-2 py-1 text-center text-[9px] font-bold tracking-[0.04em] text-[#07349e] sm:text-[11px] lg:py-1.5 lg:text-[13px]">KALIKID SUR, CABANATUAN CITY, NUEVA ECIJA</p>
      <p class="mb-6 text-center text-[11px] leading-[1.5] text-slate-600 sm:text-xs lg:mb-7 lg:text-[16px]">Access barangay clearance, certificates, indigency,<br class="hidden sm:block"> and community assistance online.</p>

      <% if resource.errors.any? %>
        <div class="mb-4 text-sm text-red-700 lg:text-[20px]" role="alert"><%= resource.errors.full_messages.to_sentence %></div>
      <% end %>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "text-left" }) do |f| %>
        <div class="mb-3 lg:mb-4">
          <%= f.label :email, class: "mb-1 block text-sm font-semibold lg:text-[20px]" %>
          <div class="flex h-11 items-center gap-2 rounded-lg bg-[#f1f2ff] px-3 sm:h-12 lg:h-[50px]">
            <svg class="h-3.5 w-3.5 shrink-0 text-slate-700 lg:h-4 lg:w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M3.5 6.5h17v12h-17z"/><path d="m4 7 8 6 8-6"/></svg>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "juan@gmail.com", class: "h-full min-w-0 flex-1 bg-transparent text-xs outline-none placeholder:text-slate-400 lg:text-[16px]" %>
          </div>
        </div>

        <div class="mb-1">
          <%= f.label :password, class: "mb-1 block text-sm font-semibold lg:text-[20px]" %>
          <div class="flex h-11 items-center gap-2 rounded-lg bg-[#f1f2ff] px-3 sm:h-12 lg:h-[50px]">
            <svg class="h-3.5 w-3.5 shrink-0 text-slate-700 lg:h-4 lg:w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="1.5"/><path d="M8 10V7a4 4 0 0 1 8 0v3m-4 4v3"/></svg>
            <%= f.password_field :password, autocomplete: "current-password", placeholder: "********", class: "h-full min-w-0 flex-1 bg-transparent text-xs tracking-[0.18em] outline-none placeholder:text-slate-400 lg:text-[16px]" %>
            <svg class="h-4 w-4 shrink-0 text-slate-700 lg:h-5 lg:w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M2.5 12s3.4-6 9.5-6 9.5 6 9.5 6-3.4 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.5"/></svg>
          </div>
        </div>

        <div class="mb-3 flex min-h-5 items-center justify-between lg:mb-4">
          <% if devise_mapping.rememberable? %>
            <label class="flex items-center gap-1.5 text-[10px] text-slate-600 lg:gap-2 lg:text-[13px]"><%= f.check_box :remember_me, class: "h-3.5 w-3.5 accent-[#1550a8]" %><span>Remember me</span></label>
          <% end %>
          <% if devise_mapping.recoverable? %>
            <%= link_to "Forgot Password?", new_password_path(resource_name), class: "ml-auto text-[10px] font-semibold text-[#07349e] no-underline lg:text-[13px]" %>
          <% end %>
        </div>

        <%= f.submit "Sign In", class: "h-10 w-full cursor-pointer rounded-lg border-0 bg-[#07349e] text-xs font-semibold text-white hover:bg-[#0d408f] sm:h-11 lg:h-[46px] lg:text-[16px]" %>
      <% end %>

      <% if devise_mapping.registerable? %>
        <p class="mt-5 rounded-lg bg-[#e5ecff] px-2.5 py-2.5 text-center text-[10px] text-slate-800 sm:mt-6 sm:text-xs lg:mt-6 lg:py-3 lg:text-[13px]">Don't have an online resident account yet?<%= link_to "Register", new_registration_path(resource_name), class: "font-bold text-[#07349e] no-underline" %></p>
      <% end %>
    </section>
  </main>

  <footer class="shrink-0 bg-[#edf2ff] px-5 py-6 text-[9px] leading-relaxed text-slate-600 sm:px-8 sm:py-7 lg:px-8 lg:py-8 lg:text-[13px]">
    <div class="mx-auto grid max-w-[1100px] grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
      <section>
        <h2 class="mb-2 text-[11px] font-bold text-slate-900 lg:text-[13px]">Barangay Kalikid Sur</h2>
        <p>Pamahalaang Barangay ng San Isidro. Serving the community with transparent, accessible, and automated civic government e-services for all registered constituents.</p>
        <p class="mt-2">Barangay Hall Complex, J.P. Rizal Avenue<br>Tel: 02 8876-5432 | Mobile: +63 917 123 4567<br>Email: desk@sanisidro.gov.ph</p>
      </section>
      <section>
        <h2 class="mb-2 text-[11px] font-bold text-slate-900 lg:text-[13px]">Republic Civic Legal Mandates</h2>
        <p>Compliant with Republic Act No. 10173 (Data Privacy Act of 2012) and RA 11032 (Ease of Doing Business and Efficient Government Service Delivery Act of 2018). All civic information submitted is treated with absolute institutional confidentiality.</p>
        <p class="mt-2 font-semibold text-emerald-700">♧ NPC Registered Government Portal · 256-Bit SSL Encrypted</p>
      </section>
      <section>
        <h2 class="mb-2 text-[11px] font-bold text-slate-900 lg:text-[13px]">Civic Operating Schedule</h2>
        <div class="rounded-md bg-[#e2eaff] p-3 lg:p-4">
          <p>Monday - Friday: 8:00 AM - 5:00 PM</p>
          <p>Saturday (Clearance Counter): 8:00 AM - 12:00 PM</p>
          <p class="font-bold text-red-700">24/7 Barangay Peacekeeping &amp; Emergency Desk Active</p>
        </div>
      </section>
    </div>
    <div class="mx-auto mt-5 flex max-w-[1100px] flex-col justify-between gap-2 border-t border-[#d9e2f7] pt-3 text-[8px] sm:flex-row lg:mt-6 lg:text-[11px]">
      <span>©<%= Date.current.year %> Barangay Kalikid Sur, Cabanatuan City, Nueva Ecija. All Rights Reserved.</span>
      <span class="flex gap-3 font-semibold"><span>Privacy Policy</span><span>Citizens Charter</span><span>Terms of Issuance</span></span>
    </div>
  </footer>
</div>
