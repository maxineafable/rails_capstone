<% # app/views/devise/registrations/new.html.erb %>

<div class="min-h-screen bg-gray-50 px-4 py-10">
  <div class="mx-auto max-w-2xl rounded-lg bg-white p-8 shadow-sm">

    <div class="mb-8">
      <h2 class="text-2xl font-bold text-gray-900">
        Resident Registration
      </h2>
      <p class="mt-1 text-sm text-gray-500">
        Create your account and provide your resident information.
      </p>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>

      <%= render "devise/shared/error_messages", resource: resource %>

      <!-- ACCOUNT INFORMATION -->
      <section class="mb-8">
        <h3 class="mb-4 text-lg font-semibold text-gray-900">
          Account Information
        </h3>

        <div class="space-y-4">

          <div>
            <%= f.label :email, "Email Address", class: "mb-1 block text-sm font-medium text-gray-700" %>
            <%= f.email_field :email,
                autofocus: true,
                autocomplete: "email",
                required: true,
                class: "w-full rounded-md border border-gray-300 px-3 py-2 focus:border-blue-600 focus:outline-none" %>
          </div>

          <div>
            <%= f.label :password, "Password", class: "mb-1 block text-sm font-medium text-gray-700" %>

            <% if @minimum_password_length %>
              <p class="mb-1 text-xs text-gray-500">
                Minimum <%= @minimum_password_length %> characters
              </p>
            <% end %>

            <%= f.password_field :password,
                autocomplete: "new-password",
                required: true,
                class: "w-full rounded-md border border-gray-300 px-3 py-2 focus:border-blue-600 focus:outline-none" %>
          </div>

          <div>
            <%= f.label :password_confirmation, "Confirm Password", class: "mb-1 block text-sm font-medium text-gray-700" %>

            <%= f.password_field :password_confirmation,
                autocomplete: "new-password",
                required: true,
                class: "w-full rounded-md border border-gray-300 px-3 py-2 focus:border-blue-600 focus:outline-none" %>
          </div>

        </div>
      </section>

      <!-- PERSONAL INFORMATION -->
      <section class="mb-8 border-t pt-8">
        <h3 class="mb-1 text-lg font-semibold text-gray-900">
          Personal Information
        </h3>

        <p class="mb-4 text-sm text-gray-500">
          Enter your basic personal information.
        </p>

        <% resource.build_profile unless resource.profile %>

        <%= f.fields_for :profile do |p| %>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">

            <div>
              <%= p.label :first_name, "First Name *", class: "mb-1 block text-sm font-medium text-gray-700" %>
              <%= p.text_field :first_name,
                  required: true,
                  class: "w-full rounded-md border border-gray-300 px-3 py-2 focus:border-blue-600 focus:outline-none" %>
            </div>

            <div>
              <%= p.label :middle_name, "Middle Name", class: "mb-1 block text-sm font-medium text-gray-700" %>
              <%= p.text_field :middle_name,
                  class: "w-full rounded-md border border-gray-300 px-3 py-2 focus:border-blue-600 focus:outline-none" %>
            </div>

            <div>
              <%= p.label :last_name, "Last Name *", class: "mb-1 block text-sm font-medium text-gray-700" %>
              <%= p.text_field :last_name,
                  required: true,
                  class: "w-full rounded-md border border-gray-300 px-3 py-2 focus:border-blue-600 focus:outline-none" %>
            </div>

            <div>
              <%= p.label :suffix, "Suffix", class: "mb-1 block text-sm font-medium text-gray-700" %>
              <%= p.text_field :suffix,
                  placeholder: "Jr., Sr., III",
                  class: "w-full rounded-md border border-gray-300 px-3 py-2 focus:border-blue-600 focus:outline-none" %>
            </div>

            <div>
              <%= p.label :birth_date, "Birth Date *", class: "mb-1 block text-sm font-medium text-gray-700" %>
              <%= p.date_field :birth_date,
                  required: true,
                  class: "w-full rounded-md border border-gray-300 px-3 py-2 focus:border-blue-600 focus:outline-none" %>
            </div>

            <div>
              <%= p.label :sex, "Sex *", class: "mb-1 block text-sm font-medium text-gray-700" %>
              <%= p.select :sex,
                  [["Male", "male"], ["Female", "female"]],
                  { include_blank: "Select Sex" },
                  { required: true, class: "w-full rounded-md border border-gray-300 bg-white px-3 py-2 focus:border-blue-600 focus:outline-none" } %>
            </div>

          </div>
        <% end %>
      </section>

      <!-- ADDRESS -->
      <section class="mb-8 border-t pt-8">
        <h3 class="mb-1 text-lg font-semibold text-gray-900">
          Barangay Address
        </h3>

        <p class="mb-4 text-sm text-gray-500">
          Enter your current residential address.
        </p>

        <% resource.build_address unless resource.address %>

        <%= f.fields_for :address do |a| %>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">

            <div>
              <%= a.label :house_number, "House / Building Number *", class: "mb-1 block text-sm font-medium text-gray-700" %>
              <%= a.text_field :house_number,
                  required: true,
                  class: "w-full rounded-md border border-gray-300 px-3 py-2 focus:border-blue-600 focus:outline-none" %>
            </div>

            <div>
              <%= a.label :street, "Street Address *", class: "mb-1 block text-sm font-medium text-gray-700" %>
              <%= a.text_field :street,
                  required: true,
                  class: "w-full rounded-md border border-gray-300 px-3 py-2 focus:border-blue-600 focus:outline-none" %>
            </div>

            <div>
              <%= a.label :purok, "Purok / Zone *", class: "mb-1 block text-sm font-medium text-gray-700" %>
              <%= a.text_field :purok,
                  required: true,
                  class: "w-full rounded-md border border-gray-300 px-3 py-2 focus:border-blue-600 focus:outline-none" %>
            </div>

            <div>
              <%= a.label :barangay, "Barangay *", class: "mb-1 block text-sm font-medium text-gray-700" %>
              <%= a.text_field :barangay,
                  value: "Cabanatuan Barangay",
                  required: true,
                  class: "w-full rounded-md border border-gray-300 px-3 py-2 focus:border-blue-600 focus:outline-none" %>
            </div>

            <div>
              <%= a.label :city, "City / Municipality *", class: "mb-1 block text-sm font-medium text-gray-700" %>
              <%= a.text_field :city,
                  value: "Cabanatuan City",
                  required: true,
                  class: "w-full rounded-md border border-gray-300 px-3 py-2 focus:border-blue-600 focus:outline-none" %>
            </div>

            <div>
              <%= a.label :province, "Province *", class: "mb-1 block text-sm font-medium text-gray-700" %>
              <%= a.text_field :province,
                  value: "Nueva Ecija",
                  required: true,
                  class: "w-full rounded-md border border-gray-300 px-3 py-2 focus:border-blue-600 focus:outline-none" %>
            </div>

          </div>
        <% end %>
      </section>

      <!-- SUBMIT -->
      <div class="border-t pt-6">
        <%= f.submit "Register New Account",
            class: "w-full rounded-md bg-blue-800 px-4 py-3 font-semibold text-white hover:bg-blue-900" %>
      </div>

    <% end %>

    <div class="mt-6 text-center text-sm">
      <%= render "devise/shared/links" %>
    </div>

  </div>
</div>