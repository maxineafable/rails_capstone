<% content_for :title, "Pagpapalit ng Password | KaSurbisyo" %>

<div class="flex min-h-screen flex-col bg-[#f5f4f7] font-sans text-slate-900">
  <%= render "devise/shared/auth_navbar" %>

  <main class="flex flex-1 items-center justify-center px-4 py-8 sm:px-6 sm:py-10 lg:min-h-[650px]">
    <section class="w-full max-w-[440px] rounded-xl bg-white px-5 pb-7 pt-8 shadow-[0_5px_18px_rgba(15,23,42,0.25)] sm:px-7 sm:pb-8 sm:pt-9 lg:px-[26px] lg:pb-10 lg:pt-11" aria-labelledby="reset-password-title">
      <div class="mx-auto mb-5 flex h-[76px] w-[76px] items-center justify-center rounded-full bg-white text-[#07349e] shadow-[0_2px_5px_rgba(15,23,42,0.2)] sm:h-[90px] sm:w-[90px] lg:h-[100px] lg:w-[100px]" aria-hidden="true">
        <svg class="h-9 w-9 sm:h-11 sm:w-11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M7 10V7a5 5 0 0 1 9.7-1.7M5 10h14v11H5z"/><circle cx="12" cy="15" r="1.2"/><path d="M12 16.2V18"/></svg>
      </div>

      <h1 id="reset-password-title" class="mb-2 text-center text-[24px] font-bold leading-tight tracking-[-0.04em] sm:text-[27px] lg:text-[30px]">Nakalimutan ang password?</h1>
      <p class="mb-6 text-center text-xs leading-relaxed text-slate-600 sm:text-[13px]">Ilagay ang email na gamit sa inyong account. Ipapadala namin dito ang mga tagubilin sa pagpapalit ng password.</p>

      <% if flash[:alert].present? || resource.errors.any? %>
        <div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700" role="alert">
          <%= flash[:alert].presence || resource.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <% if flash[:notice].present? %>
        <div class="mb-4 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800" role="status">
          <%= flash[:notice] %>
        </div>
      <% end %>

      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "text-left" }) do |f| %>
        <div class="mb-5">
          <%= f.label :email, class: "mb-1 block text-sm font-semibold lg:text-[16px]" %>
          <div class="flex h-11 items-center gap-2 rounded-lg bg-[#f1f2ff] px-3 sm:h-12 lg:h-[50px]">
            <svg class="h-4 w-4 shrink-0 text-slate-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M3.5 6.5h17v12h-17z"/><path d="m4 7 8 6 8-6"/></svg>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "juan@gmail.com", class: "h-full min-w-0 flex-1 bg-transparent text-sm outline-none placeholder:text-slate-400 lg:text-[16px]" %>
          </div>
        </div>

        <%= f.submit "Ipadala ang mga tagubilin", class: "h-11 w-full cursor-pointer rounded-lg border-0 bg-[#174da8] text-sm font-semibold text-white hover:bg-[#0d408f] sm:h-12 lg:h-[48px] lg:text-[16px]" %>
      <% end %>

      <p class="mt-6 text-center text-sm text-slate-600">
        Naalala na ang password?
        <%= link_to "Mag-log in", new_session_path(resource_name), class: "font-bold text-[#07349e] no-underline hover:underline" %>
      </p>
    </section>
  </main>

  <footer class="mx-4 mb-4 shrink-0 overflow-hidden rounded-3xl border border-blue-100 bg-[#eff5ff] px-5 py-6 text-[9px] leading-relaxed text-slate-600 sm:mx-6 sm:px-8 sm:py-8 lg:mx-8 lg:px-10 lg:py-10 lg:text-[12px]">
    <div class="-mx-5 -mt-6 mb-6 h-1.5 bg-gradient-to-r from-[#2147bd] via-[#2147bd] to-emerald-600 sm:-mx-8 sm:-mt-8 lg:-mx-10 lg:-mt-10"></div>
    <div class="mx-auto grid max-w-[1300px] grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
      <section class="rounded-2xl bg-white/80 p-5 lg:p-6">
        <h2 class="mb-2 text-[11px] font-bold text-blue-700 lg:text-[13px]">PROTEKSYON SA ILALIM NG BATAS</h2>
        <p class="mb-3 font-semibold text-slate-900">Republic of the Philippines • Republic Act No. 10173 (Data Privacy Act of 2012)</p>
        <p>Pinoprotektahan ang impormasyong ipinasa at ginagamit lamang para sa opisyal na transaksyon sa barangay.</p>
        <p class="mt-2 italic">Ang nakalap na impormasyon ay protektado at gagamitin lamang para sa opisyal na transaksyon ng barangay.</p>
        <p class="mt-5 border-t border-slate-100 pt-3 font-semibold text-emerald-700">Ligtas na Pagproseso ng mga Transaksyon</p>
      </section>
      <section class="rounded-2xl bg-white/80 p-5 lg:p-6">
        <h2 class="mb-2 text-[11px] font-bold text-emerald-700 lg:text-[13px]">MAHUSAY NA SERBISYO NG PAMAHALAAN</h2>
        <p class="mb-3 font-semibold text-slate-900">Anti-Red Tape Act (ARTA / RA 11032)</p>
        <p>Sinusuportahan ng sistemang ito ang maayos na paghahatid ng serbisyo ng pamahalaan.</p>
        <p class="mt-2 italic">Sumusuporta ang sistemang ito sa maagap, maayos, at mabilis na paghahatid ng serbisyo-publiko.</p>
        <p class="mt-3 border-t border-slate-100 pt-3 font-semibold text-slate-900">MGA SERBISYO NG BARANGAY</p>
        <p class="mt-2 text-blue-700">› Barangay Clearance<br>› Certificate of Residency<br>› Certificate of Indigency</p>
      </section>
      <section class="rounded-2xl bg-white/80 p-5 lg:p-6">
        <h2 class="mb-4 text-[11px] font-bold text-slate-900 lg:text-[13px]">TULONG PUBLIKO NG BARANGAY</h2>
        <p class="mb-1 text-[9px] font-semibold uppercase text-slate-400">Tirahan</p>
        <p class="mb-4 text-slate-900">Barangay Hall, Kalikid Sur, Cabanatuan City, Nueva Ecija</p>
        <p class="mb-1 text-[9px] font-semibold uppercase text-slate-400">Telepono</p>
        <p class="mb-4 text-slate-900">(044) 940-1234</p>
        <p class="mb-1 text-[9px] font-semibold uppercase text-slate-400">Email</p>
        <p class="mb-4 text-blue-700">kalikidsur.cabanatuan@gmail.com</p>
        <p class="mb-1 text-[9px] font-semibold uppercase text-slate-400">Oras ng Opisina</p>
        <p class="text-slate-900">Lunes hanggang Biyernes, 8:00 AM – 5:00 PM</p>
      </section>
    </div>
    <div class="mx-auto mt-6 flex max-w-[1300px] flex-col justify-between gap-2 border-t border-blue-100 pt-4 text-[8px] sm:flex-row lg:mt-8 lg:text-[11px]">
      <span>© <%= Date.current.year %> Barangay Kalikid Sur Serbisyong Online ng Barangay</span>
      <span class="flex gap-3 font-semibold"><span>Patakaran sa Pagkapribado</span><span>•</span><span>Mga Tuntunin sa Paggamit</span><span>•</span><span>Makipag-ugnayan</span></span>
    </div>
  </footer>
</div>
