<div>
  <h1>Resident Dashboard</h1>
  <p>Welcome back, <%= current_user.profile.first_name %>!</p>

  <div>
    <%= link_to "Request Document", select_document_type_path %>
    <%= link_to "Report Concern", new_barangay_concern_path %>
  </div>

  <section>
    <h2>My Document Requests History</h2>

    <% if @document_requests.any? %>
      <table border="1" cellpadding="8" cellspacing="0" style="width: 100%; border-collapse: collapse; text-align: left;">
        <thead>
          <tr style="background-color: #f2f2f2;">
            <th>Document Type</th>
            <th>Purpose</th>
            <th>Date Requested</th>
            <th>Status</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% @document_requests.each do |request| %>
            <tr>
              <td><%= request.document_type.humanize %></td>
              <td><%= request.purpose %></td>
              <td><%= request.created_at.strftime("%B %d, %Y at %I:%M %p") %></td>
              <td>
                <!-- Dynamic styling placeholders for capstone status color visual testing -->
                <span class="status-badge <%= request.status %>">
                  <strong><%= request.status.humanize %></strong>
                </span>
              </td>
              <td>
                <%= link_to "View Details", root_path %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p>You haven't submitted any document requests yet.</p>
    <% end %>
  </section>

  <section>
    <h2>My Reported Concerns</h2>
    <%= link_to "🚨 File a Concern/Complaint", new_barangay_concern_path %>
    <br><br>

    <% if @barangay_concerns.any? %>
      <table border="1" cellpadding="8" cellspacing="0" style="width: 100%; border-collapse: collapse; text-align: left;">
        <thead>
          <tr style="background-color: #f2f2f2;">
            <th>Category</th>
            <th>Reason Summary</th>
            <th>Date Filed</th>
            <th>Status</th>
            <th>Date Resolved</th>
          </tr>
        </thead>
        <tbody>
          <% @barangay_concerns.each do |concern| %>
            <tr>
              <td><%= concern.category.humanize %></td>
              <td><%= truncate(concern.reason, length: 50) %></td>
              <td><%= concern.created_at.strftime("%B %d, %Y") %></td>
              <td><strong><%= concern.status.humanize %></strong></td>
              <td><%= concern.resolved_at ? concern.resolved_at.strftime("%B %d, %Y") : "—" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p>You haven't reported any public concerns or issues yet.</p>
    <% end %>
  </section>
</div>
