<div class="min-h-screen bg-[#f4f6fb] font-sans text-slate-900">
  <%= render "shared/navbar", active: :home %>

  <div class="mx-auto max-w-[1280px] space-y-5 px-4 py-5 sm:px-6 sm:py-7 lg:space-y-7 lg:px-6 lg:py-9">
    <section class="flex flex-col gap-5 rounded-2xl border border-white bg-white p-5 shadow-[0_8px_28px_rgba(15,23,42,0.06)] sm:p-6 lg:flex-row lg:items-center lg:justify-between lg:gap-8 lg:p-8" aria-labelledby="welcome-title">
      <div class="min-w-0">
        <p class="mb-2 inline-flex max-w-full items-center gap-1 rounded-full bg-emerald-50 px-2.5 py-1 text-[9px] font-semibold text-emerald-800 ring-1 ring-inset ring-emerald-200 lg:mb-3 lg:gap-2 lg:px-4 lg:py-2 lg:text-[13px]">
          <span aria-hidden="true"><% if current_user.profile.present? && current_user.address.present? %><%= image_tag "verified.svg", class: "h-3.5 w-3.5 object-contain", alt: "" %><% else %>●<% end %></span>
          <% if current_user.profile.present? && current_user.address.present? %>
            BERIPIKADONG RESIDENTE
          <% else %>
            ACCOUNT NG RESIDENTE
          <% end %>
          <% if current_user.address&.purok.present? %>
           ● <%= current_user.address.purok %>
          <% end %>
          <% if current_user.address&.barangay.present? %>
            <span class="uppercase"><%= current_user.address.barangay %></span>
          <% end %>
        </p>
        <h1 id="welcome-title" class="text-[23px] font-bold leading-tight tracking-[-0.04em] text-[#07349e] sm:text-[27px] lg:text-[36px]">Maligayang pagdating, <%= current_user.profile.first_name %>!</h1>
        <p class="mt-1 max-w-[760px] text-xs leading-relaxed text-slate-600 lg:mt-2 lg:text-[16px]">Maligayang pagdating sa inyong digital na tanggapan para sa mamamayan! Subaybayan ang inyong mga kahilingan at reklamo at makibahagi sa paghahatid ng mabilis, maayos, at tapat na serbisyo publiko.</p>
        <% unless current_user.profile.present? && current_user.address.present? %>
          <p class="mt-2 text-xs text-amber-800 lg:mt-3 lg:text-[16px]">Kumpletuhin ang inyong impormasyon upang magamit ang lahat ng serbisyo. <%= link_to "Ituloy ang pagpaparehistro", current_user.profile.present? ? edit_profile_path : new_profile_path, class: "font-semibold underline" %></p>
        <% end %>
      </div>

      <dl class="grid w-full shrink-0 grid-cols-3 gap-1 rounded-lg bg-[#eff3ff] p-1.5 text-center lg:w-[390px] lg:gap-2 lg:p-2">
  <div class="flex flex-col items-center rounded-md bg-white px-2 py-2 lg:px-3 lg:py-4">
    <dt class="flex h-[24px] items-center justify-center text-[8px] font-semibold uppercase leading-tight tracking-wide text-slate-600 lg:h-[40px] lg:text-[13px]">
      Aktibong<br>Kahilingan
    </dt>
    <dd class="mt-1 text-[30px] font-bold leading-tight text-[#07349e] lg:mt-2 lg:text-[48px]"><%= format("%02d", @active_requests) %></dd>
  </div>

  <div class="flex flex-col items-center rounded-md bg-white px-2 py-2 lg:px-3 lg:py-4">
    <dt class="flex h-[24px] items-center justify-center text-[8px] font-semibold uppercase leading-tight tracking-wide text-slate-600 lg:h-[40px] lg:text-[13px]">
      Aktibong<br>Reklamo
    </dt>
    <dd class="mt-1 text-[30px] font-bold leading-tight text-slate-900 lg:mt-2 lg:text-[48px]"><%= format("%02d", @active_reports) %></dd>

  </div>

  <div class="flex flex-col items-center rounded-md bg-white px-2 py-2 lg:px-3 lg:py-4">
    <dt class="flex h-[24px] items-center justify-center text-[8px] font-semibold uppercase leading-tight tracking-wide text-slate-600 lg:h-[40px] lg:text-[13px]">
      Kompleto
    </dt>
    <dd class="mt-1 text-[30px] font-bold leading-tight text-emerald-700 lg:mt-2 lg:text-[48px]"><%= format("%02d", @completed_records) %></dd>
  </div>
</dl>
    </section>

    <section class="grid grid-cols-1 gap-4 lg:grid-cols-2" aria-label="Resident services">
      <article class="group flex min-h-[230px] flex-col rounded-2xl border-l-4 border-[#174da8] bg-white p-5 shadow-[0_8px_24px_rgba(15,23,42,0.06)] transition-shadow hover:shadow-[0_12px_30px_rgba(15,23,42,0.1)] sm:p-6 lg:min-h-[340px] lg:border-l-[6px] lg:p-8">
        <div class="flex items-center justify-between gap-2">
          <span class="inline-flex items-center gap-1 rounded-full bg-blue-50 px-2 py-1 text-[8px] font-bold text-[#174da8] ring-1 ring-inset ring-blue-100 lg:gap-1.5 lg:px-3 lg:py-1.5 lg:text-[13px]">
            <%= image_tag "documents.svg", alt: "", class: "h-3 w-3 shrink-0 lg:h-4 lg:w-4" %>
            SERBISYO NG DOKUMENTASYON
          </span>
          <span class="text-[9px] text-slate-500 lg:text-[13px]">Pagproseso: 1–2 araw ng trabaho</span>
        </div>
        <h2 class="mt-3 text-[19px] font-bold leading-tight tracking-[-0.03em] text-[#07349e] lg:mt-5 lg:text-[30px]">Kumuha ng Dokumento</h2>
        <p class="mt-1 text-[11px] text-slate-600 lg:mt-2 lg:text-[15px]">Humiling ng Opisyal na Dokumento o Sertipikasyon</p>
        <p class="mt-2 text-[11px] leading-relaxed text-slate-600 lg:mt-3 lg:text-[16px]">Ligtas at opisyal na dokumento ng barangay. Madaling magpadala ng kahilingan, beripikahin ang mga tala, at mag-iskedyul ng pagkuha sa tanggapan.</p>
        <ul class="mt-3 grid grid-cols-1 gap-x-3 gap-y-1 rounded-md bg-[#eff3ff] p-3 text-[9px] sm:grid-cols-2 lg:mt-4 lg:gap-x-5 lg:gap-y-2 lg:p-4 lg:text-[13px]">
          <li class="flex items-center gap-1.5"><%= image_tag "barangayclearance.svg", alt: "", class: "h-3.5 w-3.5 shrink-0 object-contain" %><span>Barangay Clearance</span></li>
          <li class="flex items-center gap-1.5"><%= image_tag "certificateofrecidency.svg", alt: "", class: "h-3.5 w-3.5 shrink-0 object-contain" %><span>Certificate of Residency</span></li>
          <li class="flex items-center gap-1.5"><%= image_tag "certificateofindigency.svg", alt: "", class: "h-3.5 w-3.5 shrink-0 object-contain" %><span>Certificate of Indigency</span></li>
          <li class="flex items-center gap-1.5"><%= image_tag "others.svg", alt: "", class: "h-3.5 w-3.5 shrink-0 object-contain" %><span>At iba pa</span></li>
        </ul>
        <%= link_to "Bagong Kahilingan  →", select_document_type_path, class: "mt-4 self-end rounded-lg bg-[#174da8] px-5 py-2.5 text-[10px] font-semibold text-white no-underline shadow-sm transition hover:bg-[#0b2e83] focus:outline-none focus:ring-2 focus:ring-blue-300 focus:ring-offset-2 lg:mt-6 lg:px-7 lg:py-3.5 lg:text-[16px]" %>
      </article>

      <article class="group flex min-h-[230px] flex-col rounded-2xl border-l-4 border-emerald-700 bg-white p-5 shadow-[0_8px_24px_rgba(15,23,42,0.06)] transition-shadow hover:shadow-[0_12px_30px_rgba(15,23,42,0.1)] sm:p-6 lg:min-h-[340px] lg:border-l-[6px] lg:p-8">
        <div class="flex items-center justify-between gap-2">
          <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2 py-1 text-[8px] font-bold text-emerald-800 ring-1 ring-inset ring-emerald-200 lg:gap-1.5 lg:px-3 lg:py-1.5 lg:text-[13px]"><%= image_tag "action.svg", alt: "", class: "h-3 w-3 shrink-0 lg:h-4 lg:w-4" %> AKSYON SA MGA ULAT NG BARANGAY</span>
          <span class="text-[9px] text-slate-500 lg:text-[13px]">Pagtugon ng Tanod at Tagapag-ayos</span>
        </div>
        <h2 class="mt-3 text-[19px] font-bold leading-tight tracking-[-0.03em] text-emerald-700 lg:mt-5 lg:text-[30px]">Mag-ulat ng Suliranin</h2>
        <p class="mt-1 text-[11px] text-slate-600 lg:mt-2 lg:text-[15px]">Mag-ulat ng Sumbong o Suliranin sa Komunidad</p>
        <p class="mt-2 text-[11px] leading-relaxed text-slate-600 lg:mt-3 lg:text-[16px]">Ipaabot sa barangay ang mga suliranin sa pasilidad at kalinisan. Mag-upload ng larawan, ilagay ang tiyak na lokasyon, at subaybayan ang aksyon ng Tagapamahala</p>
        <ul class="mt-3 grid grid-cols-1 gap-x-3 gap-y-1 rounded-lg bg-emerald-50 p-3 text-[9px] text-emerald-900 ring-1 ring-inset ring-emerald-100 sm:grid-cols-2 lg:mt-4 lg:gap-x-5 lg:gap-y-2 lg:p-4 lg:text-[13px]">
          <li class="flex items-center gap-2"><%= image_tag "streetlight.svg", alt: "", class: "h-4 w-4 shrink-0 object-contain" %><span>Sirang Ilaw sa Kalsada</span></li>
          <li class="flex items-center gap-2"><%= image_tag "drainage.svg", alt: "", class: "h-4 w-4 shrink-0 object-contain" %><span>Baradong Kanal at Baha</span></li>
          <li class="flex items-center gap-2"><%= image_tag "garbage.svg", alt: "", class: "h-4 w-4 shrink-0 object-contain" %><span>Hindi Nakolektang Basura</span></li>
          <li class="flex items-center gap-2"><%= image_tag "roads.svg", alt: "", class: "h-4 w-4 shrink-0 object-contain" %><span>Panganib at Harang sa Daan</span></li>
        </ul>
        <%= link_to "Mag-ulat ng Suliranin  →", new_barangay_concern_path, class: "mt-4 self-end rounded-lg bg-emerald-700 px-5 py-2.5 text-[10px] font-semibold text-white no-underline shadow-sm transition hover:bg-emerald-800 focus:outline-none focus:ring-2 focus:ring-emerald-300 focus:ring-offset-2 lg:mt-6 lg:px-7 lg:py-3.5 lg:text-[16px]" %>
      </article>
    </section>

    <%= turbo_frame_tag "recent_records", data: { turbo_action: "advance" } do %>
    <section id="recent-records" class="scroll-mt-20 rounded-2xl border border-white bg-white p-4 shadow-[0_8px_28px_rgba(15,23,42,0.06)] sm:p-6 lg:p-8" aria-labelledby="recent-title">
      <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between lg:mb-6">
        <div>
          <h2 id="recent-title" class="flex items-center gap-2 text-[18px] font-bold tracking-[-0.03em] sm:text-[20px] lg:text-[30px]"><span class="h-2.5 w-2.5 rounded-full bg-[#174da8]" aria-hidden="true"></span>Kailangan o reklamo na sinusuri o handa nang kunin</h2>
        </div>
        <% active_filter = params[:filter] || "all" %>
        <div class="mb-4 flex flex-wrap gap-1 text-[9px] lg:mb-0 lg:gap-2 lg:text-[13px]">
          <%= link_to dashboard_path(filter: "all", anchor: "recent-records"),
                data: { turbo_frame: "recent_records" },
                class: "rounded-full px-2.5 py-1.5 font-semibold no-underline transition lg:px-4 lg:py-2.5 #{active_filter == "all" ? 'bg-blue-100 text-[#07349e]' : 'bg-slate-50 text-slate-700 hover:bg-blue-50'}" do %>
            Lahat ng Talaan (<%= @document_requests.size + @barangay_concerns.size %>)
          <% end %>

          <%= link_to dashboard_path(filter: "documents", anchor: "recent-records"),
                data: { turbo_frame: "recent_records" },
                class: "rounded-full px-2.5 py-1.5 font-semibold no-underline transition lg:px-4 lg:py-2.5 #{active_filter == "documents" ? 'bg-blue-100 text-[#07349e]' : 'bg-slate-50 text-slate-700 hover:bg-blue-50'}" do %>
            Mga Dokumento (<%= @document_requests.size %>)
          <% end %>

          <%= link_to dashboard_path(filter: "concerns", anchor: "recent-records"),
                data: { turbo_frame: "recent_records" },
                class: "rounded-full px-2.5 py-1.5 font-semibold no-underline transition lg:px-4 lg:py-2.5 #{active_filter == "concerns" ? 'bg-blue-100 text-[#07349e]' : 'bg-slate-50 text-slate-700 hover:bg-blue-50'}" do %>
            Mga Ulat (<%= @barangay_concerns.size %>)
          <% end %>
        </div>
      </div>

      <% if @recent_records.any? %>
        <div class="max-h-[65vh] overflow-auto overscroll-contain rounded-lg ring-1 ring-slate-100 lg:max-h-[460px]">
          <table class="w-full min-w-[680px] border-collapse text-left lg:min-w-[900px]">
            <thead class="sticky top-0 z-10 bg-[#eff3ff]">
              <tr class="text-[8px] font-semibold uppercase tracking-wide text-slate-600 lg:text-[13px]">
                <th class="px-3 py-3 lg:px-4 lg:py-4">Pagsubaybay Ref Number</th>
                <th class="px-3 py-3 lg:px-4 lg:py-4">Uri ng Serbisyo / Suliranin</th>
                <th class="px-3 py-3 lg:px-4 lg:py-4">Petsa ng Pagpasa</th>
                <th class="px-3 py-3 lg:px-4 lg:py-4">Kasalukuyang Kalagayan</th>
                <th class="px-3 py-3 lg:px-4 lg:py-4">Aksyon</th>
              </tr>
            </thead>
            <tbody class="text-[10px] lg:text-[16px]">
              <% @recent_records.each do |record| %>
                <% is_request = record.is_a?(DocumentRequest) %>
                <% status_label = tagalog_status(record.status) %>
                <% status_color = tagalog_status_class(record.status) %>
                <% record_icon = if is_request
                  { "barangay_clearance" => "barangayclearance.svg", "certificate_of_residency" => "certificateofrecidency.svg", "certificate_of_indigency" => "certificateofindigency.svg" }.fetch(record.document_type, "documents.svg")
                else
                  { "health_and_sanitation" => "drainage.svg", "infrastructure" => "roads.svg", "peace_and_order" => "streetlight.svg", "waste_management" => "garbage.svg", "others" => "others.svg" }.fetch(record.category, "others.svg")
                end %>

                <tr class="border-b border-slate-100 last:border-0 hover:bg-slate-50/50 transition">

                  <td class="px-3 py-3 font-semibold text-[#07349e]">
                    <% tracking_token = is_request ? (record.tracking_number.presence || "REQ-#{record.id}") : (record.tracking_number.presence || "BRGY-#{record.id}") %>
                    <div class="flex items-center gap-1.5">
                      <%= image_tag record_icon, alt: "", class: "h-4 w-4 shrink-0 object-contain" %>
                      <%= link_to tracking_token, (is_request ? document_request_path(record) : barangay_concern_path(record)), data: { turbo_frame: "remote_modal" }, class: "no-underline hover:underline" %>
                    </div>
                  </td>

                  <td class="px-3 py-3 lg:px-4 lg:py-4">
                    <span class="block font-medium"><%= tagalog_label(is_request ? record.document_type : record.category) %></span>
                    <span class="mt-0.5 block max-w-[300px] text-[9px] text-slate-500 lg:text-[13px]">
                      <%= is_request ? "Layunin: #{truncate(record.purpose, length: 68)}" : truncate(record.reason, length: 68) %>
                    </span>
                  </td>

                  <td class="px-3 py-3 lg:px-4 lg:py-4">
                    <%= tagalog_date(record.created_at) %>
                    <span class="mt-0.5 block text-[9px] text-slate-500 lg:text-[13px]"><%= record.created_at.strftime("%I:%M %p") %></span>
                  </td>

                  <td class="px-3 py-3 lg:px-4 lg:py-4">
                    <span class="inline-flex rounded-full px-2.5 py-1 text-[8px] font-bold lg:text-[13px] <%= status_color %>">
                      ● <%= status_label.upcase %>
                    </span>
                  </td>

                  <td class="px-3 py-3 lg:px-4 lg:py-4">
                    <%= link_to "Tingnan", (is_request ? document_request_path(record) : barangay_concern_path(record)), data: { turbo_frame: "remote_modal" }, class: "font-semibold text-[#07349e] underline" %>
                  </td>

                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="rounded-md bg-[#f7f8fc] px-4 py-8 text-center text-xs text-slate-600 lg:px-8 lg:py-12 lg:text-[16px]">
          <% if active_filter == "documents" %>
            Wala ka pang ipinadalang kahilingan para sa dokumento.
          <% elsif active_filter == "concerns" %>
            Wala ka pang iniulat na suliranin sa komunidad.
          <% else %>
            Wala ka pang ipinadalang kahilingan o ulat. Gamitin ang mga serbisyo sa itaas upang magsimula.
          <% end %>
        </div>
      <% end %>
    </section>
    <% end %>
  </div>

  <footer class="mx-4 mb-4 overflow-hidden rounded-[24px] border border-blue-100 bg-[#eff5ff] px-5 pb-5 text-[10px] leading-relaxed text-slate-600 shadow-[0_10px_30px_rgba(15,23,42,0.08)] sm:mx-6 sm:rounded-[28px] sm:px-8 sm:pb-7 lg:mx-8 lg:px-10 lg:pb-9 lg:text-[12px]">
    <div class="-mx-5 mb-5 h-1.5 bg-gradient-to-r from-[#2147bd] via-[#2147bd] to-emerald-600 sm:-mx-8 sm:mb-7 lg:-mx-10"></div>

    <div class="mx-auto grid max-w-[1300px] grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-7">
      <section class="flex flex-col rounded-2xl border border-white bg-white/90 p-5 shadow-sm lg:p-6" aria-labelledby="footer-privacy-title">
        <div class="mb-4 flex items-start gap-3">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-[#315bc4]" aria-hidden="true">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3 19 6v5c0 4.5-2.8 8-7 10-4.2-2-7-5.5-7-10V6z"/><path d="m9 12 2 2 4-4"/></svg>
          </span>
          <div>
            <h2 id="footer-privacy-title" class="text-[11px] font-bold tracking-wide text-blue-700 lg:text-[12px]">PROTEKSYON SA ILALIM NG BATAS</h2>
            <p class="mt-1 font-semibold leading-snug text-slate-900">Republika ng Pilipinas • Republic Act No. 10173 (Batas sa Pagkapribado ng Datos ng 2012)</p>
          </div>
        </div>
        <p>Pinoprotektahan ang impormasyong ipinasa at ginagamit lamang para sa opisyal na transaksyon sa barangay.</p>
        <p class="mt-2 italic text-slate-500">Ang nakalap na impormasyon ay protektado at gagamitin lamang para sa opisyal na transaksyon ng barangay.</p>
        <p class="mt-auto border-t border-slate-100 pt-4 font-semibold text-emerald-700"><span class="mr-1.5" aria-hidden="true">●</span>Ligtas na Pagproseso ng mga Transaksyon</p>
      </section>

      <section class="rounded-2xl border border-white bg-white/90 p-5 shadow-sm lg:p-6" aria-labelledby="footer-efficiency-title">
        <div class="mb-4 flex items-start gap-3">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700" aria-hidden="true">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>
          </span>
          <div>
            <h2 id="footer-efficiency-title" class="text-[11px] font-bold tracking-wide text-emerald-700 lg:text-[12px]">MAHUSAY NA SERBISYO NG PAMAHALAAN</h2>
        <p class="mt-1 font-semibold leading-snug text-slate-900">Anti-Red Tape Act (Batas Laban sa Red Tape / RA 11032)</p>
          </div>
        </div>
        <p>Sinusuportahan ng sistemang ito ang maayos na paghahatid ng serbisyo ng pamahalaan.</p>
        <p class="mt-2 italic text-slate-500">Sumusuporta ang sistemang ito sa maagap, maayos, at mabilis na paghahatid ng serbisyo-publiko.</p>
        <div class="mt-4 border-t border-slate-100 pt-4">
          <h3 class="mb-2 text-[10px] font-bold tracking-wide text-slate-800">MGA SERBISYO NG BARANGAY</h3>
          <ul class="space-y-1.5 text-blue-700">
            <li><%= link_to "›  Barangay Clearance", select_document_type_path, class: "no-underline hover:underline" %></li>
            <li><%= link_to "›  Certificate of Residency", select_document_type_path, class: "no-underline hover:underline" %></li>
            <li><%= link_to "›  Certificate of Indigency", select_document_type_path, class: "no-underline hover:underline" %></li>
          </ul>
        </div>
      </section>

      <section class="rounded-2xl border border-white bg-white/90 p-5 shadow-sm sm:col-span-2 lg:col-span-1 lg:p-6" aria-labelledby="footer-assistance-title">
        <h2 id="footer-assistance-title" class="mb-4 flex items-center gap-2 text-[11px] font-bold tracking-wide text-slate-900 lg:text-[12px]"><span class="h-2 w-2 rounded-full bg-emerald-600" aria-hidden="true"></span>TULONG PUBLIKO NG BARANGAY</h2>
        <dl class="space-y-3">
          <div class="flex gap-3"><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-700" aria-hidden="true"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12Z"/><circle cx="12" cy="9" r="2.2"/></svg></span><div><dt class="text-[9px] font-semibold uppercase tracking-wide text-slate-400">Tirahan</dt><dd class="text-slate-800">Barangay Hall, Kalikid Sur, Lungsod ng Cabanatuan, Nueva Ecija</dd></div></div>
          <div class="flex gap-3"><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-700" aria-hidden="true"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M7 3h3l2 5-2.5 1.5a14 14 0 0 0 5 5L16 12l5 2v3c0 2-1.5 4-4 4A16 16 0 0 1 3 7c0-2.5 2-4 4-4Z"/></svg></span><div><dt class="text-[9px] font-semibold uppercase tracking-wide text-slate-400">Telepono</dt><dd><a class="font-medium text-slate-800 no-underline hover:text-blue-700" href="tel:+63449401234">(044) 940-1234</a></dd></div></div>
