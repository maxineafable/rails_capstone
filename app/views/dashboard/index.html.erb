<div class="space-y-8">
  <header>
    <h1 class="text-2xl font-bold">Resident Dashboard</h1>
    <p class="text-gray-600">
      Welcome back, <%= current_user.profile.first_name %>!
    </p>
  </header>

  <div class="flex gap-4">
    <%= link_to "Request Document", select_document_type_path, class: "text-blue-600 hover:underline" %>
    <%= link_to "Report Concern", new_barangay_concern_path, class: "text-blue-600 hover:underline" %>
  </div>

  <section>
    <h2 class="mb-4 text-xl font-semibold">My Document Requests History</h2>

    <% if @document_requests.any? %>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-left">
          <thead>
            <tr class="border-b bg-gray-100">
              <th class="p-3">Document Type</th>
              <th class="p-3">Purpose</th>
              <th class="p-3">Date Requested</th>
              <th class="p-3">Status</th>
              <th class="p-3">Action</th>
            </tr>
          </thead>

          <tbody>
            <% @document_requests.each do |request| %>
              <tr class="border-b">
                <td class="p-3"><%= request.document_type.humanize %></td>
                <td class="p-3"><%= request.purpose %></td>
                <td class="p-3">
                  <%= request.created_at.strftime("%B %d, %Y at %I:%M %p") %>
                </td>
                <td class="p-3 font-medium">
                  <%= request.status.humanize %>
                </td>
                <td class="p-3">
                  <%= link_to "View Details", document_request_path(request), class: "text-blue-600 hover:underline" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-gray-600">You haven't submitted any document requests yet.</p>
    <% end %>
  </section>

  <section>
    <h2 class="mb-4 text-xl font-semibold">My Reported Concerns</h2>

    <% if @barangay_concerns.any? %>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full border-collapse text-left">
          <thead>
            <tr class="border-b bg-gray-100">
              <th class="p-3">Category</th>
              <th class="p-3">Reason Summary</th>
              <th class="p-3">Date Filed</th>
              <th class="p-3">Status</th>
              <th class="p-3">Date Resolved</th>
              <th class="p-3">Action</th>
            </tr>
          </thead>

          <tbody>
            <% @barangay_concerns.each do |concern| %>
              <tr class="border-b">
                <td class="p-3"><%= concern.category.humanize %></td>
                <td class="p-3"><%= truncate(concern.reason, length: 50) %></td>
                <td class="p-3">
                  <%= concern.created_at.strftime("%B %d, %Y") %>
                </td>
                <td class="p-3 font-medium">
                  <%= concern.status.humanize %>
                </td>
                <td class="p-3">
                  <%= concern.resolved_at ? concern.resolved_at.strftime("%B %d, %Y") : "—" %>
                </td>
                <td class="p-3">
                    <%= link_to "View Details", barangay_concern_path(concern), class: "text-blue-600 hover:underline" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="mt-4 text-gray-600">
        You haven't reported any public concerns or issues yet.
      </p>
    <% end %>
  </section>
</div>
