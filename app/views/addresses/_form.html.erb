<%= form_with model: address, url: address_path, local: true do |f| %>
  <% if address.errors.any? %>
    <div style="color: red; margin-bottom: 20px;">
      <h4>Please fix the errors below:</h4>
      <ul>
        <% address.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :house_number, "House Number / Block & Lot" %>
    <%= f.text_field :house_number, required: true, placeholder: "e.g., House No. 123" %>
  </div>

  <br>

  <div>
    <%= f.label :street %>
    <%= f.text_field :street, required: true, placeholder: "e.g., Mabini Street" %>
  </div>

  <br>

  <div>
    <%= f.label :purok %>
    <%= f.text_field :purok, required: true, placeholder: "e.g., Purok 1" %>
  </div>

  <br>

  <div>
    <%= f.label :barangay %>
    <%= f.text_field :barangay, required: true %>
  </div>

  <br>

  <div>
    <%= f.label :city, "City / Municipality" %>
    <%= f.text_field :city, required: true %>
  </div>

  <br>

  <div>
    <%= f.label :province %>
    <%= f.text_field :province, required: true %>
  </div>

  <br>

  <div>
    <%= f.submit "Complete Registration" %>
  </div>
<% end %>
