<%= form_with model: profile, url: profile_path, local: true do |f| %>
  <% if profile.errors.any? %>
    <div style="color: red; margin-bottom: 20px;">
      <h4>Please fix the errors below:</h4>
      <ul>
        <% profile.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :first_name %>
    <%= f.text_field :first_name, required: true %>
  </div>

  <br>

  <div>
    <%= f.label :middle_name %>
    <%= f.text_field :middle_name %>
  </div>

  <br>

  <div>
    <%= f.label :last_name %>
    <%= f.text_field :last_name, required: true %>
  </div>

  <br>

  <div>
    <%= f.label :suffix, "Suffix (e.g., Jr., III)" %>
    <%= f.text_field :suffix %>
  </div>

  <br>

  <div>
    <%= f.label :birth_date %>
    <%= f.date_field :birth_date, required: true %>
  </div>

  <br>

  <div>
    <%= f.label :sex, "Sex" %>
    <%# Pulls the keys directly from your ActiveRecord Enum mapping %>
    <%= f.select :sex, Profile.sexes.keys.map { |s| [s.humanize, s] }, { include_blank: "Select Sex" }, { required: true } %>
  </div>

  <br>

  <div>
    <%= f.submit "Save & Continue to Address" %>
  </div>
<% end %>
