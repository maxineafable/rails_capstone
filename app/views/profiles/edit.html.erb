<div class="space-y-6">
  <div>
    <h2 class="text-2xl font-bold">Edit Profile</h2>
  </div>

  <%= form_with model: @profile, url: profile_path, method: :patch, local: true do |f| %>

    <% if @profile.errors.any? || @address.errors.any? %>
      <div class="text-red-600">
        <h4 class="mb-2 font-semibold">Please fix the errors below:</h4>

        <ul class="list-disc pl-5">
          <% @profile.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>

          <% @address.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <section class="space-y-4">
      <h3 class="text-xl font-semibold">Personal Profile</h3>

      <div>
        <%= f.label :first_name, class: "mb-1 block font-medium" %>
        <%= f.text_field :first_name, required: true, class: "w-full max-w-[500px] border p-2" %>
      </div>

      <div>
        <%= f.label :middle_name, class: "mb-1 block font-medium" %>
        <%= f.text_field :middle_name, class: "w-full max-w-[500px] border p-2" %>
      </div>

      <div>
        <%= f.label :last_name, class: "mb-1 block font-medium" %>
        <%= f.text_field :last_name, required: true, class: "w-full max-w-[500px] border p-2" %>
      </div>

      <div>
        <%= f.label :suffix, class: "mb-1 block font-medium" %>
        <%= f.text_field :suffix, class: "w-full max-w-[500px] border p-2" %>
      </div>

      <div>
        <%= f.label :birth_date, class: "mb-1 block font-medium" %>
        <%= f.date_field :birth_date, required: true, class: "border p-2" %>
      </div>

      <div>
        <%= f.label :sex, class: "mb-1 block font-medium" %>
        <%= f.select :sex,
            Profile.sexes.keys.map { |s| [s.humanize, s] },
            { include_blank: "Select Sex" },
            { required: true, class: "border p-2" } %>
      </div>
    </section>

    <section class="space-y-4 border-t pt-6">
      <h3 class="text-xl font-semibold">Barangay Address</h3>

      <%= fields_for :address, @address do |a| %>
        <div>
          <%= a.label :house_number, "House Number / Block & Lot", class: "mb-1 block font-medium" %>
          <%= a.text_field :house_number, required: true, class: "w-full max-w-[500px] border p-2" %>
        </div>

        <div>
          <%= a.label :street, class: "mb-1 block font-medium" %>
          <%= a.text_field :street, required: true, class: "w-full max-w-[500px] border p-2" %>
        </div>

        <div>
          <%= a.label :purok, class: "mb-1 block font-medium" %>
          <%= a.text_field :purok, required: true, class: "w-full max-w-[500px] border p-2" %>
        </div>

        <div>
          <%= a.label :barangay, class: "mb-1 block font-medium" %>
          <%= a.text_field :barangay, required: true, class: "w-full max-w-[500px] border p-2" %>
        </div>

        <div>
          <%= a.label :city, class: "mb-1 block font-medium" %>
          <%= a.text_field :city, required: true, class: "w-full max-w-[500px] border p-2" %>
        </div>

        <div>
          <%= a.label :province, class: "mb-1 block font-medium" %>
          <%= a.text_field :province, required: true, class: "w-full max-w-[500px] border p-2" %>
        </div>
      <% end %>
    </section>

    <div class="border-t pt-6">
      <%= f.submit "Update Information",
          class: "cursor-pointer bg-blue-600 px-4 py-2 text-white hover:bg-blue-700" %>

      <%= link_to "Cancel",
          profile_path,
          class: "ml-4 text-blue-600 hover:underline" %>
    </div>

  <% end %>
</div>