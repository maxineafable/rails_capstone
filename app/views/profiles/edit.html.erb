<% content_for :title, "I-edit ang Impormasyon | Barangay Kalikid Sur" %>

<div class="min-h-screen bg-[#f5f4f7] font-sans text-slate-900">
  <%= render "shared/navbar", active: :profile %>

  <main class="mx-auto max-w-[1000px] space-y-4 px-4 py-5 sm:px-6 sm:py-6 lg:space-y-6 lg:px-6 lg:py-8">
    <section class="flex flex-col justify-between gap-4 rounded-xl bg-white px-5 py-5 shadow-sm sm:flex-row sm:items-center sm:px-7 lg:px-8 lg:py-7">
      <div>
        <p class="text-[9px] font-semibold uppercase tracking-[0.1em] text-emerald-700 lg:text-[13px]">Impormasyon ng Residente</p>
        <h1 class="mt-1 text-[20px] font-bold leading-tight tracking-[-0.04em] text-[#07349e] sm:text-[22px] lg:text-[30px]">I-edit ang Impormasyon</h1>
        <p class="mt-1 text-[11px] text-slate-500 lg:mt-2 lg:text-[15px]">I-update ang inyong personal na impormasyon, larawan, at tirahan sa barangay.</p>
      </div>
      <%= link_to profile_path, class: "inline-flex shrink-0 items-center gap-2 self-start rounded-md bg-[#eff3ff] px-4 py-2.5 text-[10px] font-semibold text-[#07349e] no-underline transition hover:bg-[#dfe8ff] sm:self-center lg:px-5 lg:py-3 lg:text-[13px]" do %>
        <span aria-hidden="true">←</span> Bumalik sa Impormasyon
      <% end %>
    </section>

    <%= form_with model: @profile, url: profile_path, method: :patch, local: true, class: "space-y-4 lg:space-y-6" do |f| %>
      <% if @profile.errors.any? || @address.errors.any? || current_user.errors.any? %>
        <section class="rounded-xl border border-red-200 bg-red-50 px-5 py-4 text-red-800" role="alert">
          <h2 class="text-sm font-semibold lg:text-[16px]">Pak ayusin ang mga error sa ibaba:</h2>
          <ul class="mt-2 list-disc space-y-1 pl-5 text-xs lg:text-[14px]">
            <% @profile.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
            <% @address.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
            <% current_user.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
          </ul>
        </section>
      <% end %>

      <section class="rounded-xl bg-white px-5 py-5 shadow-sm sm:px-7 sm:py-6 lg:px-8 lg:py-8" aria-labelledby="edit-personal-title">
        <div class="mb-5 lg:mb-6">
          <h2 id="edit-personal-title" class="text-[15px] font-semibold lg:text-[20px]">Personal na Impormasyon</h2>
          <p class="mt-0.5 text-[10px] text-slate-600 lg:mt-1 lg:text-[13px]">I-update ang inyong impormasyon at larawan.</p>
        </div>

        <div class="mb-6 flex flex-col gap-4 rounded-lg bg-[#eff3ff] p-4 sm:flex-row sm:items-center lg:p-5">
          <div class="flex h-[76px] w-[76px] shrink-0 items-center justify-center overflow-hidden rounded-full bg-[#e4ebff] text-2xl font-bold text-[#07349e] ring-4 ring-white lg:h-[96px] lg:w-[96px]">
            <% if @profile.avatar.attached? %>
              <%= image_tag @profile.avatar, alt: "Current profile picture", class: "h-full w-full object-cover" %>
            <% else %>
              <%= [@profile.first_name&.first, @profile.last_name&.first].compact.join.upcase.presence || "R" %>
            <% end %>
          </div>
          <div class="min-w-0">
            <%= f.label :avatar, "Larawan sa profile", class: "mb-1 block text-[11px] font-semibold text-slate-800 lg:text-[14px]" %>
            <%= f.file_field :avatar, accept: "image/png,image/jpeg,image/webp", class: "block w-full text-xs text-slate-600 file:mr-3 file:rounded-md file:border-0 file:bg-[#07349e] file:px-4 file:py-2 file:text-xs file:font-semibold file:text-white hover:file:bg-[#0b2e83] lg:text-[14px]" %>
            <p class="mt-2 text-[10px] text-slate-500 lg:text-[13px]">Pumili ng JPG, PNG, o WebP na larawan. Hanggang 5 MB ang laki.</p>
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 lg:gap-x-6 lg:gap-y-5">
          <div>
            <%= f.label :first_name, class: "mb-1 block text-[10px] font-semibold text-slate-700 lg:text-[13px]" do %>First name <span class="text-red-600">*</span><% end %>
            <%= f.text_field :first_name, required: true, class: "w-full rounded-md border border-slate-200 bg-white px-3 py-2.5 text-xs outline-none transition focus:border-[#07349e] focus:ring-2 focus:ring-blue-100 lg:text-[15px]" %>
          </div>
          <div>
            <%= f.label :middle_name, class: "mb-1 block text-[10px] font-semibold text-slate-700 lg:text-[13px]" %>
            <%= f.text_field :middle_name, class: "w-full rounded-md border border-slate-200 bg-white px-3 py-2.5 text-xs outline-none transition focus:border-[#07349e] focus:ring-2 focus:ring-blue-100 lg:text-[15px]" %>
          </div>
          <div>
            <%= f.label :last_name, class: "mb-1 block text-[10px] font-semibold text-slate-700 lg:text-[13px]" do %>Last name <span class="text-red-600">*</span><% end %>
            <%= f.text_field :last_name, required: true, class: "w-full rounded-md border border-slate-200 bg-white px-3 py-2.5 text-xs outline-none transition focus:border-[#07349e] focus:ring-2 focus:ring-blue-100 lg:text-[15px]" %>
          </div>
          <div>
            <%= f.label :suffix, class: "mb-1 block text-[10px] font-semibold text-slate-700 lg:text-[13px]" %>
            <%= f.text_field :suffix, class: "w-full rounded-md border border-slate-200 bg-white px-3 py-2.5 text-xs outline-none transition focus:border-[#07349e] focus:ring-2 focus:ring-blue-100 lg:text-[15px]" %>
          </div>
          <div>
            <%= f.label :sex, class: "mb-1 block text-[10px] font-semibold text-slate-700 lg:text-[13px]" do %>Sex <span class="text-red-600">*</span><% end %>
            <%= f.select :sex, Profile.sexes.keys.map { |sex| [tagalog_label(sex), sex] }, { include_blank: "Pumili ng kasarian" }, { required: true, class: "w-full rounded-md border border-slate-200 bg-white px-3 py-2.5 text-xs outline-none transition focus:border-[#07349e] focus:ring-2 focus:ring-blue-100 lg:text-[15px]" } %>
          </div>
          <div>
            <%= label_tag "user_email", class: "mb-1 block text-[10px] font-semibold text-slate-700 lg:text-[13px]" do %>Email <span class="text-red-600">*</span><% end %>
            <%= email_field_tag "user[email]", current_user.email, required: true, autocomplete: "email", class: "w-full rounded-md border border-slate-200 bg-white px-3 py-2.5 text-xs outline-none transition focus:border-[#07349e] focus:ring-2 focus:ring-blue-100 lg:text-[15px]" %>
          </div>
        </div>
      </section>

      <section class="rounded-xl bg-white px-5 py-5 shadow-sm sm:px-7 sm:py-6 lg:px-8 lg:py-8" aria-labelledby="edit-address-title">
        <div class="mb-5 lg:mb-6">
          <h2 id="edit-address-title" class="text-[15px] font-semibold lg:text-[20px]">Tirahan sa Barangay</h2>
          <p class="mt-0.5 text-[10px] text-slate-600 lg:mt-1 lg:text-[13px]">Panatilihing bago ang inyong rehistradong tirahan.</p>
        </div>

        <%= fields_for :address, @address do |a| %>
          <div class="grid gap-4 sm:grid-cols-2 lg:gap-x-6 lg:gap-y-5">
            <div>
              <%= a.label :house_number, class: "mb-1 block text-[10px] font-semibold text-slate-700 lg:text-[13px]" do %>House Number / Block & Lot <span class="text-red-600">*</span><% end %>
              <%= a.text_field :house_number, required: true, class: "w-full rounded-md border border-slate-200 bg-white px-3 py-2.5 text-xs outline-none transition focus:border-[#07349e] focus:ring-2 focus:ring-blue-100 lg:text-[15px]" %>
            </div>
            <div>
              <%= a.label :street, class: "mb-1 block text-[10px] font-semibold text-slate-700 lg:text-[13px]" do %>Street <span class="text-red-600">*</span><% end %>
              <%= a.text_field :street, required: true, class: "w-full rounded-md border border-slate-200 bg-white px-3 py-2.5 text-xs outline-none transition focus:border-[#07349e] focus:ring-2 focus:ring-blue-100 lg:text-[15px]" %>
            </div>
            <div>
              <%= a.label :purok, class: "mb-1 block text-[10px] font-semibold text-slate-700 lg:text-[13px]" do %>Purok <span class="text-red-600">*</span><% end %>
              <%= a.text_field :purok, required: true, class: "w-full rounded-md border border-slate-200 bg-white px-3 py-2.5 text-xs outline-none transition focus:border-[#07349e] focus:ring-2 focus:ring-blue-100 lg:text-[15px]" %>
            </div>
            <div>
              <%= a.label :barangay, class: "mb-1 block text-[10px] font-semibold text-slate-700 lg:text-[13px]" do %>Barangay <span class="text-red-600">*</span><% end %>
              <%= a.text_field :barangay, required: true, class: "w-full rounded-md border border-slate-200 bg-white px-3 py-2.5 text-xs outline-none transition focus:border-[#07349e] focus:ring-2 focus:ring-blue-100 lg:text-[15px]" %>
            </div>
            <div>
              <%= a.label :city, class: "mb-1 block text-[10px] font-semibold text-slate-700 lg:text-[13px]" do %>City <span class="text-red-600">*</span><% end %>
              <%= a.text_field :city, required: true, class: "w-full rounded-md border border-slate-200 bg-white px-3 py-2.5 text-xs outline-none transition focus:border-[#07349e] focus:ring-2 focus:ring-blue-100 lg:text-[15px]" %>
            </div>
            <div>
              <%= a.label :province, class: "mb-1 block text-[10px] font-semibold text-slate-700 lg:text-[13px]" do %>Province <span class="text-red-600">*</span><% end %>
              <%= a.text_field :province, required: true, class: "w-full rounded-md border border-slate-200 bg-white px-3 py-2.5 text-xs outline-none transition focus:border-[#07349e] focus:ring-2 focus:ring-blue-100 lg:text-[15px]" %>
            </div>
          </div>
        <% end %>
      </section>

      <div class="flex flex-col-reverse gap-3 pb-2 sm:flex-row sm:justify-end">
        <%= link_to "Kanselahin", profile_path, class: "rounded-md bg-white px-5 py-3 text-center text-xs font-semibold text-slate-700 no-underline shadow-sm transition hover:bg-slate-50 lg:text-[14px]" %>
        <%= f.submit "I-save ang mga Pagbabago", class: "cursor-pointer rounded-md bg-[#07349e] px-5 py-3 text-xs font-semibold text-white shadow-sm transition hover:bg-[#0b2e83] lg:text-[14px]" %>
      </div>
    <% end %>
  </main>
</div>
