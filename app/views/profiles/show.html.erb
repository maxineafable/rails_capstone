<div class="min-h-screen bg-[#f5f4f7] font-sans text-slate-900">
  <%= render "shared/navbar", active: :profile %>

  <div class="mx-auto max-w-[1000px] space-y-4 px-4 py-5 sm:px-6 sm:py-6 lg:space-y-6 lg:px-6 lg:py-8">

    <!-- Resident Identity -->
    <section class="flex min-h-[132px] items-center gap-4 rounded-xl bg-white px-5 py-5 shadow-sm sm:px-7 lg:min-h-[180px] lg:gap-6 lg:px-8 lg:py-7" aria-label="Resident identity">
      <div class="relative flex h-[76px] w-[76px] shrink-0 items-center justify-center rounded-full bg-[#e4ebff] text-2xl font-bold text-[#07349e] ring-4 ring-[#f5f4f7] sm:h-[82px] sm:w-[82px] lg:h-[110px] lg:w-[110px] lg:text-[36px]">
        <%= @initials %>

        <span class="absolute bottom-0 right-0 flex h-6 w-6 items-center justify-center rounded-full border-2 border-white bg-emerald-700 text-[12px] text-white lg:h-8 lg:w-8 lg:text-[15px]" aria-label="Resident account">
          <svg class="h-3.5 w-3.5 lg:h-4 lg:w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="m9.2 16.2-4-4 1.4-1.4 2.6 2.6 7.2-7.2 1.4 1.4z"/>
          </svg>
        </span>
      </div>

      <div class="min-w-0">
        <p class="mb-1 text-[9px] font-semibold uppercase tracking-[0.1em] text-slate-500 lg:mb-2 lg:text-[13px]">
          Registered Resident
        </p>

        <h1 class="break-words text-[20px] font-bold leading-tight tracking-[-0.04em] text-[#07349e] sm:text-[22px] lg:text-[30px]">
          <%= @resident_name %>
        </h1>

        <p class="mt-1 text-[11px] text-slate-500 lg:mt-2 lg:text-[15px]">
          Barangay Kalikid Sur
        </p>
      </div>
    </section>

    <!-- Personal Details -->
    <section class="rounded-xl bg-white px-5 py-5 shadow-sm sm:px-7 sm:py-6 lg:px-8 lg:py-8" aria-labelledby="personal-details-title">
      <div class="mb-4 flex items-center justify-between gap-3 lg:mb-6">
        <div>
          <h2 id="personal-details-title" class="text-[15px] font-semibold lg:text-[20px]">
            Personal Details
          </h2>

          <p class="mt-0.5 text-[10px] text-slate-600 lg:mt-1 lg:text-[13px]">
            Impormasyon ng Residente
          </p>
        </div>

        <%= link_to edit_profile_path, class: "inline-flex shrink-0 items-center gap-1 rounded-md bg-[#07349e] px-3 py-2 text-[10px] font-semibold text-white no-underline hover:bg-[#0b2e83] lg:gap-2 lg:px-5 lg:py-3 lg:text-[13px]" do %>
          <svg class="h-3 w-3 lg:h-4 lg:w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="m14 5 5 5M4 20l4-.8L19 8a2.1 2.1 0 0 0-3-3L5 16z"/>
          </svg>
          Edit / Baguhin
        <% end %>
      </div>

      <div class="space-y-1.5 lg:space-y-2.5">

        <!-- Address -->
        <div class="flex items-center gap-2.5 rounded-md bg-[#eff3ff] px-2.5 py-2.5 lg:gap-4 lg:px-4 lg:py-4">
          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-[#dce7ff] text-[#07349e] lg:h-10 lg:w-10">
            <svg class="h-3.5 w-3.5 lg:h-5 lg:w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"/>
              <circle cx="12" cy="10" r="2.5"/>
            </svg>
          </span>

          <div class="min-w-0">
            <p class="text-[9px] font-semibold uppercase tracking-wide text-slate-600 lg:text-[13px]">
              Permanent Address / Tirahan
            </p>

            <p class="mt-0.5 break-words text-[11px] font-medium lg:mt-1 lg:text-[15px]">
              <%= @full_address %>
            </p>
          </div>
        </div>

        <!-- Birth Date -->
        <div class="flex items-center gap-2.5 rounded-md bg-[#eff3ff] px-2.5 py-2.5 lg:gap-4 lg:px-4 lg:py-4">
          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-[#dce7ff] text-[#07349e] lg:h-10 lg:w-10">
            <svg class="h-3.5 w-3.5 lg:h-5 lg:w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="7" y="3" width="10" height="18" rx="1.5"/>
              <path d="M11 17h2"/>
            </svg>
          </span>

          <div class="min-w-0">
            <p class="text-[9px] font-semibold uppercase tracking-wide text-slate-600 lg:text-[13px]">
              Birth Date / Petsa ng Kapanganakan
            </p>

            <p class="mt-0.5 text-[11px] font-medium lg:mt-1 lg:text-[15px]">
              <%= @profile&.birth_date&.strftime("%B %d, %Y") || "Not provided" %>
            </p>
          </div>
        </div>

        <!-- Email -->
        <div class="flex items-center gap-2.5 rounded-md bg-[#eff3ff] px-2.5 py-2.5 lg:gap-4 lg:px-4 lg:py-4">
          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-[#dce7ff] text-[#07349e] lg:h-10 lg:w-10">
            <svg class="h-3.5 w-3.5 lg:h-5 lg:w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M4 6.5h16v11H4z"/>
              <path d="m5 7 7 5.5L19 7"/>
            </svg>
          </span>

          <div class="min-w-0">
            <p class="text-[9px] font-semibold uppercase tracking-wide text-slate-600 lg:text-[13px]">
              Email Address / Koreo Elektroniko
            </p>

            <p class="mt-0.5 break-all text-[11px] font-medium lg:mt-1 lg:text-[15px]">
              <%= current_user.email %>
            </p>
          </div>
        </div>

        <!-- Sex -->
        <div class="flex items-center gap-2.5 rounded-md bg-[#eff3ff] px-2.5 py-2.5 lg:gap-4 lg:px-4 lg:py-4">
          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-[#dce7ff] text-[11px] font-bold text-[#07349e] lg:h-10 lg:w-10 lg:text-[15px]">
            ID
          </span>

          <div class="min-w-0">
            <p class="text-[9px] font-semibold uppercase tracking-wide text-slate-600 lg:text-[13px]">
              Sex / Kasarian
            </p>

            <p class="mt-0.5 text-[11px] font-medium lg:mt-1 lg:text-[15px]">
              <%= @profile&.sex&.humanize || "Not provided" %>
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- Security and Account -->
    <div class="grid grid-cols-1 gap-3.5 sm:grid-cols-2 lg:gap-6">

      <!-- Security -->
      <section class="rounded-xl bg-white p-5 shadow-sm lg:p-8" aria-labelledby="security-title">
        <div class="mb-3 flex items-center gap-2 lg:mb-5 lg:gap-3">
          <span class="flex h-7 w-7 items-center justify-center rounded-md bg-[#dce7ff] text-[#07349e] lg:h-10 lg:w-10">
            <svg class="h-3.5 w-3.5 lg:h-5 lg:w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17 8h-1V6a4 4 0 0 0-8 0v2H7a2 2 0 0 0-2 2v10h14V10a2 2 0 0 0-2-2ZM10 6a2 2 0 1 1 4 0v2h-4Z"/>
            </svg>
          </span>

          <div>
            <h2 id="security-title" class="text-[12px] font-semibold lg:text-[20px]">
              Security / Seguridad
            </h2>

            <p class="text-[9px] text-slate-600 lg:text-[13px]">
              Account Protection
            </p>
          </div>
        </div>

        <div class="rounded-md bg-[#eff3ff] p-2.5 lg:p-4">
          <h3 class="text-[10px] font-semibold lg:text-[15px]">
            Change Password / Palitan ang Password
          </h3>

          <p class="mt-1 text-[10px] leading-relaxed text-slate-600 lg:mt-2 lg:text-[13px]">
            Keep your civic portal account safe by using a strong, unique password.
          </p>
        </div>

        <%= link_to edit_user_registration_path, class: "mt-4 flex items-center justify-between rounded-md bg-[#dfe8ff] px-2.5 py-2 text-[10px] font-semibold text-[#07349e] no-underline hover:bg-[#d3dfff] lg:mt-5 lg:px-4 lg:py-3 lg:text-[13px]" do %>
          <span>⚿ Update Password</span>
          <span aria-hidden="true">›</span>
        <% end %>
      </section>

      <!-- Resident Account -->
      <section class="rounded-xl bg-white p-5 shadow-sm lg:p-8" aria-labelledby="account-title">
        <div class="mb-3 flex items-center gap-2 lg:mb-5 lg:gap-3">
          <span class="flex h-7 w-7 items-center justify-center rounded-md bg-[#d8ffef] text-[12px] text-emerald-700 lg:h-10 lg:w-10 lg:text-[16px]" aria-hidden="true">
            ✓
          </span>

          <div>
            <h2 id="account-title" class="text-[12px] font-semibold lg:text-[20px]">
              Resident Account
            </h2>

            <p class="text-[9px] text-slate-600 lg:text-[13px]">
              Katayuan ng Account
            </p>
          </div>
        </div>

        <p class="text-[10px] font-semibold lg:text-[15px]">
          Profile Completion
        </p>

        <p class="mt-1 text-[10px] leading-relaxed text-slate-600 lg:mt-2 lg:text-[13px]">
          Keep your resident details up to date to help the barangay process your requests.
        </p>
      </section>

    </div>

    <!-- Logout -->
    <div class="flex justify-end pb-2 pt-0.5">
      <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "inline-flex items-center gap-1.5 rounded-md bg-red-700 px-4 py-2.5 text-[10px] font-semibold text-white no-underline hover:bg-red-800 lg:px-6 lg:py-3.5 lg:text-[13px]" do %>
        <span aria-hidden="true">⇥</span>
        Log Out / Mag-logout
      <% end %>
    </div>

  </div>
</div>
