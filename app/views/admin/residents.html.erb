<div class="flex">
  <%= render "sidebar" %>

    <div class="flex-1 space-y-8 p-8">

      <header class="rounded-xl border bg-white p-6">
        <h2 class="text-2xl font-bold text-gray-800">
          Census / Household Records
        </h2>
        <p class="mt-1 text-sm text-gray-500">
          Opisyal na Talaan ng mga Sambahayan at Naninirahan
        </p>
      </header>

      <div class="flex justify-end">
        <%= link_to "Encode New Household Census Entry" , new_household_path,
          data: { turbo_frame: "remote_modal" }, 
          class: "rounded bg-green-600 px-4 py-2 text-sm font-medium text-white hover:bg-green-700" %>
      </div>

      <div class="space-y-4">
        <% if @households.any? %>
          <% @households.each do |house| %>
            <%= render "households/household_card", household: house %>
          <% end %>
        <% else %>
          <div class="rounded-lg border border-dashed bg-white p-12 text-center text-sm text-gray-500 shadow-sm">
            📂 No household census records found in the system registry.
          </div>
        <% end %>
      </div>

      <div class="flex justify-center">
        <%== @pagy_households.series_nav %>
      </div>
    </div>
</div>

<!-- HTML Target Box Container for remote modal injection loads -->
<%= turbo_frame_tag "remote_modal" do %>
  <!-- This space will dynamically fill up with the show form content when a link is clicked -->
<% end %>