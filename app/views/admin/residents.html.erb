<div class="flex min-h-screen bg-[#f5f4f7]">
  <%= render "sidebar" %>

  <main class="min-w-0 flex-1 space-y-4 p-4 sm:p-6 lg:p-8">
    <header class="flex flex-col justify-between gap-4 rounded-xl bg-white px-5 py-5 shadow-sm sm:flex-row sm:items-center sm:px-7 lg:px-8">
      <div>
        <h1 class="text-[22px] font-bold leading-tight tracking-[-0.03em] text-slate-900 sm:text-[26px] lg:text-[30px]">Senso / Talaan ng Sambahayan</h1>
        <p class="mt-1 text-xs text-slate-600 lg:text-[14px]">Opisyal na Talaan ng mga Sambahayan at Naninirahan</p>
      </div>
      <%= link_to new_household_path, data: { turbo_frame: "remote_modal" }, class: "inline-flex shrink-0 items-center justify-center gap-2 self-start rounded-lg bg-[#2445b8] px-5 py-3 text-xs font-semibold text-white no-underline shadow-sm transition hover:bg-[#17379f] sm:self-center lg:text-[14px]" do %>
        <span class="text-lg leading-none" aria-hidden="true">＋</span> Magdagdag ng Sambahayan
      <% end %>
    </header>

    <section class="rounded-xl bg-white p-3 shadow-sm sm:p-4" aria-label="Maghanap at magsala ng mga sambahayan">
      <%= form_with url: admin_residents_path, method: :get, local: true, class: "grid gap-2 lg:grid-cols-[minmax(220px,1fr)_190px_220px_auto]" do |f| %>
        <div class="relative min-w-0">
          <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-500" aria-hidden="true">⌕</span>
          <%= f.search_field :search, value: params[:search], placeholder: "Maghanap ayon sa numero ng sambahayan, pinuno, o kalye...", class: "w-full rounded-lg border-0 bg-[#eff3ff] py-3 pl-10 pr-3 text-xs text-slate-800 outline-none placeholder:text-slate-500 focus:ring-2 focus:ring-[#2445b8]/30 lg:text-[13px]" %>
        </div>
        <%= f.select :purok, options_for_select([["All Puroks", ""]] + @puroks.map { |purok| ["Purok #{purok}", purok] }, params[:purok]), {}, class: "rounded-lg border-0 bg-[#eff3ff] px-3 py-3 text-xs text-slate-800 outline-none focus:ring-2 focus:ring-[#2445b8]/30 lg:text-[13px]" %>
        <%= f.select :sort, options_for_select([["Numero ng Sambahayan (Asc)", "household_no"], ["Pinakabago", "newest"], ["Pinakaluma", "oldest"], ["Purok", "purok"]], params[:sort].presence || "household_no"), {}, class: "rounded-lg border-0 bg-[#eff3ff] px-3 py-3 text-xs text-slate-800 outline-none focus:ring-2 focus:ring-[#2445b8]/30 lg:text-[13px]" %>
        <div class="flex gap-2">
          <%= f.submit "Apply", class: "w-full cursor-pointer rounded-lg bg-[#eff3ff] px-4 py-3 text-xs font-semibold text-slate-800 hover:bg-[#dfe8ff] lg:w-auto" %>
          <% if params[:search].present? || params[:purok].present? || params[:sort].present? || params[:filter].present? %><%= link_to "Clear", admin_residents_path, class: "inline-flex items-center rounded-lg px-3 text-xs font-semibold text-slate-600 no-underline hover:bg-slate-50" %><% end %>
        </div>
      <% end %>
    </section>

    <% active_filter = params[:filter].presence_in(%w[all purok_1_3 purok_4_5 new]) || "all" %>
    <section class="flex flex-wrap items-center justify-between gap-3" aria-label="Mabilisang pagsala ng mga sambahayan">
      <nav class="flex flex-wrap items-center gap-1.5 text-[10px] font-semibold lg:text-[12px]" aria-label="Filter households">
        <% [["all", "All", @total_households], ["purok_1_3", "Purok 1–3", nil], ["purok_4_5", "Purok 4–5", nil], ["new", "New", @new_household_count]].each do |filter, label, count| %>
          <%= link_to admin_residents_path(filter: filter, search: params[:search], purok: params[:purok], sort: params[:sort]), class: "rounded-full px-4 py-2 no-underline transition #{active_filter == filter ? 'bg-[#2445b8] text-white' : 'bg-[#eff3ff] text-slate-700 hover:bg-[#dfe8ff]'}" do %>
            <%= label %><% if count %> <span class="ml-1"><%= count %></span><% end %>
          <% end %>
        <% end %>
      </nav>
      <p class="text-[10px] font-semibold text-slate-600 lg:text-[12px]"><span class="mr-1 text-emerald-700">▤</span> Ipinapakita ang <%= @households.size %> sa <%= @filtered_household_count %> sambahayan</p>
    </section>

    <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm" aria-label="Mga talaan ng sambahayan">
      <% if @households.any? %>
        <div class="border-b border-slate-100 px-5 py-4 text-[10px] text-slate-500 lg:px-6 lg:text-[12px]">
          Ipinapakita ang <strong class="text-slate-700"><%= @households.size %></strong> sa <strong class="text-slate-700"><%= @filtered_household_count %></strong> sambahayan
          <span class="text-slate-400">(<%= @households.size %> sa <%= @filtered_household_count %> sambahayan)</span>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[940px] border-collapse text-left">
            <thead class="bg-white text-[9px] font-bold uppercase tracking-wide text-slate-500 lg:text-[10px]">
              <tr>
                <th class="px-3 py-4 lg:px-4">Numero ng Sambahayan</th>
                <th class="px-3 py-4">Pangalan ng Pinuno ng Sambahayan</th>
                <th class="px-3 py-4">Purok / Lugar</th>
                <th class="px-3 py-4">Subdibisyon / Kalye</th>
                <th class="px-3 py-4">Bilang ng mga Kasapi</th>
                <th class="px-3 py-4">Petsa ng Pagkumpleto</th>
                <th class="px-3 py-4">Mga Aksyon</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% @households.each do |household| %>
                <%= render "households/household_card", household: household %>
              <% end %>
            </tbody>
          </table>
        </div>
        <div class="flex flex-col justify-between gap-3 bg-[#eff3ff] px-5 py-4 sm:flex-row sm:items-center lg:px-6">
          <p class="text-[10px] text-slate-600 lg:text-[12px]">Ipinapakita ang <strong><%= @pagy_households.from %> hanggang <%= @pagy_households.to %></strong> sa <strong><%= @filtered_household_count %></strong> tala ng sambahayan</p>
          <div class="text-xs"><%== @pagy_households.series_nav %></div>
        </div>
      <% else %>
        <div class="px-5 py-14 text-center">
          <p class="text-sm font-semibold text-slate-800 lg:text-[18px]">Walang nahanap na talaan ng sambahayan</p>
          <p class="mt-2 text-xs text-slate-600">Subukan ang ibang paghahanap o salain, o magdagdag ng sambahayan.</p>
          <%= link_to "Clear filters", admin_residents_path, class: "mt-3 inline-block text-xs font-semibold text-[#07349e] hover:underline" %>
        </div>
      <% end %>
    </section>
  </main>
</div>

<%= turbo_frame_tag "remote_modal" %>
