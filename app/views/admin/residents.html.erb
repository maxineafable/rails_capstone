<div class="flex">
  <%= render "sidebar" %>

    <div class="flex-1 p-8 space-y-8">
      <header class="bg-white rounded-xl p-6 border">
        <div class="">
          <h2 class="text-2xl font-bold">Census / Household Records</h2>
          <p>Opisyal na Talaan ng mga Sambahayan at Naninirahan</p>
        </div>
      </header>


      <section>
        <div class="overflow-x-auto">
          <table class="w-full border-collapse border">

            <thead>
              <tr class="border-b bg-gray-100 text-left">
                <th class="border p-3">Full Name</th>
                <th class="border p-3">Sex</th>
                <th class="border p-3">Birth Date</th>
                <th class="border p-3">Purok</th>
                <th class="border p-3">Street Address</th>
                <th class="border p-3">System Account Email</th>
              </tr>
            </thead>

            <tbody>
              <% @residents.each do |resident| %>

                <tr class="border-b">

                  <td class="border p-3">
                    <%= "#{resident.profile.last_name}, #{resident.profile.first_name} #{resident.profile.middle_name}"
                      .strip.upcase %>
                  </td>

                  <td class="border p-3">
                    <%= resident.profile.sex.humanize %>
                  </td>

                  <td class="border p-3">
                    <%= resident.profile.birth_date.strftime("%B %d, %Y") %>
                  </td>

                  <td class="border p-3">
                    <%= resident.address&.purok || "—" %>
                  </td>

                  <td class="border p-3">
                    <%= resident.address&.street || "—" %>
                  </td>

                  <td class="border p-3">
                    <%= resident.email %>
                  </td>

                </tr>

                <% end %>
            </tbody>

          </table>
        </div>
      </section>
    </div>

</div>