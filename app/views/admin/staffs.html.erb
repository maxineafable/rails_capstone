<div class="flex min-h-screen bg-[#f5f4f7]">
  <%= render "sidebar" %>

  <main class="min-w-0 flex-1 space-y-5 p-4 sm:p-6 lg:p-8">
    <header class="flex flex-col justify-between gap-5 rounded-xl bg-white px-5 py-6 sm:flex-row sm:items-center sm:px-7 lg:min-h-[220px] lg:px-10 lg:py-9">
      <div>
        <p class="text-[10px] font-semibold uppercase tracking-[0.1em] text-emerald-700 lg:text-[13px]">Ulat at Talaan ng Barangay</p>
        <h1 class="mt-1 text-[28px] font-bold leading-tight tracking-[-0.04em] text-[#07349e] sm:text-[32px] lg:text-[40px]">Mga Kawani</h1>
        <p class="mt-2 max-w-[740px] text-xs leading-relaxed text-slate-600 lg:text-[15px]">Talaan ng mga opisyal at kawani ng barangay na maaaring tumugon sa mga ulat at serbisyo publiko.</p>
      </div>
      <div class="inline-flex shrink-0 items-center gap-2 self-start rounded-lg bg-[#eff3ff] px-4 py-3 text-xs font-semibold text-[#07349e] sm:self-center lg:px-5 lg:py-4 lg:text-[14px]">
        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-[#dce7ff] font-bold">♙</span>
        <span><%= @staff_count %> Kawani</span>
      </div>
    </header>

    <section class="rounded-xl bg-white p-3 shadow-sm sm:p-4" aria-label="Maghanap ng kawani">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <%= form_with url: admin_staffs_path, method: :get, local: true, class: "flex min-w-0 flex-1 gap-2" do |f| %>
          <div class="relative min-w-0 flex-1">
            <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-500" aria-hidden="true">⌕</span>
            <%= f.search_field :search, value: params[:search], placeholder: "Maghanap ng kawani ayon sa pangalan, tungkulin, o email...", class: "w-full rounded-lg border-0 bg-[#eff3ff] py-3 pl-10 pr-3 text-xs text-slate-800 outline-none placeholder:text-slate-500 focus:ring-2 focus:ring-[#2445b8]/30 lg:text-[14px]" %>
          </div>
          <%= f.submit "Maghanap", class: "cursor-pointer rounded-lg bg-[#07349e] px-4 py-2 text-xs font-semibold text-white hover:bg-[#0b2e83] lg:text-[13px]" %>
          <% if params[:search].present? %><%= link_to "Clear", admin_staffs_path, class: "inline-flex items-center rounded-lg bg-[#f5f7fc] px-3 text-xs font-semibold text-slate-600 no-underline hover:bg-slate-100" %><% end %>
        <% end %>
        <p class="shrink-0 rounded-full bg-[#eff3ff] px-4 py-2 text-[10px] font-semibold text-slate-700 lg:text-[12px]"><span class="mr-1 text-emerald-700">●</span> Ipinapakita: <%= @staff_count %> kawani</p>
      </div>
    </section>

    <section class="overflow-hidden rounded-xl bg-white shadow-sm" aria-label="Mga Kawani directory">
      <% if @staffs.any? %>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[760px] border-collapse text-left">
            <thead class="bg-[#eff3ff] text-[9px] font-bold uppercase tracking-wide text-slate-600 lg:text-[11px]">
              <tr>
                <th class="px-5 py-4 lg:px-7">Buong Pangalan</th>
                <th class="px-5 py-4">Tungkulin</th>
                <th class="px-5 py-4">Email ng Account</th>
                <th class="px-5 py-4">Kalagayan</th>
                <th class="px-5 py-4 lg:px-7">Nagsimulang Manungkulan</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% @staffs.each do |user| %>
                <tr class="odd:bg-white even:bg-[#fbfcff] hover:bg-[#f5f8ff]">
                  <td class="px-5 py-5 text-sm font-semibold text-slate-900 lg:px-7 lg:text-[15px]">
                    <% if user.profile.present? %>
                      <%= [user.profile.first_name, user.profile.middle_name&.first&.concat("."), user.profile.last_name, user.profile.suffix].compact_blank.join(" ") %>
                    <% else %>
                      <span class="italic text-slate-500">Hindi pa Kumpleto ang Impormasyon</span>
                    <% end %>
                  </td>
                  <td class="px-5 py-5 text-xs font-semibold text-[#07349e] lg:text-[14px]"><%= user.staff.position.humanize %></td>
                  <td class="px-5 py-5 text-xs text-slate-700 lg:text-[13px]"><%= user.email %></td>
                  <td class="px-5 py-5"><span class="inline-flex items-center gap-1 rounded-full bg-emerald-200 px-3 py-1 text-[9px] font-bold uppercase tracking-wide text-emerald-900"><span aria-hidden="true">●</span> Aktibo</span></td>
                  <td class="px-5 py-5 text-xs text-slate-600 lg:text-[13px]"><%= tagalog_date(user.created_at) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <div class="flex flex-col justify-between gap-2 bg-[#eff3ff] px-5 py-4 text-[10px] text-slate-600 sm:flex-row sm:items-center sm:px-7 lg:text-[12px]">
          <span>Ipinapakita ang <strong><%= @staff_count %></strong> tala ng kawani</span>
          <%= link_to "← Bumalik sa Pangunahing Pahina", admin_dashboard_path, class: "font-semibold text-[#07349e] no-underline hover:underline" %>
        </div>
      <% else %>
        <div class="px-5 py-12 text-center">
          <p class="text-sm font-semibold text-slate-800 lg:text-[18px]">Walang nahanap na kawani</p>
          <p class="mt-2 text-xs text-slate-600">Subukan ang ibang pangalan, tungkulin, o email.</p>
          <%= link_to "Clear search", admin_staffs_path, class: "mt-3 inline-block text-xs font-semibold text-[#07349e] hover:underline" %>
        </div>
      <% end %>
    </section>
  </main>
</div>
