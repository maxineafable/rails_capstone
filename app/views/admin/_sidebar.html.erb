<aside class="sticky top-0 h-screen w-80 shrink-0 overflow-y-auto bg-white">
  <div class="p-6">
    <!-- Barangay Header -->
    <div class="mb-6 flex items-center gap-3">
      <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border-2 border-blue-900 text-blue-900">
        <span class="text-sm font-bold">BK</span>
      </div>

      <div class="min-w-0">
        <p class="text-base font-bold leading-tight text-blue-900">
          Barangay Kalikid Sur
        </p>
        <p class="text-[10px] font-bold tracking-wide text-green-700">
          SISTEMA NG PAMAMAHALA AT SERBISYO
        </p>
      </div>
    </div>

    <!-- Navigation -->
    <nav class="space-y-1">

      <%= link_to admin_dashboard_path,
          class: "flex items-center gap-3 rounded-lg px-4 py-2.5 text-sm font-semibold #{current_page?(admin_dashboard_path) ? 'bg-blue-800 text-white' : 'text-gray-600 hover:bg-gray-100'}" do %>
        <span>▦</span>
        <span>Pangunahing Pahina</span>
      <% end %>

      <%= link_to admin_document_requests_path,
          class: "flex items-center gap-3 rounded-lg px-4 py-2.5 text-sm font-semibold #{current_page?(admin_document_requests_path) ? 'bg-blue-800 text-white' : 'text-gray-600 hover:bg-gray-100'}" do %>
        <span>▤</span>
        <span>Mga Kahilingan sa Dokumento</span>
      <% end %>

      <%= link_to admin_barangay_concerns_path,
          class: "flex items-center gap-3 rounded-lg px-4 py-2.5 text-sm font-semibold #{current_page?(admin_barangay_concerns_path) ? 'bg-blue-800 text-white' : 'text-gray-600 hover:bg-gray-100'}" do %>
        <span>△</span>
        <span>Mga Ulat ng Suliranin</span>
      <% end %>

      <%= link_to admin_residents_path,
          class: "flex items-center gap-3 rounded-lg px-4 py-2.5 text-sm font-semibold #{current_page?(admin_residents_path) ? 'bg-blue-800 text-white' : 'text-gray-600 hover:bg-gray-100'}" do %>
        <span>♟</span>
        <span>Mga Residente</span>
      <% end %>

      <%= link_to admin_staffs_path,
          class: "flex items-center gap-3 rounded-lg px-4 py-2.5 text-sm font-semibold #{current_page?(admin_staffs_path) ? 'bg-blue-800 text-white' : 'text-gray-600 hover:bg-gray-100'}" do %>
        <span>▣</span>
        <span>Mga Kawani</span>
      <% end %>

      <%= link_to "#",
          class: "flex items-center gap-3 rounded-lg px-4 py-2.5 text-sm font-semibold text-gray-600 hover:bg-gray-100" do %>
        <span>▥</span>
        <span>Mga Ulat</span>
      <% end %>

      <%= link_to "#",
          class: "flex items-center gap-3 rounded-lg px-4 py-2.5 text-sm font-semibold text-gray-600 hover:bg-gray-100" do %>
        <span>⚙</span>
        <span>Mga Setting</span>
      <% end %>

      <%= button_to destroy_user_session_path,
          method: :delete,
          class: "flex w-full items-center gap-3 rounded-lg px-4 py-2.5 text-sm font-semibold text-red-600 hover:bg-red-50" do %>
        <span>←</span>
        <span>Mag-log out</span>
      <% end %>

    </nav>
  </div>
</aside>
