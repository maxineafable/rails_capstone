<div class="flex min-h-screen bg-slate-50">
  <%= render "sidebar" %>

  <main class="min-w-0 flex-1 space-y-4 p-4 sm:p-6">

    <!-- Welcome Header -->
    <header class="rounded-xl border border-slate-200 bg-white p-5">
      <span class="inline-block rounded-full bg-indigo-100 px-3 py-1 text-xs font-semibold uppercase text-blue-800">
        Administrator Access
      </span>

      <h1 class="mt-2 text-2xl font-bold text-slate-900">
        Welcome, <span class="text-blue-800">Administrator</span>
      </h1>

      <p class="mt-1 text-sm text-slate-500">
        Pangkalahatang Dashboard ng Pamamalakad at Serbisyo Publiko
      </p>
    </header>

    <!-- Statistics -->
    <section class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-5">
      
      <div class="rounded-xl border border-slate-200 bg-white p-4">
        <p class="text-xs font-semibold uppercase text-slate-500">Pending Requests</p>
        <div class="mt-4 flex items-end justify-between">
          <p class="text-3xl font-bold text-slate-900"><%= @pending_docs_count %></p>
          <span class="rounded-lg bg-amber-50 px-3 py-2 text-amber-700">Docs</span>
        </div>
        <p class="mt-3 border-t border-slate-100 pt-2 text-xs text-amber-700">
          Awaiting review
        </p>
      </div>

      <div class="rounded-xl border border-slate-200 bg-white p-4">
        <p class="text-xs font-semibold uppercase text-slate-500">Active Concerns</p>
        <div class="mt-4 flex items-end justify-between">
          <p class="text-3xl font-bold text-slate-900"><%= @ongoing_concerns_count %></p>
          <span class="rounded-lg bg-rose-50 px-3 py-2 text-rose-700">Cases</span>
        </div>
        <p class="mt-3 border-t border-slate-100 pt-2 text-xs text-blue-700">
          Currently in progress
        </p>
      </div>

      <div class="rounded-xl border border-slate-200 bg-white p-4">
        <p class="text-xs font-semibold uppercase text-slate-500">Requests Done This Week</p>
        <div class="mt-4 flex items-end justify-between">
          <p class="text-3xl font-bold text-emerald-700"><%= @docs_done_this_week %></p>
          <span class="rounded-lg bg-emerald-50 px-3 py-2 text-emerald-700">Done</span>
        </div>
        <p class="mt-3 border-t border-slate-100 pt-2 text-xs text-emerald-700">
          Ready for pickup
        </p>
      </div>

      <div class="rounded-xl border border-slate-200 bg-white p-4">
        <p class="text-xs font-semibold uppercase text-slate-500">Concerns Resolved This Week</p>
        <div class="mt-4 flex items-end justify-between">
          <p class="text-3xl font-bold text-emerald-700"><%= @concerns_resolved_this_week %></p>
          <span class="rounded-lg bg-emerald-50 px-3 py-2 text-emerald-700">Closed</span>
        </div>
        <p class="mt-3 border-t border-slate-100 pt-2 text-xs text-emerald-700">
          Resolved cases
        </p>
      </div>

      <div class="rounded-xl border border-slate-200 bg-white p-4">
        <p class="text-xs font-semibold uppercase text-slate-500">Total Residents</p>
        <p class="mt-4 text-3xl font-bold text-slate-900">
          <%= number_with_delimiter(@total_residents_count) %>
        </p>
        <p class="mt-3 border-t border-slate-100 pt-2 text-xs text-blue-800">
          Registered residents
        </p>
      </div>

    </section>

    <!-- TODO: HARDCODED Activity Chart -->
    <section class="rounded-xl border border-slate-200 bg-white p-5">
      <div class="flex flex-col gap-3 border-b border-slate-100 pb-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="font-semibold text-slate-900">
            Requests & Reports Activity (Past 7 Days)
          </h2>
          <p class="mt-1 text-sm text-slate-500">
            Ulat at Kahilingan sa Nakaraang 7 Araw
          </p>
        </div>

        <div class="flex flex-wrap gap-4 text-xs text-slate-600">
          <span class="flex items-center gap-2">
            <span class="h-3 w-3 rounded-sm bg-blue-800"></span>
            Document Requests
          </span>

          <span class="flex items-center gap-2">
            <span class="h-1 w-4 rounded bg-emerald-700"></span>
            Concern Reports
          </span>
        </div>
      </div>

      <!-- Hardcoded sample summary -->
      <div class="mt-4 grid grid-cols-1 gap-3 rounded-lg bg-blue-50 p-4 text-center sm:grid-cols-3">
        <div>
          <p class="text-xs font-semibold uppercase text-slate-500">7-Day Requests Total</p>
          <p class="mt-1 text-lg font-bold text-blue-800">224</p>
        </div>

        <div>
          <p class="text-xs font-semibold uppercase text-slate-500">7-Day Concerns Total</p>
          <p class="mt-1 text-lg font-bold text-emerald-700">59</p>
        </div>

        <div>
          <p class="text-xs font-semibold uppercase text-slate-500">Busiest Day</p>
          <p class="mt-1 font-semibold text-slate-900">Monday</p>
        </div>
      </div>

      <!-- Hardcoded SVG chart -->
      <div class="mt-6 w-full overflow-x-auto">
        <svg viewBox="0 0 760 230" class="min-w-[650px] w-full" role="img" aria-label="Sample activity chart for the past seven days">
          <!-- Grid lines -->
          <g stroke="#e2e8f0" stroke-dasharray="3 4">
            <line x1="50" y1="35" x2="735" y2="35" />
            <line x1="50" y1="70" x2="735" y2="70" />
            <line x1="50" y1="105" x2="735" y2="105" />
            <line x1="50" y1="140" x2="735" y2="140" />
            <line x1="50" y1="175" x2="735" y2="175" />
          </g>

          <!-- Y-axis labels -->
          <g fill="#64748b" font-size="12" text-anchor="end">
            <text x="40" y="39">50</text>
            <text x="40" y="74">40</text>
            <text x="40" y="109">30</text>
            <text x="40" y="144">20</text>
            <text x="40" y="179">0</text>
          </g>

          <!-- Request bars -->
          <g fill="#2445b8">
            <rect x="75" y="105" width="28" height="70" rx="4" />
            <rect x="165" y="133" width="28" height="42" rx="4" />
            <rect x="255" y="147" width="28" height="28" rx="4" />
            <rect x="345" y="42" width="28" height="133" rx="4" fill="#082f87" />
            <rect x="435" y="63" width="28" height="112" rx="4" />
            <rect x="525" y="77" width="28" height="98" rx="4" />
            <rect x="615" y="70" width="28" height="105" rx="4" />
          </g>

          <!-- Request values -->
          <g fill="#1d4ed8" font-size="11" font-weight="600" text-anchor="middle">
            <text x="89" y="98">28</text>
            <text x="179" y="126">16</text>
            <text x="269" y="140">12</text>
            <text x="359" y="35">48</text>
            <text x="449" y="56">42</text>
            <text x="539" y="70">38</text>
            <text x="629" y="63">40</text>
          </g>

          <!-- Concern report line -->
          <polyline
            points="89,155 179,163 269,166 359,128 449,137 539,150 629,135"
            fill="none"
            stroke="#047857"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />

          <g fill="#047857" stroke="white" stroke-width="2">
            <circle cx="89" cy="155" r="4" />
            <circle cx="179" cy="163" r="4" />
            <circle cx="269" cy="166" r="4" />
            <circle cx="359" cy="128" r="4" />
            <circle cx="449" cy="137" r="4" />
            <circle cx="539" cy="150" r="4" />
            <circle cx="629" cy="135" r="4" />
          </g>

          <!-- X-axis labels -->
          <g fill="#475569" font-size="11" text-anchor="middle">
            <text x="89" y="197">Fri</text>
            <text x="179" y="197">Sat</text>
            <text x="269" y="197">Sun</text>
            <text x="359" y="197">Mon</text>
            <text x="449" y="197">Tue</text>
            <text x="539" y="197">Wed</text>
            <text x="629" y="197">Thu</text>
          </g>
        </svg>
      </div>
    </section>

    <!-- Recent Activity -->
    <section class="overflow-hidden rounded-xl border border-slate-200 bg-white">

      <div class="flex flex-col gap-4 p-5 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="font-semibold text-slate-900">Recent Activity</h2>
          <p class="mt-1 text-sm text-slate-500">
            Kamakailang Aktibidad sa Barangay Portal
          </p>
        </div>

        <% active_filter = params[:filter] || "all" %>
        <div class="flex flex-wrap gap-2 text-xs">
          <%= link_to admin_dashboard_path(filter: "all"),
              data: { turbo: true, preserve_scroll: true },
              class: "rounded-md px-3 py-2 font-semibold transition #{active_filter == 'all' ? 'bg-blue-800 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'}" do %>
            All Activity (<%= @document_requests.size + @barangay_concerns.size %>)
          <% end %>

          <%= link_to admin_dashboard_path(filter: "documents"),
              data: { turbo: true, preserve_scroll: true },
              class: "rounded-md px-3 py-2 font-semibold transition #{active_filter == 'documents' ? 'bg-blue-800 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'}" do %>
            Document Requests (<%= @document_requests.size %>)
          <% end %>

          <%= link_to admin_dashboard_path(filter: "concerns"),
              data: { turbo: true, preserve_scroll: true },
              class: "rounded-md px-3 py-2 font-semibold transition #{active_filter == 'concerns' ? 'bg-blue-800 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'}" do %>
            Concern Reports (<%= @barangay_concerns.size %>)
          <% end %>
        </div>

        
      </div>

      <% if @recent_activities.any? %>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[850px] text-left text-sm">
            <thead class="bg-blue-50 text-xs uppercase text-slate-600">
              <tr>
                <th class="px-4 py-3">Docket No.</th>
                <th class="px-4 py-3">Type / Transaction</th>
                <th class="px-4 py-3">Resident Name</th>
                <th class="px-4 py-3">Purok / Location</th>
                <th class="px-4 py-3">Date & Time</th>
                <th class="px-4 py-3">Status</th>
                <th class="px-4 py-3">Action</th>
              </tr>
            </thead>

            <tbody class="divide-y divide-slate-100">
              <% @recent_activities.each do |activity| %>
                <% is_document = activity.is_a?(DocumentRequest) %>

                <tr class="hover:bg-slate-50">
                  <td class="px-4 py-4 font-semibold text-blue-800">
                    <%= activity.tracking_number.presence || "—" %>
                  </td>

                  <td class="px-4 py-4">
                    <p class="font-semibold text-slate-800">
                      <%= is_document ? activity.document_type.humanize : activity.category.humanize %>
                    </p>

                    <p class="mt-1 text-xs text-slate-500">
                      <%= is_document ? "Document Request" : "Concern Report" %>
                    </p>
                  </td>

                  <td class="px-4 py-4 text-slate-700">
                    <%= activity.resident&.profile&.first_name %>
                    <%= activity.resident&.profile&.last_name %>
                  </td>

                  <td class="px-4 py-4 text-slate-600">
                    <% if is_document %>
                      <%= activity.resident&.address&.purok || "—" %>
                    <% else %>
                      <%= activity.location_description.presence || "—" %>
                    <% end %>
                  </td>

                  <td class="whitespace-nowrap px-4 py-4 text-slate-600">
                    <%= activity.created_at.strftime("%b %d, %Y • %I:%M %p") %>
                  </td>

                  <td class="px-4 py-4">
                    <% status_color = case activity.status
                      when "pending"
                        "bg-amber-100 text-amber-800"
                      when "ongoing", "processing"
                        "bg-blue-100 text-blue-800"
                      when "ready_to_pickup", "resolved"
                        "bg-emerald-100 text-emerald-800"
                      when "rejected", "unactionable"
                        "bg-rose-100 text-rose-800"
                      else
                        "bg-slate-100 text-slate-700"
                      end %>

                    <span class="inline-block rounded-full px-3 py-1 text-xs font-semibold <%= status_color %>">
                      <%= activity.status.humanize %>
                    </span>
                  </td>

                  <td class="px-4 py-4">
                    <%= link_to "View",
                        is_document ? document_request_path(activity) : barangay_concern_path(activity),
                        class: "font-semibold text-blue-800 hover:underline" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="p-6 text-sm text-slate-500">
          No recent activity has been recorded.
        </p>
      <% end %>

      
      <!-- Pagination -->
      <div class="flex flex-col gap-3 border-t border-slate-200 bg-slate-50 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">

        <p class="text-sm text-slate-500">
          Showing
          <%= @pagy.from || 0 %>–<%= @pagy.to || 0 %>
          of <%= @pagy.count %> activities
        </p>

        <div>
          <%== @pagy.series_nav(querify: ->(q) { q['filter'] = params[:filter] if params[:filter].present? }) if @pagy.pages > 1 %>
        </div>

      </div>
    </section>

  </main>
</div>