<div class="min-h-screen bg-[#f3f5f9] lg:flex">
  <%= render "sidebar" %>

  <main class="mx-auto min-w-0 max-w-[1600px] flex-1 space-y-5 p-4 sm:p-6 lg:p-8">

    <!-- Welcome Header -->
    <header class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-7">
      <span class="inline-flex items-center gap-2 rounded-full bg-indigo-100 px-3 py-1 text-[11px] font-bold uppercase tracking-wide text-blue-900">
        <span class="h-1.5 w-1.5 rounded-full bg-blue-800"></span>
        Pag-access ng Tagapangasiwa
      </span>

      <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        Maligayang pagdating, <span class="text-blue-800">Tagapangasiwa</span>
      </h1>

      <p class="mt-1 text-sm text-slate-500">
        Pangkalahatang Dashboard ng Pamamalakad at Serbisyo Publiko
      </p>
    </header>

    <!-- Statistics -->
    <section class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      
      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition-shadow hover:shadow-md">
        <p class="text-xs font-semibold uppercase text-slate-500">Mga Kahilingang Naghihintay</p>
        <div class="mt-4 flex items-end justify-between">
          <p class="text-3xl font-bold text-slate-900"><%= @pending_docs_count %></p>
          <span class="rounded-xl bg-amber-50 p-3"><%= image_tag "docs.svg", alt: "", class: "h-7 w-7 object-contain" %></span>
        </div>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition-shadow hover:shadow-md">
        <p class="text-xs font-semibold uppercase text-slate-500">Mga Aktibong Suliranin</p>
        <div class="mt-4 flex items-end justify-between">
          <p class="text-3xl font-bold text-slate-900"><%= @ongoing_concerns_count %></p>
          <span class="rounded-xl bg-rose-50 p-3"><%= image_tag "kaso.svg", alt: "", class: "h-7 w-7 object-contain" %></span>
        </div>
      </div>

    </section>

    <% chart_max = [@activity_chart_data.flat_map { |bucket| [(@activity_type == "concerns" ? 0 : bucket[:documents]), (@activity_type == "documents" ? 0 : bucket[:concerns])] }.max.to_i, 1].max %>
    <% chart_axis_max = [[(chart_max / 10.0).ceil * 10, 10].max, chart_max].max %>
    <% chart_left = 58.0; chart_right = 735.0; chart_top = 35.0; chart_bottom = 175.0 %>
    <% chart_step = @activity_chart_data.size > 1 ? (chart_right - chart_left) / (@activity_chart_data.size - 1) : 0 %>
    <% chart_bar_width = [28.0, chart_step.positive? ? chart_step * 0.55 : 28.0].min %>
    <% chart_label_stride = [(@activity_chart_data.size / 10.0).ceil, 1].max %>
    <% chart_show_values = @activity_chart_data.size <= 31 %>
    <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
      <div class="flex flex-col gap-3 border-b border-slate-100 pb-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="font-semibold text-slate-900">Aktibidad ng mga Kahilingan at Ulat</h2>
          <p class="mt-1 text-sm text-slate-500"><%= @activity_date_from.strftime("%B %-d, %Y") %> – <%= @activity_date_to.strftime("%B %-d, %Y") %></p>
        </div>
        <div class="flex flex-wrap gap-4 text-xs text-slate-600">
          <% if @activity_type != "concerns" %><span class="flex items-center gap-2"><span class="h-3 w-3 rounded-sm bg-blue-800"></span>Mga Kahilingan sa Dokumento</span><% end %>
          <% if @activity_type != "documents" %><span class="flex items-center gap-2"><span class="h-1 w-4 rounded bg-emerald-700"></span>Mga Ulat ng Suliranin</span><% end %>
        </div>
      </div>

      <%= form_with url: admin_dashboard_path, method: :get, local: true, id: "activity-chart-filter", class: "mt-4 grid gap-3 rounded-xl bg-[#f4f7ff] p-4 sm:grid-cols-2 lg:grid-cols-[1fr_1fr_1.2fr_auto_auto] lg:items-end" do |f| %>
        <div>
          <%= f.label :activity_type, "Uri ng Aktibidad", class: "mb-1 block text-xs font-semibold text-slate-700" %>
          <%= f.select :activity_type, [["Mga Kahilingan at Ulat", "all"], ["Mga Kahilingan sa Dokumento", "documents"], ["Mga Ulat ng Suliranin", "concerns"], ["Mga Tapos na Kahilingan at Ulat", "completed"]], { selected: @activity_type }, class: "w-full rounded-lg border-0 bg-white px-3 py-2.5 text-sm text-slate-800 focus:ring-2 focus:ring-blue-300" %>
        </div>
        <div>
          <%= f.label :activity_period, "Panahon", class: "mb-1 block text-xs font-semibold text-slate-700" %>
          <%= f.select :activity_period, [["Nakaraang 7 Araw", "7days"], ["Nakaraang 30 Araw", "month"], ["Nakaraang 1 Taon", "year"], ["Pumili ng Petsa", "custom"]], { selected: @activity_period }, class: "w-full rounded-lg border-0 bg-white px-3 py-2.5 text-sm text-slate-800 focus:ring-2 focus:ring-blue-300" %>
        </div>
        <div id="activity-custom-dates" class="<%= @activity_period == 'custom' ? '' : 'hidden' %> grid grid-cols-2 gap-2">
          <div><%= f.label :date_from, "Simula", class: "mb-1 block text-xs font-semibold text-slate-700" %><%= f.date_field :date_from, value: @activity_date_from, class: "w-full rounded-lg border-0 bg-white px-2 py-2.5 text-sm focus:ring-2 focus:ring-blue-300" %></div>
          <div><%= f.label :date_to, "Hanggang", class: "mb-1 block text-xs font-semibold text-slate-700" %><%= f.date_field :date_to, value: @activity_date_to, class: "w-full rounded-lg border-0 bg-white px-2 py-2.5 text-sm focus:ring-2 focus:ring-blue-300" %></div>
        </div>
        <%= link_to "I-clear", admin_dashboard_path, id: "activity-chart-clear", data: { turbo: false }, class: "rounded-lg bg-white px-4 py-2.5 text-center text-sm font-semibold text-slate-700 ring-1 ring-slate-200 hover:bg-slate-50" %>
      <% end %>

      <div class="mt-4 grid grid-cols-1 gap-3 rounded-xl border border-blue-50 bg-[#f4f7ff] p-4 text-center sm:grid-cols-3 sm:gap-6">
        <div><p class="text-xs font-semibold uppercase text-slate-500">Kabuuang Kahilingan</p><p class="mt-1 text-lg font-bold text-blue-800"><%= number_with_delimiter(@activity_document_total) %></p></div>
        <div><p class="text-xs font-semibold uppercase text-slate-500">Kabuuang Ulat</p><p class="mt-1 text-lg font-bold text-emerald-700"><%= number_with_delimiter(@activity_concern_total) %></p></div>
        <div><p class="text-xs font-semibold uppercase text-slate-500">Pinakaabalang Panahon</p><p class="mt-1 font-semibold text-slate-900"><%= @activity_busiest_bucket && (@activity_busiest_bucket[:documents] + @activity_busiest_bucket[:concerns]).positive? ? @activity_busiest_bucket[:label] : "Walang aktibidad" %></p></div>
      </div>

      <div class="mt-6 w-full overflow-x-auto">
        <svg viewBox="0 0 760 230" class="min-w-[650px] w-full" role="img" aria-label="Aktuwal na bilang ng mga kahilingan at ulat sa napiling panahon">
          <g stroke="#e2e8f0" stroke-dasharray="3 4">
            <% [1.0, 0.75, 0.5, 0.25, 0].each do |ratio| %><% y = chart_bottom - ratio * (chart_bottom - chart_top) %><line x1="50" y1="<%= y %>" x2="735" y2="<%= y %>" /><% end %>
          </g>
          <g fill="#64748b" font-size="12" text-anchor="end">
            <% [1.0, 0.75, 0.5, 0.25, 0].each do |ratio| %><% y = chart_bottom - ratio * (chart_bottom - chart_top) + 4 %><text x="40" y="<%= y %>"><%= (chart_axis_max * ratio).round %></text><% end %>
          </g>
          <% if @activity_type != "concerns" %>
            <g fill="#2445b8">
              <% @activity_chart_data.each_with_index do |bucket, index| %>
                <% count = bucket[:documents]; x = chart_left + index * chart_step; bar_height = count.to_f / chart_axis_max * (chart_bottom - chart_top) %>
                <rect x="<%= x - chart_bar_width / 2 %>" y="<%= chart_bottom - bar_height %>" width="<%= chart_bar_width %>" height="<%= bar_height %>" rx="4" />
              <% end %>
            </g>
          <% end %>
          <% if @activity_type != "documents" %>
            <% concern_points = @activity_chart_data.each_with_index.map { |bucket, index| [chart_left + index * chart_step, chart_bottom - bucket[:concerns].to_f / chart_axis_max * (chart_bottom - chart_top)] } %>
            <% if concern_points.size > 1 %><polyline points="<%= concern_points.map { |x, y| "#{x},#{y}" }.join(" ") %>" fill="none" stroke="#047857" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /><% end %>
            <% concern_points.each_with_index do |(x, y), index| %>
              <circle cx="<%= x %>" cy="<%= y %>" r="4" fill="#047857" stroke="white" stroke-width="2" />
              <% count = @activity_chart_data[index][:concerns] %>
              <% if chart_show_values && count.positive? %>
                <% documents_count = @activity_chart_data[index][:documents] %>
                <% documents_bar_top = chart_bottom - documents_count.to_f / chart_axis_max * (chart_bottom - chart_top) %>
                <% documents_label_y = chart_bottom - documents_count.to_f / chart_axis_max * (chart_bottom - chart_top) - 7 %>
                <% concerns_label_y = y - 9 %>
                <% concern_point_over_bar = documents_count.positive? && y >= documents_bar_top - 3 && y <= chart_bottom %>
                <% labels_overlap = documents_count.positive? && ((documents_label_y - concerns_label_y).abs < 16 || concern_point_over_bar) %>
                <% place_below_point = labels_overlap && y < chart_bottom - 28 %>
                <% place_beside_point = concern_point_over_bar || (labels_overlap && !place_below_point) %>
                <% label_x = place_beside_point ? x + chart_bar_width / 2 + 4 : x %>
                <% label_y = place_below_point ? y + 17 : concerns_label_y %>
                <text x="<%= label_x %>" y="<%= label_y %>" fill="#047857" stroke="#fff" stroke-width="3" paint-order="stroke" font-size="11" font-weight="700" text-anchor="<%= place_beside_point ? 'start' : 'middle' %>"><%= count %></text>
              <% end %>
            <% end %>
          <% end %>
          <% if @activity_type != "concerns" && chart_show_values %>
            <% @activity_chart_data.each_with_index do |bucket, index| %>
              <% count = bucket[:documents]; next unless count.positive? %>
              <% x = chart_left + index * chart_step; bar_top = chart_bottom - count.to_f / chart_axis_max * (chart_bottom - chart_top) %>
              <text x="<%= x %>" y="<%= bar_top - 7 %>" fill="#1d4ed8" stroke="#fff" stroke-width="3" paint-order="stroke" font-size="11" font-weight="700" text-anchor="middle"><%= count %></text>
            <% end %>
          <% end %>
          <g fill="#475569" font-size="11" text-anchor="middle">
            <% @activity_chart_data.each_with_index do |bucket, index| %>
              <% next unless index % chart_label_stride == 0 || index == @activity_chart_data.size - 1 %>
              <% x = chart_left + index * chart_step %><text x="<%= x %>" y="197"><%= bucket[:label] %></text>
            <% end %>
          </g>
        </svg>
      </div>
    </section>

    <!-- Recent Activity -->
    <%= turbo_frame_tag "admin_recent_activities" do %>
    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

      <div class="flex flex-col gap-4 p-5 sm:p-6 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <h2 class="flex items-center gap-2 font-semibold text-slate-900"><%= image_tag "recentactivity.svg", alt: "", class: "h-5 w-5 shrink-0 object-contain" %> Mga Kamakailang Gawain</h2>
          <p class="mt-1 text-sm text-slate-500">
            Kamakailang Aktibidad sa Barangay Portal
          </p>
        </div>

        <% active_filter = params[:filter] || "all" %>
        <div class="flex flex-wrap gap-1 rounded-lg border border-slate-200 bg-slate-50 p-1 text-xs">
          <%= link_to admin_dashboard_path(filter: "all"),
              data: { turbo: true, preserve_scroll: true },
              class: "rounded-md px-3 py-2 font-semibold transition #{active_filter == 'all' ? 'bg-blue-800 text-white shadow-sm' : 'text-slate-600 hover:bg-white'}" do %>
            Lahat ng Gawain (<%= @document_requests.size + @barangay_concerns.size %>)
          <% end %>

          <%= link_to admin_dashboard_path(filter: "documents"),
              data: { turbo: true, preserve_scroll: true },
              class: "rounded-md px-3 py-2 font-semibold transition #{active_filter == 'documents' ? 'bg-blue-800 text-white shadow-sm' : 'text-slate-600 hover:bg-white'}" do %>
            Mga Kahilingan sa Dokumento (<%= @document_requests.size %>)
          <% end %>

          <%= link_to admin_dashboard_path(filter: "concerns"),
              data: { turbo: true, preserve_scroll: true },
              class: "rounded-md px-3 py-2 font-semibold transition #{active_filter == 'concerns' ? 'bg-blue-800 text-white shadow-sm' : 'text-slate-600 hover:bg-white'}" do %>
            Mga Ulat ng Suliranin (<%= @barangay_concerns.size %>)
          <% end %>
        </div>

        
      </div>

      <% if @recent_activities.any? %>
        <div class="max-h-[460px] overflow-auto overscroll-contain">
          <table class="w-full min-w-[900px] text-left text-sm">
            <thead class="sticky top-0 z-10 bg-[#eef3ff] text-[11px] uppercase tracking-wide text-slate-600">
              <tr>
                <th class="px-4 py-3">Numero ng Talaan</th>
                <th class="px-4 py-3">Uri / Transaksyon</th>
                <th class="px-4 py-3">Pangalan ng Residente</th>
                <th class="px-4 py-3">Purok / Lokasyon</th>
                <th class="px-4 py-3">Petsa at Oras</th>
                <th class="px-4 py-3">Kalagayan</th>
              </tr>
            </thead>

            <tbody class="divide-y divide-slate-100">
              <% @recent_activities.each do |activity| %>
                <% is_document = activity.is_a?(DocumentRequest) %>

                <tr class="transition-colors hover:bg-slate-50/80">
                  <td class="px-4 py-5 font-semibold text-blue-800">
                    <%= activity.tracking_number.presence || "—" %>
                  </td>

                  <td class="px-4 py-5">
                    <p class="font-semibold text-slate-800">
                      <%= tagalog_label(is_document ? activity.document_type : activity.category) %>
                    </p>

                    <p class="mt-1 text-xs text-slate-500">
                      <%= is_document ? "Kahilingan sa Dokumento" : "Ulat ng Suliranin" %>
                    </p>
                  </td>

                  <td class="px-4 py-5 text-slate-700">
                    <%= activity.resident&.profile&.first_name %>
                    <%= activity.resident&.profile&.last_name %>
                  </td>

                  <td class="px-4 py-5 text-slate-600">
                    <% if is_document %>
                      <%= activity.resident&.address&.purok || "—" %>
                    <% else %>
                      <%= activity.location_description.presence || "—" %>
                    <% end %>
                  </td>

                  <td class="whitespace-nowrap px-4 py-5 text-slate-600">
                    <%= activity.created_at.strftime("%b %d, %Y • %I:%M %p") %>
                  </td>

                  <td class="px-4 py-5">
                    <% status_color = tagalog_status_class(activity.status) %>

                    <span class="inline-block rounded-full px-3 py-1 text-xs font-semibold <%= status_color %>">
                      <%= tagalog_status(activity.status) %>
                    </span>
                  </td>

                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="p-6 text-sm text-slate-500">
          Wala pang naitatalang gawain.
        </p>
      <% end %>

      
      <!-- Pagination -->
      <div class="flex flex-col gap-3 border-t border-slate-200 bg-[#f8faff] px-5 py-4 sm:flex-row sm:items-center sm:justify-between">

        <p class="text-sm text-slate-500">
          Ipinapakita ang
          <%= @pagy.from || 0 %>–<%= @pagy.to || 0 %>
          sa kabuuang <%= @pagy.count %> gawain
        </p>

        <div>
          <%== @pagy.series_nav(querify: ->(q) { q['filter'] = params[:filter] if params[:filter].present? }) if @pagy.pages > 1 %>
        </div>

      </div>
    </section>
    <% end %>

  </main>
</div>

<script>
  (() => {
    const scrollStorageKey = "adminActivityChartScrollY"

    const restoreActivityScroll = () => {
      const savedPosition = sessionStorage.getItem(scrollStorageKey)
      if (savedPosition === null) return

      sessionStorage.removeItem(scrollStorageKey)
      window.setTimeout(() => requestAnimationFrame(() => window.scrollTo(0, Number(savedPosition))), 100)
    }

    const initializeActivityFilters = () => {
      const form = document.getElementById("activity-chart-filter")
      const clearButton = document.getElementById("activity-chart-clear")
      const preserveScroll = () => sessionStorage.setItem(scrollStorageKey, String(window.scrollY))

      if (clearButton && clearButton.dataset.scrollInitialized !== "true") {
        clearButton.dataset.scrollInitialized = "true"
        clearButton.addEventListener("click", preserveScroll)
      }
      if (!form || form.dataset.initialized === "true") return
      form.dataset.initialized = "true"

      const submitFilters = () => {
        preserveScroll()
        form.requestSubmit()
      }
      const period = form.querySelector('[name="activity_period"]')
      const type = form.querySelector('[name="activity_type"]')
      const dateFields = document.getElementById("activity-custom-dates")
      period?.addEventListener("change", () => {
        dateFields?.classList.toggle("hidden", period.value !== "custom")
        submitFilters()
      })
      type?.addEventListener("change", submitFilters)
      dateFields?.querySelectorAll('input[type="date"]').forEach((field) => {
        field.addEventListener("change", submitFilters)
      })
    }

    document.addEventListener("turbo:load", () => {
      restoreActivityScroll()
      initializeActivityFilters()
    })
    document.addEventListener("DOMContentLoaded", () => {
      restoreActivityScroll()
      initializeActivityFilters()
    })
  })()
</script>
