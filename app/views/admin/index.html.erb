<div class="min-h-screen bg-[#f3f5f9] lg:flex">
  <%= render "sidebar" %>

  <main class="mx-auto min-w-0 max-w-[1600px] flex-1 space-y-5 p-4 sm:p-6 lg:p-8">

    <!-- Welcome Header -->
    <header class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-7">
      <span class="inline-flex items-center gap-2 rounded-full bg-indigo-100 px-3 py-1 text-[11px] font-bold uppercase tracking-wide text-blue-900">
        <span class="h-1.5 w-1.5 rounded-full bg-blue-800"></span>
        Pag-access ng Tagapangasiwa
      </span>

      <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        Maligayang pagdating, <span class="text-blue-800">Tagapangasiwa</span>
      </h1>

      <p class="mt-1 text-sm text-slate-500">
        Pangkalahatang Dashboard ng Pamamalakad at Serbisyo Publiko
      </p>
    </header>

    <!-- Statistics -->
    <section class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      
      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition-shadow hover:shadow-md">
        <p class="text-xs font-semibold uppercase text-slate-500">Mga Kahilingang Naghihintay</p>
        <div class="mt-4 flex items-end justify-between">
          <p class="text-3xl font-bold text-slate-900"><%= @pending_docs_count %></p>
          <span class="rounded-xl bg-amber-50 p-3"><%= image_tag "docs.svg", alt: "", class: "h-7 w-7 object-contain" %></span>
        </div>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition-shadow hover:shadow-md">
        <p class="text-xs font-semibold uppercase text-slate-500">Mga Aktibong Suliranin</p>
        <div class="mt-4 flex items-end justify-between">
          <p class="text-3xl font-bold text-slate-900"><%= @ongoing_concerns_count %></p>
          <span class="rounded-xl bg-rose-50 p-3"><%= image_tag "kaso.svg", alt: "", class: "h-7 w-7 object-contain" %></span>
        </div>
      </div>

    </section>

    <!-- TODO: HARDCODED Activity Chart -->
    <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
      <div class="flex flex-col gap-3 border-b border-slate-100 pb-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="font-semibold text-slate-900">
            Aktibidad ng mga Kahilingan at Ulat (Nakaraang 7 Araw)
          </h2>
          <p class="mt-1 text-sm text-slate-500">
            Ulat at Kahilingan sa Nakaraang 7 Araw
          </p>
        </div>

        <div class="flex flex-wrap gap-4 text-xs text-slate-600">
          <span class="flex items-center gap-2">
            <span class="h-3 w-3 rounded-sm bg-blue-800"></span>
            Mga Kahilingan sa Dokumento
          </span>

          <span class="flex items-center gap-2">
            <span class="h-1 w-4 rounded bg-emerald-700"></span>
            Mga Ulat ng Suliranin
          </span>
        </div>
      </div>

      <!-- Hardcoded sample summary -->
      <div class="mt-4 grid grid-cols-1 gap-3 rounded-xl border border-blue-50 bg-[#f4f7ff] p-4 text-center sm:grid-cols-3 sm:gap-6">
        <div>
          <p class="text-xs font-semibold uppercase text-slate-500">Kabuuang Kahilingan sa loob ng 7 Araw</p>
          <p class="mt-1 text-lg font-bold text-blue-800">224</p>
        </div>

        <div>
          <p class="text-xs font-semibold uppercase text-slate-500">Kabuuang Ulat sa loob ng 7 Araw</p>
          <p class="mt-1 text-lg font-bold text-emerald-700">59</p>
        </div>

        <div>
          <p class="text-xs font-semibold uppercase text-slate-500">Pinakaabalang Araw</p>
          <p class="mt-1 font-semibold text-slate-900">Lunes</p>
        </div>
      </div>

      <!-- Hardcoded SVG chart -->
      <div class="mt-6 w-full overflow-x-auto">
        <svg viewBox="0 0 760 230" class="min-w-[650px] w-full" role="img" aria-label="Sample activity chart for the past seven days">
          <!-- Grid lines -->
          <g stroke="#e2e8f0" stroke-dasharray="3 4">
            <line x1="50" y1="35" x2="735" y2="35" />
            <line x1="50" y1="70" x2="735" y2="70" />
            <line x1="50" y1="105" x2="735" y2="105" />
            <line x1="50" y1="140" x2="735" y2="140" />
            <line x1="50" y1="175" x2="735" y2="175" />
          </g>

          <!-- Y-axis labels -->
          <g fill="#64748b" font-size="12" text-anchor="end">
            <text x="40" y="39">50</text>
            <text x="40" y="74">40</text>
            <text x="40" y="109">30</text>
            <text x="40" y="144">20</text>
            <text x="40" y="179">0</text>
          </g>

          <!-- Kahilingan bars -->
          <g fill="#2445b8">
            <rect x="75" y="105" width="28" height="70" rx="4" />
            <rect x="165" y="133" width="28" height="42" rx="4" />
            <rect x="255" y="147" width="28" height="28" rx="4" />
            <rect x="345" y="42" width="28" height="133" rx="4" fill="#082f87" />
            <rect x="435" y="63" width="28" height="112" rx="4" />
            <rect x="525" y="77" width="28" height="98" rx="4" />
            <rect x="615" y="70" width="28" height="105" rx="4" />
          </g>

          <!-- Kahilingan values -->
          <g fill="#1d4ed8" font-size="11" font-weight="600" text-anchor="middle">
            <text x="89" y="98">28</text>
            <text x="179" y="126">16</text>
            <text x="269" y="140">12</text>
            <text x="359" y="35">48</text>
            <text x="449" y="56">42</text>
            <text x="539" y="70">38</text>
            <text x="629" y="63">40</text>
          </g>

          <!-- Concern report line -->
          <polyline
            points="89,155 179,163 269,166 359,128 449,137 539,150 629,135"
            fill="none"
            stroke="#047857"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />

          <g fill="#047857" stroke="white" stroke-width="2">
            <circle cx="89" cy="155" r="4" />
            <circle cx="179" cy="163" r="4" />
            <circle cx="269" cy="166" r="4" />
            <circle cx="359" cy="128" r="4" />
            <circle cx="449" cy="137" r="4" />
            <circle cx="539" cy="150" r="4" />
            <circle cx="629" cy="135" r="4" />
          </g>

          <!-- X-axis labels -->
          <g fill="#475569" font-size="11" text-anchor="middle">
            <text x="89" y="197">Fri</text>
            <text x="179" y="197">Sat</text>
            <text x="269" y="197">Sun</text>
            <text x="359" y="197">Mon</text>
            <text x="449" y="197">Tue</text>
            <text x="539" y="197">Wed</text>
            <text x="629" y="197">Thu</text>
          </g>
        </svg>
      </div>
    </section>

    <!-- Recent Activity -->
    <%= turbo_frame_tag "admin_recent_activities" do %>
    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

      <div class="flex flex-col gap-4 p-5 sm:p-6 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <h2 class="flex items-center gap-2 font-semibold text-slate-900"><%= image_tag "recentactivity.svg", alt: "", class: "h-5 w-5 shrink-0 object-contain" %> Mga Kamakailang Gawain</h2>
          <p class="mt-1 text-sm text-slate-500">
            Kamakailang Aktibidad sa Barangay Portal
          </p>
        </div>

        <% active_filter = params[:filter] || "all" %>
        <div class="flex flex-wrap gap-1 rounded-lg border border-slate-200 bg-slate-50 p-1 text-xs">
          <%= link_to admin_dashboard_path(filter: "all"),
              data: { turbo: true, preserve_scroll: true },
              class: "rounded-md px-3 py-2 font-semibold transition #{active_filter == 'all' ? 'bg-blue-800 text-white shadow-sm' : 'text-slate-600 hover:bg-white'}" do %>
            Lahat ng Gawain (<%= @document_requests.size + @barangay_concerns.size %>)
          <% end %>

          <%= link_to admin_dashboard_path(filter: "documents"),
              data: { turbo: true, preserve_scroll: true },
              class: "rounded-md px-3 py-2 font-semibold transition #{active_filter == 'documents' ? 'bg-blue-800 text-white shadow-sm' : 'text-slate-600 hover:bg-white'}" do %>
            Mga Kahilingan sa Dokumento (<%= @document_requests.size %>)
          <% end %>

          <%= link_to admin_dashboard_path(filter: "concerns"),
              data: { turbo: true, preserve_scroll: true },
              class: "rounded-md px-3 py-2 font-semibold transition #{active_filter == 'concerns' ? 'bg-blue-800 text-white shadow-sm' : 'text-slate-600 hover:bg-white'}" do %>
            Mga Ulat ng Suliranin (<%= @barangay_concerns.size %>)
          <% end %>
        </div>

        
      </div>

      <% if @recent_activities.any? %>
        <div class="max-h-[460px] overflow-auto overscroll-contain">
          <table class="w-full min-w-[900px] text-left text-sm">
            <thead class="sticky top-0 z-10 bg-[#eef3ff] text-[11px] uppercase tracking-wide text-slate-600">
              <tr>
                <th class="px-4 py-3">Numero ng Talaan</th>
                <th class="px-4 py-3">Uri / Transaksyon</th>
                <th class="px-4 py-3">Pangalan ng Residente</th>
                <th class="px-4 py-3">Purok / Lokasyon</th>
                <th class="px-4 py-3">Petsa at Oras</th>
                <th class="px-4 py-3">Kalagayan</th>
              </tr>
            </thead>

            <tbody class="divide-y divide-slate-100">
              <% @recent_activities.each do |activity| %>
                <% is_document = activity.is_a?(DocumentRequest) %>

                <tr class="transition-colors hover:bg-slate-50/80">
                  <td class="px-4 py-5 font-semibold text-blue-800">
                    <%= activity.tracking_number.presence || "—" %>
                  </td>

                  <td class="px-4 py-5">
                    <p class="font-semibold text-slate-800">
                      <%= tagalog_label(is_document ? activity.document_type : activity.category) %>
                    </p>

                    <p class="mt-1 text-xs text-slate-500">
                      <%= is_document ? "Kahilingan sa Dokumento" : "Ulat ng Suliranin" %>
                    </p>
                  </td>

                  <td class="px-4 py-5 text-slate-700">
                    <%= activity.resident&.profile&.first_name %>
                    <%= activity.resident&.profile&.last_name %>
                  </td>

                  <td class="px-4 py-5 text-slate-600">
                    <% if is_document %>
                      <%= activity.resident&.address&.purok || "—" %>
                    <% else %>
                      <%= activity.location_description.presence || "—" %>
                    <% end %>
                  </td>

                  <td class="whitespace-nowrap px-4 py-5 text-slate-600">
                    <%= activity.created_at.strftime("%b %d, %Y • %I:%M %p") %>
                  </td>

                  <td class="px-4 py-5">
                    <% status_color = tagalog_status_class(activity.status) %>

                    <span class="inline-block rounded-full px-3 py-1 text-xs font-semibold <%= status_color %>">
                      <%= tagalog_status(activity.status) %>
                    </span>
                  </td>

                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="p-6 text-sm text-slate-500">
          Wala pang naitatalang gawain.
        </p>
      <% end %>

      
      <!-- Pagination -->
      <div class="flex flex-col gap-3 border-t border-slate-200 bg-[#f8faff] px-5 py-4 sm:flex-row sm:items-center sm:justify-between">

        <p class="text-sm text-slate-500">
          Ipinapakita ang
          <%= @pagy.from || 0 %>–<%= @pagy.to || 0 %>
          sa kabuuang <%= @pagy.count %> gawain
        </p>

        <div>
          <%== @pagy.series_nav(querify: ->(q) { q['filter'] = params[:filter] if params[:filter].present? }) if @pagy.pages > 1 %>
        </div>

      </div>
    </section>
    <% end %>

  </main>
</div>
