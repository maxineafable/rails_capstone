<div class="min-h-screen bg-[#f3f5f9] lg:flex">
  <%= render "sidebar" %>

  <main class="mx-auto min-w-0 max-w-[1600px] flex-1 space-y-5 p-4 sm:p-6 lg:p-8">

    <!-- Header -->
    <header class="rounded-2xl border border-slate-200 bg-white px-6 py-6 shadow-sm sm:px-7">
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        Pamamahala ng mga Ulat ng Suliranin sa Komunidad
      </h1>

      <p class="mt-2 max-w-3xl text-sm text-slate-600">
        Subaybayan at asikasuhin ang mga suliraning iniulat ng mga residente.
      </p>
    </header>

    <!-- Statistics -->
    <section class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">

      <!-- Total Reports -->
      <div class="flex min-h-40 items-center justify-between rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
        <div>
          <p class="text-[11px] font-bold uppercase tracking-wide text-blue-800">Lahat ng Ulat</p>

          <p class="mt-2 text-4xl font-bold text-blue-900">
            <%= @total_concerns %>
          </p>

        </div>

        <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-100">
          <%= image_tag "all.svg", alt: "", class: "h-7 w-7 object-contain" %>
        </span>
      </div>

      <!-- Pending -->
      <div class="flex min-h-40 items-center justify-between rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
        <div>
          <p class="text-[11px] font-bold uppercase tracking-wide text-amber-800">Naghihintay</p>

          <p class="mt-2 text-4xl font-bold text-amber-900">
            <%= @pending_concerns %>
          </p>

        </div>

        <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-orange-100">
          <%= image_tag "pending.svg", alt: "", class: "h-7 w-7 object-contain" %>
        </span>
      </div>

      <!-- In Progress -->
      <div class="flex min-h-40 items-center justify-between rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
        <div>
          <p class="text-[11px] font-bold uppercase tracking-wide text-blue-700">Isinasagawa</p>

          <p class="mt-2 text-4xl font-bold text-blue-800">
            <%= @ongoing_concerns %>
          </p>

        </div>

        <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-100">
          <%= image_tag "Icon.svg", alt: "", class: "h-7 w-7 object-contain" %>
        </span>
      </div>

      <!-- Resolved -->
      <div class="flex min-h-40 items-center justify-between rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
        <div>
          <p class="text-[11px] font-bold uppercase tracking-wide text-emerald-700">Nalutas</p>

          <p class="mt-2 text-4xl font-bold text-emerald-700">
            <%= @resolved_concerns %>
          </p>

        </div>

        <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-100">
          <%= image_tag "resolved.svg", alt: "", class: "h-7 w-7 object-contain" %>
        </span>
      </div>

    </section>

    <!-- Search and Filters -->
    <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
      <%= form_with url: admin_barangay_concerns_path,
                    method: :get,
                    local: true,
                    class: "space-y-3" do |f| %>

        <!-- Search -->
        <div class="min-w-0">
          <div class="relative">
            <%= image_tag "search.svg", alt: "", class: "pointer-events-none absolute left-3 top-1/2 h-5 w-5 -translate-y-1/2 object-contain" %>
            <%= f.text_field :search,
                  value: params[:search],
                  placeholder: "Maghanap ng numero, residente, o lokasyon...",
                  class: "w-full rounded-lg border border-transparent bg-[#EEF3FF] py-3 pl-10 pr-4 text-sm text-slate-800 placeholder:text-slate-500 focus:border-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-100",
                  data: { controller: "auto-submit", action: "input->auto-submit#schedule keydown.enter->auto-submit#submit" } %>
          </div>
        </div>

        <!-- Filter Options -->
        <div class="grid grid-cols-1 gap-2 md:grid-cols-2 xl:grid-cols-[1fr_1fr_1fr_auto]">

          <%= f.select :status,
                [
                  ["Lahat ng Kalagayan", ""],
                  ["Naghihintay", "pending"],
                  ["Isinasagawa", "ongoing"],
                  ["Nalutas", "resolved"],
                  ["Hindi maaaksyunan", "unactionable"]
                ],
                { selected: params[:status] },
                onchange: "this.form.requestSubmit()",
                class: "w-full rounded-lg border border-transparent bg-[#EEF3FF] px-4 py-3 text-sm text-slate-800 focus:border-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-100" %>

          <%= f.select :category,
                [
                  ["Lahat ng Kategorya", ""]
                ] + BarangayConcern.categories.keys.map { |category| [tagalog_label(category), category] },
                { selected: params[:category] },
                onchange: "this.form.requestSubmit()",
                class: "w-full rounded-lg border border-transparent bg-[#EEF3FF] px-4 py-3 text-sm text-slate-800 focus:border-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-100" %>

          <div class="relative" data-controller="date-range" data-action="click@window->date-range#closeOnOutside keydown.esc@window->date-range#close">
            <button type="button" data-date-range-target="trigger" data-action="date-range#toggle" aria-label="Pumili ng saklaw ng petsa" aria-expanded="false" class="flex w-full items-center justify-between gap-3 rounded-lg bg-[#EEF3FF] px-4 py-3 text-left text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-100">
              <span data-date-range-target="label" class="truncate">Pumili ng saklaw ng petsa</span>
              <%= image_tag "calendar.svg", alt: "", class: "h-5 w-5 shrink-0 object-contain" %>
            </button>

            <div data-date-range-target="popup" hidden class="absolute right-0 top-full z-30 mt-2 w-[min(54rem,calc(100vw-2rem))] rounded-2xl border border-slate-200 bg-white p-4 shadow-xl sm:p-5">
              <div class="grid gap-5 sm:grid-cols-2 sm:gap-8">
                <section aria-label="Unang buwan">
                  <div class="mb-2 flex h-9 items-center justify-between">
                    <button type="button" data-action="date-range#previousLeftMonth" aria-label="Nakaraang buwan sa unang kalendaryo" class="rounded-full p-2 text-slate-500 hover:bg-slate-100">‹</button>
                    <h3 data-date-range-target="leftMonth" class="text-sm font-semibold text-slate-700"></h3>
                    <button type="button" data-action="date-range#nextLeftMonth" aria-label="Susunod na buwan sa unang kalendaryo" class="rounded-full p-2 text-slate-500 hover:bg-slate-100">›</button>
                  </div>
                  <div data-date-range-target="leftGrid" class="grid grid-cols-7"></div>
                </section>

                <section aria-label="Ikalawang buwan">
                  <div class="mb-2 flex h-9 items-center justify-between">
                    <button type="button" data-action="date-range#previousRightMonth" aria-label="Nakaraang buwan sa ikalawang kalendaryo" class="rounded-full p-2 text-slate-500 hover:bg-slate-100">‹</button>
                    <h3 data-date-range-target="rightMonth" class="text-sm font-semibold text-slate-700"></h3>
                    <button type="button" data-action="date-range#nextRightMonth" aria-label="Susunod na buwan sa ikalawang kalendaryo" class="rounded-full p-2 text-slate-500 hover:bg-slate-100">›</button>
                  </div>
                  <div data-date-range-target="rightGrid" class="grid grid-cols-7"></div>
                </section>
              </div>

              <%= hidden_field_tag :date_from, params[:date_from], data: { date_range_target: "start" } %>
              <%= hidden_field_tag :date_to, params[:date_to], data: { date_range_target: "end" } %>

              <p data-date-range-target="message" aria-live="polite" class="mt-3 min-h-4 text-xs text-rose-700"></p>

              <div class="mt-3 flex flex-col gap-3 border-t border-slate-200 pt-4 sm:flex-row sm:items-center sm:justify-between">
                <div class="flex flex-wrap items-center gap-2 text-sm">
                    <span data-date-range-target="startDisplay" class="rounded-lg border border-slate-300 px-3 py-2 font-medium text-slate-700">Simula</span>
                  <span class="text-slate-500" aria-hidden="true">→</span>
                  <span data-date-range-target="dayCount" class="text-center text-xs text-slate-500">—</span>
                  <span class="text-xs text-slate-500">araw</span>
                    <span data-date-range-target="endDisplay" class="rounded-lg border border-slate-300 px-3 py-2 font-medium text-slate-700">Pagtatapos</span>
                </div>
                <div class="flex justify-end gap-2">
                  <button type="button" data-action="date-range#clear" class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50">I-clear</button>
                  <button type="button" data-action="date-range#save" class="rounded-lg bg-blue-700 px-5 py-2 text-sm font-semibold text-white hover:bg-blue-800">I-save ang Petsa</button>
                </div>
              </div>
            </div>
          </div>

          <div class="flex items-center justify-end gap-3 md:col-span-2 xl:col-span-1">
            <%= link_to admin_barangay_concerns_path, class: "inline-flex items-center gap-1.5 whitespace-nowrap text-xs font-semibold text-blue-800 hover:underline" do %>
              <%= image_tag "clearfilters.svg", alt: "", class: "h-4 w-4 object-contain" %>
              I-clear ang mga Salain
            <% end %>
          </div>
        </div>

      <% end %>
    </section>

    <!-- Barangay Concerns Table -->
    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

      <div class="overflow-x-auto">
        <table class="w-full min-w-[1000px] border-collapse text-left text-xs">

          <thead class="bg-[#eef3ff] text-[10px] uppercase tracking-wide text-slate-600">
            <tr>
              <th class="px-4 py-5 font-bold">Numero ng Sanggunian</th>
              <th class="px-4 py-5 font-bold">Kategorya</th>
              <th class="px-4 py-5 font-bold">Paglalarawan</th>
              <th class="px-4 py-5 font-bold">Pangalan ng Nag-ulat</th>
              <th class="px-4 py-5 font-bold">Purok / Lokasyon</th>
              <th class="px-4 py-5 font-bold">Petsa ng Pag-uulat</th>
              <th class="px-4 py-5 font-bold">Kalagayan</th>
              <th class="px-4 py-5 text-center font-bold">Mga Aksyon</th>
            </tr>
          </thead>

          <tbody class="divide-y divide-slate-100">

            <% @all_barangay_concerns.each do |concern| %>
              <tr class="transition-colors odd:bg-white even:bg-[#f1f5ff] hover:bg-blue-50">

                <!-- Reference Number -->
                <td class="whitespace-nowrap px-4 py-5">
                  <span class="font-bold text-blue-800">
                    <%= concern.tracking_number.presence || "CR-#{concern.id}" %>
                  </span>
                </td>

                <!-- Category -->
                <td class="whitespace-nowrap px-4 py-5">
                  <span class="font-bold text-slate-800">
                    <%= tagalog_label(concern.category) %>
                  </span>
                </td>

                <!-- Description -->
                <td class="max-w-48 px-4 py-5">
                  <p class="text-slate-800">
                    <%= truncate(concern.reason, length: 75) %>
                  </p>
                </td>

                <!-- Reporter -->
                <td class="whitespace-nowrap px-4 py-5 text-slate-800">
                  <%= concern.resident&.profile&.first_name %>
                  <%= concern.resident&.profile&.last_name %>
                </td>

                <!-- Location -->
                <td class="max-w-36 px-4 py-5 text-slate-600">
                  <p>
                    Purok <%= concern.resident&.address&.purok || "—" %>
                  </p>

                  <p class="mt-1">
                    <%= concern.location_description.presence || "—" %>
                  </p>
                </td>

                <!-- Date Reported -->
                <td class="whitespace-nowrap px-4 py-5 text-slate-600">
                  <p>
                    <%= tagalog_date(concern.created_at) %>
                  </p>

                  <p class="mt-1">
                    <%= concern.created_at.strftime("%I:%M %p") %>
                  </p>
                </td>

                <!-- Status -->
                <td class="whitespace-nowrap px-4 py-5">
                  <span class="inline-flex rounded-full px-3 py-1.5 text-[10px] font-bold <%= tagalog_status_class(concern.status) %>">
                    <%= tagalog_status(concern.status) %>
                  </span>
                </td>

                <!-- Actions -->
                <td class="px-4 py-5 text-center">
                  <%= link_to "Tingnan",
                        barangay_concern_path(concern),
                        class: "inline-block rounded-lg bg-blue-100 px-4 py-1.5 font-semibold text-slate-800 hover:bg-blue-200" %>
                </td>

              </tr>
            <% end %>

            <% if @all_barangay_concerns.empty? %>
              <tr>
                <td colspan="8" class="px-4 py-12 text-center text-sm text-slate-500">
                  Walang nahanap na ulat ng suliranin.
                </td>
              </tr>
            <% end %>

          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <div class="flex flex-col gap-3 border-t border-slate-200 bg-[#f8faff] px-5 py-4 sm:flex-row sm:items-center sm:justify-between">

        <p class="text-xs text-slate-600">
          Ipinapakita ang
          <span class="font-semibold text-slate-800">
            <%= @pagy.from || 0 %>–<%= @pagy.to || 0 %>
          </span>
          sa kabuuang
          <span class="font-semibold text-slate-800">
            <%= @pagy.count %>
          </span>
          ulat
        </p>

        <div class="flex justify-center gap-2 font-semibold">
          <%== @pagy.series_nav(querify: ->(q) { %w[search status category sort_direction date_from date_to].each { |key| q[key] = params[key] if params[key].present? } }) if @pagy.pages > 1 %>
        </div>

      </div>

    </section>

  </main>
</div>
