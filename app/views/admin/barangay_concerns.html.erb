<div class="flex min-h-screen bg-[#F4F4F8]">
  <%= render "sidebar" %>

  <main class="min-w-0 flex-1 space-y-6 p-6">

    <!-- Header -->
    <header class="rounded-xl border border-slate-100 bg-white px-6 py-6">
      <h1 class="text-2xl font-bold tracking-tight text-slate-900">
        Pamamahala ng mga Ulat ng Suliranin sa Komunidad
      </h1>

      <p class="mt-1 text-sm text-slate-600">
        Subaybayan at asikasuhin ang mga suliraning iniulat ng mga residente.
      </p>
    </header>

    <!-- Statistics -->
    <section class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">

      <!-- Total Reports -->
      <div class="flex items-center justify-between rounded-xl border border-slate-100 bg-white p-6">
        <div>
          <p class="text-xs font-semibold text-slate-600">Kabuuang mga Ulat</p>

          <p class="mt-2 text-4xl font-bold text-blue-800">
            <%= @total_concerns %>
          </p>

          <p class="mt-1 max-w-24 text-xs text-slate-600">
            Kabuuan sa buwang ito
          </p>
        </div>

        <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-indigo-100 text-xl text-blue-800">
          ▱
        </span>
      </div>

      <!-- Pending -->
      <div class="flex items-center justify-between rounded-xl border border-slate-100 bg-white p-6">
        <div>
          <p class="text-xs font-semibold text-slate-600">Naghihintay</p>

          <p class="mt-2 text-4xl font-bold text-amber-900">
            <%= @pending_concerns %>
          </p>

          <p class="mt-1 max-w-24 text-xs text-slate-600">
            Nangangailangan ng aksyon
          </p>
        </div>

        <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-orange-100 text-xl text-amber-950">
          ◷
        </span>
      </div>

      <!-- In Progress -->
      <div class="flex items-center justify-between rounded-xl border border-slate-100 bg-white p-6">
        <div>
          <p class="text-xs font-semibold text-slate-600">Isinasagawa</p>

          <p class="mt-2 text-4xl font-bold text-blue-800">
            <%= @ongoing_concerns %>
          </p>

          <p class="mt-1 max-w-24 text-xs text-slate-600">
            Kasalukuyang inaayos
          </p>
        </div>

        <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-indigo-100 text-xl text-blue-800">
          ⚒
        </span>
      </div>

      <!-- Resolved -->
      <div class="flex items-center justify-between rounded-xl border border-slate-100 bg-white p-6">
        <div>
          <p class="text-xs font-semibold text-slate-600">Nalutas</p>

          <p class="mt-2 text-4xl font-bold text-emerald-700">
            <%= @resolved_concerns %>
          </p>

          <p class="mt-1 max-w-24 text-xs text-slate-600">
            Matagumpay na natapos
          </p>
        </div>

        <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-200 text-xl text-emerald-700">
          ✓
        </span>
      </div>

    </section>

    <!-- Search and Filters -->
    <section class="rounded-xl border border-slate-100 bg-white p-4">
      <%= form_with url: admin_barangay_concerns_path,
                    method: :get,
                    local: true,
                    class: "space-y-2" do |f| %>

        <!-- Search -->
        <div>
          <%= f.text_field :search,
                value: params[:search],
                placeholder: "⌕  Maghanap gamit ang numero, residente, o lokasyon...",
                class: "w-full rounded-lg border border-transparent bg-[#EEF3FF] px-4 py-3 text-sm text-slate-800 placeholder:text-slate-500 focus:border-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-100" %>
        </div>

        <!-- Filter Options -->
        <div class="grid grid-cols-1 gap-2 md:grid-cols-3">

          <%= f.select :status,
                [
                  ["Lahat ng Kalagayan", ""],
                  ["Naghihintay", "pending"],
                  ["Isinasagawa", "ongoing"],
                  ["Nalutas", "resolved"],
                  ["Hindi maaaksyunan", "unactionable"]
                ],
                { selected: params[:status] },
                class: "w-full rounded-lg border border-transparent bg-[#EEF3FF] px-4 py-3 text-sm text-slate-800 focus:border-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-100" %>

          <%= f.select :category,
                [
                  ["Lahat ng Kategorya", ""]
                ] + BarangayConcern.categories.keys.map { |category| [tagalog_label(category), category] },
                { selected: params[:category] },
                class: "w-full rounded-lg border border-transparent bg-[#EEF3FF] px-4 py-3 text-sm text-slate-800 focus:border-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-100" %>

          <%= f.select :sort_direction,
                [["Pinakabago", "desc"], ["Pinakaluma", "asc"]],
                { selected: params[:sort_direction] || "desc" },
                class: "w-full rounded-lg border border-transparent bg-[#EEF3FF] px-4 py-3 text-sm text-slate-800 focus:border-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-100" %>

        </div>

        <div class="flex items-center justify-between pt-1">
          <p class="text-xs text-slate-500">
            Salain ang mga ulat ng suliranin
          </p>

          <div class="flex items-center gap-3">
            <%= f.submit "Ilapat ang Salain",
                  name: nil,
                  class: "cursor-pointer rounded-lg bg-blue-800 px-4 py-2 text-xs font-semibold text-white hover:bg-blue-900" %>

            <%= link_to "I-clear ang mga Salain",
                  admin_barangay_concerns_path,
                  class: "text-xs font-semibold text-blue-800 hover:underline" %>
          </div>
        </div>

      <% end %>
    </section>

    <!-- Barangay Concerns Table -->
    <section class="overflow-hidden border border-slate-100 bg-white">

      <div class="overflow-x-auto">
        <table class="w-full min-w-[950px] border-collapse text-left text-xs">

          <thead class="bg-white text-[10px] uppercase tracking-wide text-slate-800">
            <tr>
              <th class="px-4 py-5 font-bold">Numero ng Sanggunian</th>
              <th class="px-4 py-5 font-bold">Kategorya</th>
              <th class="px-4 py-5 font-bold">Paglalarawan</th>
              <th class="px-4 py-5 font-bold">Pangalan ng Nag-ulat</th>
              <th class="px-4 py-5 font-bold">Purok / Lokasyon</th>
              <th class="px-4 py-5 font-bold">Petsa ng Pag-uulat</th>
              <th class="px-4 py-5 font-bold">Kalagayan</th>
              <th class="px-4 py-5 text-center font-bold">Mga Aksyon</th>
            </tr>
          </thead>

          <tbody class="divide-y divide-slate-100">

            <% @all_barangay_concerns.each do |concern| %>
              <tr class="odd:bg-[#EEF0FB] even:bg-white">

                <!-- Reference Number -->
                <td class="whitespace-nowrap px-4 py-5">
                  <span class="font-bold text-blue-800">
                    <%= concern.tracking_number.presence || "CR-#{concern.id}" %>
                  </span>
                </td>

                <!-- Category -->
                <td class="whitespace-nowrap px-4 py-5">
                  <span class="font-bold text-slate-800">
                    <%= tagalog_label(concern.category) %>
                  </span>
                </td>

                <!-- Description -->
                <td class="max-w-48 px-4 py-5">
                  <p class="text-slate-800">
                    <%= truncate(concern.reason, length: 75) %>
                  </p>
                </td>

                <!-- Reporter -->
                <td class="whitespace-nowrap px-4 py-5 text-slate-800">
                  <%= concern.resident&.profile&.first_name %>
                  <%= concern.resident&.profile&.last_name %>
                </td>

                <!-- Location -->
                <td class="max-w-36 px-4 py-5 text-slate-600">
                  <p>
                    Purok <%= concern.resident&.address&.purok || "—" %>
                  </p>

                  <p class="mt-1">
                    <%= concern.location_description.presence || "—" %>
                  </p>
                </td>

                <!-- Date Reported -->
                <td class="whitespace-nowrap px-4 py-5 text-slate-600">
                  <p>
                    <%= tagalog_date(concern.created_at) %>
                  </p>

                  <p class="mt-1">
                    <%= concern.created_at.strftime("%I:%M %p") %>
                  </p>
                </td>

                <!-- Status -->
                <td class="whitespace-nowrap px-4 py-5">
                  <span class="inline-flex rounded-full px-3 py-1 text-[10px] font-bold <%= tagalog_status_class(concern.status) %>">
                    <%= tagalog_status(concern.status) %>
                  </span>
                </td>

                <!-- Actions -->
                <td class="px-4 py-5 text-center">
                  <%= link_to "Tingnan",
                        barangay_concern_path(concern),
                        class: "inline-block rounded-lg bg-blue-100 px-4 py-1.5 font-semibold text-slate-800 hover:bg-blue-200" %>
                </td>

              </tr>
            <% end %>

            <% if @all_barangay_concerns.empty? %>
              <tr>
                <td colspan="8" class="px-4 py-12 text-center text-sm text-slate-500">
                  No community concern reports found.
                </td>
              </tr>
            <% end %>

          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <div class="flex flex-col gap-3 bg-white px-4 py-4 sm:flex-row sm:items-center sm:justify-between">

        <p class="text-xs text-slate-600">
          Showing
          <span class="font-semibold text-slate-800">
            <%= @pagy.from || 0 %> to <%= @pagy.to || 0 %>
          </span>
          of
          <span class="font-semibold text-slate-800">
            <%= @pagy.count %>
          </span>
          reports
        </p>

        <div class="flex justify-center gap-2 font-semibold">
          <%== @pagy.series_nav if @pagy.pages > 1 %>
        </div>

      </div>

    </section>

  </main>
</div>
