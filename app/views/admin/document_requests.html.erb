<div class="min-h-screen bg-[#f3f5f9] lg:flex">
  <%= render "sidebar" %>

  <main class="mx-auto min-w-0 max-w-[1600px] flex-1 space-y-5 p-4 sm:p-6 lg:p-8">

    <!-- Header -->
    <header class="rounded-2xl border border-slate-200 bg-white px-6 py-6 shadow-sm sm:px-7">
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        Pamamahala ng mga Kahilingan sa Dokumento
      </h1>

      <p class="mt-2 max-w-3xl text-sm text-slate-600">
        Suriin, iproseso, aprubahan, at pamahalaan ang mga kahilingan sa sertipiko at clearance ng mga rehistradong residente.
      </p>
    </header>

    <!-- Statistics -->
    <section class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">

      <div class="flex min-h-40 items-center justify-between rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
        <div>
        <p class="text-[11px] font-bold uppercase tracking-wide text-blue-800">Lahat ng Kahilingan</p>

        <p class="mt-2 text-4xl font-bold text-blue-900">
          <%= @total_docs %>
        </p>
        </div>
        <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-100"><%= image_tag "all.svg", alt: "", class: "h-7 w-7 object-contain" %></span>
      </div>

      <div class="flex min-h-40 items-center justify-between rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
        <div>
        <p class="text-[11px] font-bold uppercase tracking-wide text-amber-800">Naghihintay</p>

        <p class="mt-2 text-4xl font-bold text-amber-900">
          <%= @pending_docs_count %>
        </p>
        </div>
        <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-orange-100"><%= image_tag "pending.svg", alt: "", class: "h-7 w-7 object-contain" %></span>
      </div>

      <div class="flex min-h-40 items-center justify-between rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
        <div>
        <p class="text-[11px] font-bold uppercase tracking-wide text-blue-700">Pinoproseso</p>

        <p class="mt-2 text-4xl font-bold text-blue-800">
          <%= @processing_docs %>
        </p>
        </div>
        <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-100"><%= image_tag "Icon.svg", alt: "", class: "h-7 w-7 object-contain" %></span>
      </div>

      <div class="flex min-h-40 items-center justify-between rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
        <div>
        <p class="text-[11px] font-bold uppercase tracking-wide text-emerald-700">Handa nang Kunin</p>

        <p class="mt-2 text-4xl font-bold text-emerald-700">
          <%= @ready_pickup_docs %>
        </p>
        </div>
        <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-100"><%= image_tag "resolved.svg", alt: "", class: "h-7 w-7 object-contain" %></span>
      </div>

    </section>

    <!-- Search and Filters -->
    <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
      <%= form_with url: admin_document_requests_path,
                    method: :get,
                    local: true,
                    class: "flex flex-col gap-3 xl:flex-row xl:items-center" do |f| %>

        <div class="min-w-0 flex-1">
          <div class="relative">
            <%= image_tag "search.svg", alt: "", class: "pointer-events-none absolute left-3 top-1/2 h-5 w-5 -translate-y-1/2 object-contain" %>
            <%= f.text_field :search,
                  value: params[:search],
                  placeholder: "Maghanap ng sanggunian, residente, purok, o layunin...",
                  class: "w-full rounded-lg border border-transparent bg-[#EEF3FF] py-3 pl-10 pr-4 text-sm text-slate-800 placeholder:text-slate-500 focus:border-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-100",
                  data: { controller: "auto-submit", action: "input->auto-submit#schedule keydown.enter->auto-submit#submit" } %>
          </div>
        </div>

        <div class="w-full xl:w-44">
          <%= f.select :status,
                [
                  ["Lahat ng Kalagayan", ""],
                  ["Naghihintay", "pending"],
                  ["Pinoproseso", "processing"],
                  ["Handa nang Kunin", "ready_to_pickup"],
                  ["Tinanggihan", "rejected"],
                  ["Nakuha na", "claimed"]
                ],
                { selected: params[:status] },
                onchange: "this.form.requestSubmit()",
                class: "w-full rounded-lg border border-transparent bg-[#EEF3FF] px-3 py-3 text-sm text-slate-800 focus:border-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-100" %>
        </div>

        <div class="w-full xl:w-48">
          <%= f.select :document_type,
                [
                  ["Lahat ng Dokumento", ""],
                ] + DocumentRequest.document_types.keys.map { |document_type| [tagalog_label(document_type), document_type] },
                { selected: params[:document_type] },
                onchange: "this.form.requestSubmit()",
                class: "w-full rounded-lg border border-transparent bg-[#EEF3FF] px-3 py-3 text-sm text-slate-800 focus:border-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-100" %>
        </div>

        <div class="w-full xl:w-40">
          <%= f.select :sort_direction,
                [["Pinakabago", "desc"], ["Pinakaluma", "asc"]],
                { selected: params[:sort_direction] || "desc" },
                onchange: "this.form.requestSubmit()",
                class: "w-full rounded-lg border border-transparent bg-[#EEF3FF] px-3 py-3 text-sm text-slate-800 focus:border-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-100" %>
        </div>

        <div class="flex items-center gap-3">
          <%= link_to admin_document_requests_path,
                class: "inline-flex items-center gap-1.5 whitespace-nowrap text-xs font-semibold text-blue-800 hover:underline" do %>
            <%= image_tag "clearfilters.svg", alt: "", class: "h-4 w-4 object-contain" %>
            I-clear ang mga Salain
          <% end %>
        </div>

      <% end %>
    </section>

    <!-- Talaan ng mga Kahilingan sa Dokumento -->
    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

      <div class="overflow-x-auto">
        <table class="w-full min-w-[1000px] border-collapse text-left text-xs">

          <thead class="bg-[#EEF3FF] text-[10px] uppercase tracking-wide text-slate-600">
            <tr>
              <th class="px-5 py-5 font-bold">Pangalan ng Residente</th>
              <th class="px-4 py-5 font-bold">Numero ng Sanggunian</th>
              <th class="px-4 py-5 font-bold">Uri ng Dokumento at Layunin</th>
              <th class="px-4 py-5 font-bold">Petsa ng Pagpasa</th>
              <th class="px-4 py-5 font-bold">Kalagayan</th>
              <th class="px-5 py-5 text-center font-bold">Mga Aksyon</th>
            </tr>
          </thead>

          <tbody class="divide-y divide-slate-100">

            <% @all_document_requests.each do |request| %>
              <tr class="transition-colors odd:bg-white even:bg-[#f1f5ff] hover:bg-blue-50">

                <!-- Resident -->
                <td class="px-5 py-6">
                  <p class="font-bold text-slate-900">
                    <%= request.resident&.profile&.first_name %>
                    <%= request.resident&.profile&.last_name %>
                  </p>

                  <p class="mt-1 text-slate-600">
                    Purok <%= request.resident&.address&.purok || "—" %>
                  </p>

                  <% if request.resident&.address.present? %>
                    <p class="mt-1 text-slate-500">
                      <%= [
                        request.resident.address.street,
                        request.resident.address.barangay
                      ].compact_blank.join(", ") %>
                    </p>
                  <% end %>
                </td>

                <!-- Reference ID -->
                <td class="px-4 py-6">
                  <span class="font-bold text-blue-800">
                    <%= request.tracking_number.presence || "DOC-#{request.id}" %>
                  </span>
                </td>

                <!-- Document Type and Purpose -->
                <td class="max-w-52 px-4 py-6">
                  <p class="font-bold text-slate-800">
                    <%= tagalog_label(request.document_type) %>
                  </p>

                  <p class="mt-1 text-slate-600">
                    <%= request.purpose.presence || "No purpose provided" %>
                  </p>
                </td>

                <!-- Petsa ng Pagpasa -->
                <td class="whitespace-nowrap px-4 py-6">
                  <p class="font-semibold text-slate-800">
                    <%= tagalog_date(request.created_at) %>
                  </p>

                  <p class="mt-1 text-slate-500">
                    <%= request.created_at.strftime("%I:%M %p") %>
                  </p>
                </td>

                <!-- Status -->
                <td class="px-4 py-6">
                  <span class="inline-flex items-center justify-center rounded-full px-3 py-1.5 text-center text-[10px] font-bold leading-tight <%= tagalog_status_class(request.status) %>">
                    <%= tagalog_status(request.status) %>
                  </span>
                </td>

                <!-- Actions -->
                <td class="px-5 py-6">
                  <div class="flex items-center justify-center gap-1.5">

                    <%= link_to document_request_path(request),
                          data: { turbo_frame: "remote_modal" },
                          class: "inline-flex items-center gap-1.5 whitespace-nowrap rounded-md bg-blue-100 px-2.5 py-1.5 font-semibold text-slate-800 hover:bg-blue-200" do %>
                      <%= image_tag "view.svg", alt: "", class: "h-3.5 w-3.5 object-contain" %>
                      Tingnan
                    <% end %>

                    <% if request.pending? %>

                      <%= link_to document_request_path(request, intent: "approve"),
                            data: { turbo_frame: "remote_modal" },
                            class: "inline-flex items-center gap-1.5 whitespace-nowrap rounded-md bg-emerald-700 px-2.5 py-1.5 font-semibold text-white hover:bg-emerald-800" do %>
                        <%= image_tag "approve.svg", alt: "", class: "h-3.5 w-3.5 object-contain" %>
                        Aprubahan
                      <% end %>

                      <%= link_to document_request_path(request, intent: "reject"),
                            data: { turbo_frame: "remote_modal" },
                            class: "inline-flex items-center gap-1.5 whitespace-nowrap rounded-md bg-red-100 px-2.5 py-1.5 font-semibold text-red-700 hover:bg-red-200" do %>
                        <%= image_tag "x.svg", alt: "", class: "h-3.5 w-3.5 object-contain" %>
                        Tanggihan
                      <% end %>

                    <% elsif request.processing? %>

                      <%= link_to document_request_path(request, intent: "ready"),
                            data: { turbo_frame: "remote_modal" },
                            class: "inline-flex items-center gap-1.5 whitespace-nowrap rounded-md bg-blue-800 px-2.5 py-1.5 font-semibold text-white hover:bg-blue-900" do %>
                        <%= image_tag "check.svg", alt: "", class: "h-3.5 w-3.5 object-contain" %>
                        Markahan bilang Naaprubahan
                      <% end %>

                    <% elsif request.ready_to_pickup? %>

                      <%= link_to document_request_path(request, intent: "release"),
                            data: { turbo_frame: "remote_modal" },
                            class: "whitespace-nowrap rounded-md bg-emerald-700 px-2.5 py-1.5 font-semibold text-white hover:bg-emerald-800" do %>
                        Markahan bilang Nakuha na
                      <% end %>

                    <% end %>

                  </div>
                </td>

              </tr>
            <% end %>

            <% if @all_document_requests.empty? %>
              <tr>
                <td colspan="6" class="px-5 py-12 text-center text-sm text-slate-500">
                  Walang nahanap na kahilingan sa dokumento.
                </td>
              </tr>
            <% end %>

          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <div class="flex flex-col gap-3 border-t border-slate-200 bg-[#f8faff] px-5 py-4 sm:flex-row sm:items-center sm:justify-between">

        <p class="text-xs text-slate-600">
          Ipinapakita ang
          <span class="font-semibold text-slate-900">
            <%= @pagy.from || 0 %>–<%= @pagy.to || 0 %>
          </span>
          sa kabuuang
          <span class="font-semibold text-slate-900">
            <%= @pagy.count %>
          </span>
          kahilingan sa dokumento
        </p>

        <div class="flex justify-center gap-2 font-semibold">
          <%== @pagy.series_nav(querify: ->(q) { %w[search status document_type sort_direction].each { |key| q[key] = params[key] if params[key].present? } }) if @pagy.pages > 1 %>
        </div>

      </div>

    </section>

  </main>
</div>

<!-- Turbo Modal Target -->
<%= turbo_frame_tag "remote_modal" do %>
<% end %>
