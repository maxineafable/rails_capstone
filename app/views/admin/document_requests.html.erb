<div class="flex">
  <%= render "sidebar" %>

    <div class="flex-1 p-8 space-y-8">
      <header class="bg-white rounded-xl p-6 border">
        <h2 class="text-2xl font-bold">Document Requests Management</h2>
        <p class="text-sm max-w-xl">Review, process, approve, and manage official certificate and clearance requests
          from
          registered residents. Pamamahala ng mga Kahilingan sa Dokumento.</p>
      </header>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5">

        <div class="rounded-lg bg-white p-4 shadow-sm">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-xs font-semibold uppercase text-gray-500">Lahat (All)</p>
              <p class="mt-2 text-2xl font-bold text-blue-800">
                <%= @total_docs %>
              </p>
              <p class="mt-1 text-xs text-gray-500">Total active logs</p>
            </div>

            <span class="text-blue-800">▣</span>
          </div>
        </div>

        <div class="rounded-lg bg-white p-4 shadow-sm">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-xs font-semibold uppercase text-amber-700">Pending Review</p>
              <p class="mt-2 text-2xl font-bold text-amber-900">
                <%= @pending_docs_count %>
              </p>
              <p class="mt-1 text-xs text-gray-500">Aksyon kailangan</p>
            </div>

            <span class="text-amber-900">♧</span>
          </div>
        </div>

        <div class="rounded-lg bg-white p-4 shadow-sm">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-xs font-semibold uppercase text-blue-700">In Process</p>
              <p class="mt-2 text-2xl font-bold text-blue-800">
                <%= @processing_docs %>
              </p>
              <p class="mt-1 text-xs text-gray-500">Pinoproseso</p>
            </div>

            <span class="text-blue-800">♟</span>
          </div>
        </div>

        <div class="rounded-lg bg-white p-4 shadow-sm">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-xs font-semibold uppercase text-green-700">Ready for Pickup</p>
              <p class="mt-2 text-2xl font-bold text-green-700">
                <%= @ready_pickup_docs %>
              </p>
              <p class="mt-1 text-xs text-gray-500">Handa nang kunin</p>
            </div>

            <span class="text-green-700">✓</span>
          </div>
        </div>

        <div class="rounded-lg bg-white p-4 shadow-sm">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-xs font-semibold uppercase text-red-600">Tinanggihang</p>
              <p class="mt-2 text-2xl font-bold text-red-600">
                <%= @rejected_docs %>
              </p>
              <p class="mt-1 text-xs text-gray-500">Rejected records</p>
            </div>

            <span class="text-red-600">⊗</span>
          </div>
        </div>

      </div>

      <%= form_with url: admin_document_requests_path, method: :get, local: true,
        class: "mb-6 flex flex-wrap items-end gap-4" do |f| %>

        <div>
          <%= f.label :search, "Search Resident:" , class: "mb-1 block text-sm font-medium text-gray-600" %>

            <%= f.text_field :search, value: params[:search], placeholder: "Name, purok, or purpose..." ,
              class: "w-64 rounded border border-gray-300 px-3 py-2 text-sm focus:border-gray-500 focus:outline-none" %>
        </div>

        <div>
          <%= f.label :sort_direction, "Date Order:" , class: "mb-1 block text-sm font-medium text-gray-600" %>

            <%= f.select :sort_direction, [ ["Newest First", "desc" ], ["Oldest First", "asc" ] ], { selected:
              params[:sort_direction] || "desc" }, {
              class: "rounded border border-gray-300 bg-white px-3 py-2 text-sm focus:border-gray-500 focus:outline-none"
              } %>
        </div>

        <div class="flex items-center gap-2">
          <%= f.submit "Filter Logs" , name: nil,
            class: "rounded bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700" %>

            <%= link_to "Reset" , admin_document_requests_path,
              class: "px-2 py-2 text-sm text-red-600 hover:text-red-700" %>
        </div>

        <% end %>


          <!-- Document Requests -->
          <div class="overflow-x-auto">
            <table class="w-full border-collapse border">

              <thead>
                <tr class="border-b bg-gray-100 text-left">
                  <th class="border p-3">Resident Name</th>
                  <th class="border p-3">Purok</th>
                  <th class="border p-3">Document Type</th>
                  <th class="border p-3">Purpose</th>
                  <th class="border p-3">Status</th>
                  <th class="border p-3">Action</th>
                </tr>
              </thead>

              <tbody>
                <% @all_document_requests.each do |request| %>

                  <tr class="border-b">

                    <td class="border p-3">
                      <%= request.resident.profile.first_name %>
                        <%= request.resident.profile.last_name %>
                    </td>

                    <td class="border p-3">
                      <%= request.resident.address.purok %>
                    </td>

                    <td class="border p-3">
                      <%= request.document_type.humanize %>
                    </td>

                    <td class="border p-3">
                      <%= request.purpose %>
                    </td>

                    <td class="border p-3 font-semibold">
                      <%= request.status.humanize %>
                    </td>

                    
                      <td class="border p-3 space-x-4">
                        <%= link_to "View" , document_request_path(request),
                          data: { turbo_frame: "remote_modal" },
                          class: "text-blue-600 hover:underline" %>
                        
                          <% if request.pending? %>
                            <%= link_to "Approve" , document_request_path(request),
                              data: { turbo_frame: "remote_modal" },
                              class: "text-blue-600 hover:underline" %>

                            <%= link_to "Reject" , document_request_path(request),
                              data: { turbo_frame: "remote_modal" },
                              class: "text-blue-600 hover:underline" %>
                          <% elsif request.processing? %>
                            <%= link_to "Mark as ready" , document_request_path(request),
                              data: { turbo_frame: "remote_modal" },
                              class: "text-blue-600 hover:underline" %>
                          <% elsif request.ready_to_pickup? %>
                            <%= link_to "Release" , document_request_path(request),
                              data: { turbo_frame: "remote_modal" },
                              class: "text-blue-600 hover:underline" %>
                          <% end %>
                      </td>

                  </tr>

                  <% end %>
              </tbody>

            </table>
          </div>

          <br>
          <div style="display: flex; justify-content: center; gap: 10px; font-weight: bold; margin-top: 15px;">
            <%# Pagy 43 Server Side Core Navigation Component Row Link Generator %>
              <%== @pagy.series_nav %>
          </div>

    </div>
</div>

<!-- HTML Target Box Container for remote modal injection loads -->
<%= turbo_frame_tag "remote_modal" do %>
  <!-- This space will dynamically fill up with the show form content when a link is clicked -->
<% end %>