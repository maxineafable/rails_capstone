<div class="flex min-h-screen bg-[#F4F4F8]">
  <%= render "sidebar" %>

  <main class="min-w-0 flex-1 space-y-6 p-6">

    <!-- Header -->
    <header class="rounded-xl border border-slate-100 bg-white px-5 py-5">
      <h1 class="text-2xl font-bold tracking-tight text-slate-900">
        Pamamahala ng mga Kahilingan sa Dokumento
      </h1>

      <p class="mt-1 max-w-2xl text-sm text-slate-600">
        Suriin, iproseso, aprubahan, at pamahalaan ang mga kahilingan sa sertipiko at clearance ng mga rehistradong residente.
        <span class="italic text-slate-500">
          Pamamahala ng mga Kahilingan sa Dokumento.
        </span>
      </p>
    </header>

    <!-- Statistics -->
    <section class="grid grid-cols-1 gap-2 sm:grid-cols-2 xl:grid-cols-5">

      <div class="rounded-xl border border-slate-100 bg-white p-4">
        <p class="text-[10px] font-bold uppercase text-slate-600">Lahat</p>

        <p class="mt-2 text-2xl font-bold text-blue-800">
          <%= @total_docs %>
        </p>

        <p class="mt-1 text-xs font-medium text-slate-500">Kabuuang aktibong tala</p>
      </div>

      <div class="rounded-xl border border-slate-100 bg-white p-4">
        <p class="text-[10px] font-bold uppercase text-amber-800">Naghihintay</p>

        <p class="mt-2 text-2xl font-bold text-amber-950">
          <%= @pending_docs_count %>
        </p>

        <p class="mt-1 text-xs font-medium text-slate-500">Kailangang aksyunan</p>
      </div>

      <div class="rounded-xl border border-slate-100 bg-white p-4">
        <p class="text-[10px] font-bold uppercase text-blue-700">Pinoproseso</p>

        <p class="mt-2 text-2xl font-bold text-blue-800">
          <%= @processing_docs %>
        </p>

        <p class="mt-1 text-xs font-medium text-slate-500">Pinoproseso</p>
      </div>

      <div class="rounded-xl border border-slate-100 bg-white p-4">
        <p class="text-[10px] font-bold uppercase text-emerald-700">Handa nang Kunin</p>

        <p class="mt-2 text-2xl font-bold text-emerald-700">
          <%= @ready_pickup_docs %>
        </p>

        <p class="mt-1 text-xs font-medium text-slate-500">Handa nang kunin</p>
      </div>

      <div class="rounded-xl border border-slate-100 bg-white p-4">
        <p class="text-[10px] font-bold uppercase text-red-600">Tinanggihang</p>

        <p class="mt-2 text-2xl font-bold text-red-600">
          <%= @rejected_docs %>
        </p>

        <p class="mt-1 text-xs font-medium text-slate-500">Mga tinanggihang kahilingan</p>
      </div>

    </section>

    <!-- Search and Filters -->
    <section class="rounded-xl border border-slate-100 bg-white p-4">
      <%= form_with url: admin_document_requests_path,
                    method: :get,
                    local: true,
                    class: "flex flex-col gap-3 lg:flex-row lg:items-center" do |f| %>

        <div class="min-w-0 flex-1">
          <%= f.text_field :search,
                value: params[:search],
                placeholder: "Maghanap ng residente, purok, o layunin...",
                class: "w-full rounded-lg border border-transparent bg-[#EEF3FF] px-4 py-3 text-sm text-slate-800 placeholder:text-slate-500 focus:border-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-100" %>
        </div>

        <div class="w-full lg:w-44">
          <%= f.select :status,
                [
                  ["Lahat ng Kalagayan", ""],
                  ["Naghihintay", "pending"],
                  ["Pinoproseso", "processing"],
                  ["Handa nang Kunin", "ready_to_pickup"],
                  ["Tinanggihan", "rejected"],
                  ["Nakuha na", "claimed"]
                ],
                { selected: params[:status] },
                class: "w-full rounded-lg border border-transparent bg-[#EEF3FF] px-3 py-3 text-sm text-slate-800 focus:border-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-100" %>
        </div>

        <div class="w-full lg:w-48">
          <%= f.select :document_type,
                [
                  ["Lahat ng Dokumento", ""],
                  ["Certificate of Residency", "certificate_of_residency"],
                  ["Certificate of Income", "certificate_of_income"],
                  ["Barangay Clearance", "barangay_clearance"]
                ],
                { selected: params[:document_type] },
                class: "w-full rounded-lg border border-transparent bg-[#EEF3FF] px-3 py-3 text-sm text-slate-800 focus:border-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-100" %>
        </div>

        <div class="w-full lg:w-40">
          <%= f.select :sort_direction,
                [["Pinakabago", "desc"], ["Pinakaluma", "asc"]],
                { selected: params[:sort_direction] || "desc" },
                class: "w-full rounded-lg border border-transparent bg-[#EEF3FF] px-3 py-3 text-sm text-slate-800 focus:border-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-100" %>
        </div>

        <div class="flex items-center gap-3">
          <%= f.submit "Salain",
                name: nil,
                class: "cursor-pointer rounded-lg bg-blue-800 px-4 py-3 text-sm font-semibold text-white hover:bg-blue-900" %>

          <%= link_to "I-clear ang mga Salain",
                admin_document_requests_path,
                class: "whitespace-nowrap text-xs font-semibold text-blue-800 hover:underline" %>
        </div>

      <% end %>
    </section>

    <!-- Talaan ng mga Kahilingan sa Dokumento -->
    <section class="overflow-hidden rounded-xl border border-slate-100 bg-white">

      <div class="overflow-x-auto">
        <table class="w-full min-w-[1000px] border-collapse text-left text-xs">

          <thead class="bg-[#EEF3FF] text-[10px] uppercase tracking-wide text-slate-600">
            <tr>
              <th class="px-5 py-5 font-bold">Pangalan ng Residente</th>
              <th class="px-4 py-5 font-bold">Numero ng Sanggunian</th>
              <th class="px-4 py-5 font-bold">Uri ng Dokumento at Layunin</th>
              <th class="px-4 py-5 font-bold">Petsa ng Pagpasa</th>
              <th class="px-4 py-5 font-bold">Kalagayan</th>
              <th class="px-5 py-5 text-center font-bold">Mga Aksyon</th>
            </tr>
          </thead>

          <tbody class="divide-y divide-slate-100">

            <% @all_document_requests.each do |request| %>
              <tr class="odd:bg-white even:bg-[#EEF3FF]">

                <!-- Resident -->
                <td class="px-5 py-6">
                  <p class="font-bold text-slate-900">
                    <%= request.resident&.profile&.first_name %>
                    <%= request.resident&.profile&.last_name %>
                  </p>

                  <p class="mt-1 text-slate-600">
                    Purok <%= request.resident&.address&.purok || "—" %>
                  </p>

                  <% if request.resident&.address.present? %>
                    <p class="mt-1 text-slate-500">
                      <%= [
                        request.resident.address.street,
                        request.resident.address.barangay
                      ].compact_blank.join(", ") %>
                    </p>
                  <% end %>
                </td>

                <!-- Reference ID -->
                <td class="px-4 py-6">
                  <span class="font-bold text-blue-800">
                    <%= request.tracking_number.presence || "DOC-#{request.id}" %>
                  </span>
                </td>

                <!-- Document Type and Purpose -->
                <td class="max-w-52 px-4 py-6">
                  <p class="font-bold text-slate-800">
                    <%= tagalog_label(request.document_type) %>
                  </p>

                  <p class="mt-1 text-slate-600">
                    <%= request.purpose.presence || "No purpose provided" %>
                  </p>
                </td>

                <!-- Petsa ng Pagpasa -->
                <td class="whitespace-nowrap px-4 py-6">
                  <p class="font-semibold text-slate-800">
                    <%= tagalog_date(request.created_at) %>
                  </p>

                  <p class="mt-1 text-slate-500">
                    <%= request.created_at.strftime("%I:%M %p") %>
                  </p>
                </td>

                <!-- Status -->
                <td class="px-4 py-6">
                  <span class="inline-flex items-center justify-center rounded-full px-3 py-1.5 text-center text-[10px] font-bold leading-tight <%= tagalog_status_class(request.status) %>">
                    <%= tagalog_status(request.status) %>
                  </span>
                </td>

                <!-- Actions -->
                <td class="px-5 py-6">
                  <div class="flex items-center justify-center gap-1.5">

                    <%= link_to document_request_path(request),
                          data: { turbo_frame: "remote_modal" },
                          class: "whitespace-nowrap rounded-md bg-blue-100 px-2.5 py-1.5 font-semibold text-slate-800 hover:bg-blue-200" do %>
                      View
                    <% end %>

                    <% if request.pending? %>

                      <%= link_to document_request_path(request, intent: "approve"),
                            data: { turbo_frame: "remote_modal" },
                            class: "whitespace-nowrap rounded-md bg-emerald-700 px-2.5 py-1.5 font-semibold text-white hover:bg-emerald-800" do %>
                        Approve
                      <% end %>

                      <%= link_to document_request_path(request, intent: "reject"),
                            data: { turbo_frame: "remote_modal" },
                            class: "whitespace-nowrap rounded-md bg-red-100 px-2.5 py-1.5 font-semibold text-red-700 hover:bg-red-200" do %>
                        Reject
                      <% end %>

                    <% elsif request.processing? %>

                      <%= link_to document_request_path(request, intent: "ready"),
                            data: { turbo_frame: "remote_modal" },
                            class: "whitespace-nowrap rounded-md bg-blue-800 px-2.5 py-1.5 font-semibold text-white hover:bg-blue-900" do %>
                        Markahan bilang Handa nang Kunin
                      <% end %>

                    <% elsif request.ready_to_pickup? %>

                      <%= link_to document_request_path(request, intent: "release"),
                            data: { turbo_frame: "remote_modal" },
                            class: "whitespace-nowrap rounded-md bg-emerald-700 px-2.5 py-1.5 font-semibold text-white hover:bg-emerald-800" do %>
                        Release
                      <% end %>

                    <% end %>

                  </div>
                </td>

              </tr>
            <% end %>

            <% if @all_document_requests.empty? %>
              <tr>
                <td colspan="6" class="px-5 py-12 text-center text-sm text-slate-500">
                  Walang nahanap na kahilingan sa dokumento.
                </td>
              </tr>
            <% end %>

          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <div class="flex flex-col gap-3 border-t border-slate-100 bg-[#EEF3FF] px-5 py-4 sm:flex-row sm:items-center sm:justify-between">

        <p class="text-xs text-slate-600">
          Showing
          <span class="font-semibold text-slate-900">
            <%= @pagy.from || 0 %>–<%= @pagy.to || 0 %>
          </span>
          of
          <span class="font-semibold text-slate-900">
            <%= @pagy.count %>
          </span>
          document requests
        </p>

        <div class="flex justify-center gap-2 font-semibold">
          <%== @pagy.series_nav if @pagy.pages > 1 %>
        </div>

      </div>

    </section>

  </main>
</div>

<!-- Turbo Modal Target -->
<%= turbo_frame_tag "remote_modal" do %>
<% end %>
