<% content_for :title, "KaSurbisyo | Barangay Kalikid Sur" %>

<div class="min-h-screen bg-[#f4f5f9] font-sans text-slate-800">
  <header data-controller="mobile-menu" class="fixed inset-x-0 top-0 z-50 m-0 bg-white shadow-[0_3px_10px_rgba(15,23,42,0.12)]">
    <div class="mx-auto flex h-[64px] max-w-[1280px] items-center justify-between gap-3 px-4 sm:h-[74px] sm:px-6 lg:h-[84px] lg:gap-6">
      <a href="#top" class="flex shrink-0 items-center gap-2.5 no-underline">
        <span class="h-9 w-9 shrink-0 rounded-full bg-[#07349e] sm:h-10 sm:w-10 lg:h-12 lg:w-12" aria-hidden="true"></span>
        <span class="flex flex-col text-slate-900">
          <strong class="text-[16px] font-bold leading-tight tracking-[-0.04em] sm:text-[18px] lg:text-[30px]">KaSurbisyo</strong>
          <small class="mt-0.5 text-[8px] text-slate-600 sm:text-[9px] lg:text-[13px]">Digital na Sistema para sa mga Rehistradong Residente</small>
        </span>
      </a>
      <nav class="hidden items-center justify-between gap-1 rounded-lg bg-white p-1 text-[11px] font-medium text-slate-700 sm:flex sm:gap-2 lg:min-w-[720px] lg:px-3 lg:py-2 lg:text-[15px]" aria-label="Pangunahing nabigasyon">
        <a class="rounded-md px-3 py-2 no-underline transition-colors hover:bg-[#07349e] hover:text-white lg:px-4 lg:py-3" href="#services">Mga Serbisyo</a>
        <a class="rounded-md px-3 py-2 no-underline transition-colors hover:bg-[#07349e] hover:text-white lg:px-4 lg:py-3" href="#how-it-works">Paano Ito Gumagana</a>
        <%= link_to "Mag-log in", new_user_session_path, class: "rounded-md px-3 py-2 no-underline transition-colors hover:bg-[#07349e] hover:text-white lg:px-4 lg:py-3" %>
      </nav>
      <button type="button" data-mobile-menu-target="button" data-action="mobile-menu#toggle" aria-expanded="false" aria-controls="landing-mobile-menu" aria-label="Buksan ang menu" class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-[#07349e] hover:bg-blue-50 focus:outline-none focus:ring-2 focus:ring-blue-300 sm:hidden">
        <svg data-mobile-menu-target="icon" class="h-6 w-6 transition-transform duration-200 ease-out" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>

    <nav id="landing-mobile-menu" data-mobile-menu-target="menu" hidden class="pointer-events-none absolute inset-x-0 top-full -translate-y-2 border-t border-slate-100 bg-white px-4 py-3 opacity-0 shadow-lg transition-[opacity,transform] duration-200 ease-out sm:hidden" aria-label="Nabigasyon sa mobile">
      <a data-action="click->mobile-menu#close" class="block rounded-lg px-4 py-3 text-sm font-semibold text-slate-700 no-underline hover:bg-blue-50 hover:text-[#07349e]" href="#services">Mga Serbisyo</a>
      <a data-action="click->mobile-menu#close" class="block rounded-lg px-4 py-3 text-sm font-semibold text-slate-700 no-underline hover:bg-blue-50 hover:text-[#07349e]" href="#how-it-works">Paano Ito Gumagana</a>
      <%= link_to "Mag-log in", new_user_session_path, data: { action: "click->mobile-menu#close" }, class: "block rounded-lg px-4 py-3 text-sm font-semibold text-slate-700 no-underline hover:bg-blue-50 hover:text-[#07349e]" %>
    </nav>
  </header>

  <main id="top" class="pt-[64px] sm:pt-[74px] lg:pt-[84px]">
    <section class="relative -mt-6 flex min-h-[460px] items-center justify-center overflow-hidden bg-[#08265f] px-5 pb-16 pt-10 text-center text-white sm:min-h-[500px] sm:py-16 lg:min-h-0 lg:aspect-[851/315] lg:py-16">
      <%= image_tag "barangayhall.png", alt: "Barangay Kalikid Sur officials", class: "absolute inset-0 h-full w-full object-cover object-center" %>
      <div class="absolute inset-0 bg-gradient-to-b from-[#061a3b]/55 via-[#061a3b]/70 to-[#061a3b]/95"></div>
      <div class="relative z-[1] mx-auto max-w-4xl">
        <h1 class="text-[23px] font-bold leading-[1.08] tracking-[-0.04em] sm:text-[27px] lg:text-[36px]">Lahat ng kailangan mo sa iyong<br class="hidden sm:block"><span class="font-serif font-normal italic"> barangay, nasa iisang lugar.</span></h1>
        <p class="mx-auto mt-5 max-w-2xl text-[14px] leading-relaxed text-white/85 sm:text-base">Humiling ng mga dokumento, mag-ulat ng mga suliranin sa komunidad, at subaybayan ang bawat hakbang online—mabilis at madali.</p>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <%= link_to "Gumawa ng account", new_user_registration_path, class: "rounded-full bg-[#244fc4] px-6 py-3 text-[13px] font-bold text-white no-underline shadow-lg transition hover:bg-blue-700" %>
          <a href="#how-it-works" class="rounded-full bg-white px-6 py-3 text-[13px] font-bold text-slate-800 no-underline shadow-lg transition hover:bg-slate-100">Alamin kung paano ito gumagana</a>
        </div>
      </div>
    </section>

    <section class="relative z-[2] mx-auto -mt-16 max-w-[1180px] px-3 sm:-mt-20 sm:px-5 lg:-mt-24" aria-label="Mga halimbawa ng kahilingan at ulat">
      <div data-controller="coverflow" role="region" aria-roledescription="carousel" aria-label="Mga halimbawa ng kahilingan at ulat. Swipe horizontally to view each example on mobile." class="relative h-[450px] sm:h-[500px] lg:h-[520px]">
        <button type="button" data-coverflow-target="card" data-index="0" data-position="left" data-title="Ulat tungkol sa ilaw sa kalsada" data-action="click->coverflow#select" class="absolute left-1/2 top-1/2 h-[400px] rounded-2xl border border-slate-100 bg-white p-5 text-left shadow-[0_18px_45px_rgba(15,23,42,0.2)] transition-all duration-500 ease-out sm:h-[450px] sm:p-7">
          <div class="flex items-center justify-between gap-2 border-b border-slate-100 pb-3"><span class="text-[11px] font-bold text-slate-700">MAG-ULAT NG SULIRANIN</span><span class="rounded-full bg-emerald-50 px-2 py-1 text-[11px] font-semibold text-emerald-700">Bagong Ulat</span></div>
          <p class="mt-4 text-[11px] text-slate-400">Pumili ng Kategorya</p><div class="mt-2 grid grid-cols-2 gap-2 text-[11px]"><span class="rounded-lg border border-blue-100 bg-blue-50 p-2 text-blue-700">● Mga Ilaw sa Kalsada</span><span class="rounded-lg border border-slate-200 p-2 text-slate-500">● Kanal</span><span class="rounded-lg border border-slate-200 p-2 text-slate-500">● Mga Daan</span><span class="rounded-lg border border-slate-200 p-2 text-slate-500">● Basura</span></div>
          <p class="mt-3 rounded-lg bg-slate-50 p-3 text-[11px] italic leading-relaxed text-slate-500">“Pundidong ilaw sa tapat ng Purok 3 San Fernando Village...”</p>
        </button>

        <button type="button" data-coverflow-target="card" data-index="1" data-position="active" data-title="Kahilingan para sa Barangay Clearance" data-action="click->coverflow#select" class="absolute left-1/2 top-1/2 h-[400px] rounded-2xl border border-slate-100 bg-white p-5 text-left shadow-[0_18px_45px_rgba(15,23,42,0.22)] transition-all duration-500 ease-out sm:h-[450px] sm:p-7">
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-3"><span class="rounded bg-slate-100 px-2.5 py-1 text-[11px] font-bold text-slate-600">ONLINE NA APLIKASYON BC-26</span><span class="rounded-full bg-emerald-100 px-3 py-1 text-[11px] font-bold text-emerald-800">● IN REVIEW / KASALUKUYANG SINUSURI</span></div>
          <div class="py-4"><p class="text-[11px] font-semibold uppercase tracking-wide text-slate-400">Opisyal na numero ng sanggunian</p><p class="mt-1 font-mono text-[13px] font-bold text-slate-700">BKS-DOC-2025-08492</p><h2 class="mt-2 text-[19px] font-bold text-slate-800 lg:text-[30px]">Barangay Clearance</h2><p class="text-[13px] leading-relaxed text-slate-500">Certificate of Good Moral Character at Certificate of Residency</p></div>
          <div class="rounded-xl border border-slate-100 bg-slate-50 p-4"><div class="flex items-center justify-between gap-2 text-[12px] font-semibold text-slate-600"><span>Kalagayan ng Dokumento (Pag-usad ng Kahilingan)</span><span class="text-slate-400">Pagproseso: 2 araw ng trabaho</span></div><ol class="mt-4 grid grid-cols-4 gap-2 text-center text-[11px]"><li class="text-emerald-700"><span class="mx-auto mb-1 flex h-6 w-6 items-center justify-center rounded-full bg-emerald-600 font-bold text-white">✓</span><b>1. Naipasa</b></li><li class="text-[#244fc4]"><span class="mx-auto mb-1 flex h-6 w-6 items-center justify-center rounded-full bg-[#244fc4] font-bold text-white">2</span><b>2. Sinusuri</b></li><li class="text-slate-400"><span class="mx-auto mb-1 flex h-6 w-6 items-center justify-center rounded-full bg-slate-200 font-bold">3</span>3. Naaprubahan</li><li class="text-slate-400"><span class="mx-auto mb-1 flex h-6 w-6 items-center justify-center rounded-full bg-slate-200 font-bold">4</span>4. Handa nang Kunin</li></ol></div>
          <div class="mt-3 flex items-center justify-between rounded-xl border border-blue-100 bg-blue-50/70 p-3 text-[12px]"><div class="flex items-center gap-2"><span class="flex h-7 w-7 items-center justify-center rounded-full bg-blue-200 font-bold text-[#07349e]">JD</span><span><b class="block text-slate-700">Juan M. dela Cruz</b><span class="text-slate-500">Purok 4, Kalikid Sur</span></span></div><span class="font-mono text-slate-400">Oktubre 24, 2026</span></div>
        </button>

        <button type="button" data-coverflow-target="card" data-index="2" data-position="right" data-title="Pagtugon sa ulat" data-action="click->coverflow#select" class="absolute left-1/2 top-1/2 h-[400px] rounded-2xl border border-slate-100 bg-white p-5 text-left shadow-[0_18px_45px_rgba(15,23,42,0.2)] transition-all duration-500 ease-out sm:h-[450px] sm:p-7">
          <div class="flex items-center justify-between gap-2 border-b border-slate-100 pb-3"><span class="text-[11px] font-bold text-slate-700">ULAT NG SULIRANIN</span><span class="rounded-full bg-amber-100 px-2 py-1 text-[11px] font-semibold text-amber-900">Naghihintay</span></div>
          <h3 class="mt-4 text-[12px] font-bold text-slate-700">Mga Ilaw sa Kalsada • Purok 3</h3><p class="mt-1 font-mono text-[11px] text-slate-400">BKS-CR-2025-00341</p><p class="mt-3 rounded-lg bg-slate-50 p-3 text-[11px] leading-relaxed text-slate-600">Nakatakdang suriin ng Lupon / Maintenance Officer sa Huwebes ng umaga.</p><div class="mt-3 flex items-center justify-between border-t border-slate-100 pt-3 text-[11px] text-slate-400"><span>Lokasyon: San Fernando Village</span><b class="rounded bg-blue-50 px-2 py-1 text-blue-700">Itinalaga</b></div>
        </button>
      </div>
    </section>

    <section class="mx-4 mt-[-34px] bg-[#edf3ff] px-5 pb-14 pt-20 sm:mx-6 sm:px-8 lg:mx-8 lg:pb-16 lg:pt-20">
      <div class="mx-auto max-w-[1180px]">
        <div class="text-center"><h2 id="services" class="scroll-mt-[100px] text-[18px] font-bold tracking-tight text-slate-800 sm:text-[20px] lg:text-[30px]">Mga Serbisyong Inaalok</h2><p class="mt-2 text-[14px] text-slate-600">Tingnan ang mga serbisyong hatid ng Barangay Kalikid Sur.</p></div>
        <div class="mt-8 grid gap-5 md:grid-cols-3 lg:gap-8">
          <article class="rounded-xl bg-white p-6 shadow-md">
            <span class="flex h-11 w-11 items-center justify-center rounded-lg bg-blue-100 text-[#07349e]" aria-hidden="true"><svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 3h7l5 5v13H7z"/><path d="M14 3v6h5M10 13h6M10 17h6"/></svg></span>
            <h3 class="mt-5 text-[16px] font-bold text-[#07349e] lg:text-[20px]">Humiling ng mga Dokumento Online</h3><p class="mt-2 text-[13px] leading-relaxed text-slate-600">Humiling ng Barangay Clearance, Certificate of Residency, Certificate of Indigency at iba pang dokumento nang hindi pumipila.</p>
          </article>
          <article class="rounded-xl bg-white p-6 shadow-md">
            <span class="flex h-11 w-11 items-center justify-center rounded-lg bg-emerald-200 text-emerald-800" aria-hidden="true"><svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 14v-4a2 2 0 0 1 2-2h4l6-4v16l-6-4H6a2 2 0 0 1-2-2Z"/><path d="m9 16 2 5M19 9l2-2M19 15l2 2M18 12h4"/></svg></span>
            <h3 class="mt-5 text-[16px] font-bold text-[#07349e] lg:text-[20px]">Mag-ulat ng Suliranin</h3><p class="mt-2 text-[13px] leading-relaxed text-slate-600">Ipaalam sa kawani ng barangay ang mga sirang ilaw sa kalsada, baradong kanal, o kailangang kumpunihin sa daan.</p>
          </article>
          <article class="rounded-xl bg-white p-6 shadow-md">
            <span class="flex h-11 w-11 items-center justify-center rounded-lg bg-blue-100 text-[#244fc4]" aria-hidden="true"><svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v9"/><path d="M7 6a8 8 0 1 0 10 0"/><path d="M12 12 16 8"/></svg></span>
            <h3 class="mt-5 text-[16px] font-bold text-[#07349e] lg:text-[20px]">Subaybayan ang mga Kahilingan at Ulat</h3><p class="mt-2 text-[13px] leading-relaxed text-slate-600">Tingnan ang takbo at mga update sa bawat hakbang ng inyong mga kahilingan at ulat.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="mx-4 my-8 bg-white px-5 py-12 sm:mx-6 sm:px-8 lg:mx-8 lg:my-10 lg:px-14 lg:py-16">
      <div class="mx-auto max-w-[1180px]">
        <div class="text-center"><h2 id="how-it-works" class="scroll-mt-[100px] text-[18px] font-bold tracking-tight sm:text-[20px] lg:text-[30px]">Paano Ito Gumagana</h2><p class="mt-2 text-[14px] text-slate-600">Tatlong Madaling Hakbang para sa Mabilis na Serbisyo</p></div>
        <div class="mt-8 grid gap-5 md:grid-cols-3 lg:gap-8">
          <article class="min-h-[190px] rounded-xl bg-[#edf3ff] p-6 shadow-sm"><span class="flex h-9 w-9 items-center justify-center rounded-full bg-[#07349e] font-bold text-white">1</span><h3 class="mt-4 text-[16px] font-bold text-[#07349e] lg:text-[20px]">Magrehistro</h3><p class="mt-2 text-[13px] leading-relaxed text-slate-600">Gumawa ng account gamit ang inyong email, pangalan, at tirahan.</p></article>
          <article class="min-h-[190px] rounded-xl bg-[#edf3ff] p-6 shadow-sm"><span class="flex h-9 w-9 items-center justify-center rounded-full bg-emerald-700 font-bold text-white">2</span><h3 class="mt-4 text-[16px] font-bold text-[#07349e] lg:text-[20px]">Ipasa</h3><p class="mt-2 text-[13px] leading-relaxed text-slate-600">Punan ang online na form para sa mga dokumento o magpadala ng mga larawan at detalye ng suliranin sa komunidad.</p></article>
          <article class="min-h-[190px] rounded-xl bg-[#edf3ff] p-6 shadow-sm"><span class="flex h-9 w-9 items-center justify-center rounded-full bg-[#244fc4] font-bold text-white">3</span><h3 class="mt-4 text-[16px] font-bold text-[#07349e] lg:text-[20px]">Subaybayan</h3><p class="mt-2 text-[13px] leading-relaxed text-slate-600">Kunin ang tracking number at tingnan kung nalutas na o maaari nang kunin ang dokumento.</p></article>
        </div>
        <div class="mt-7 flex flex-col items-start justify-between gap-4 rounded-xl bg-gradient-to-r from-[#07349e] to-[#244fc4] p-6 text-white shadow-lg sm:flex-row sm:items-center sm:px-8">
          <div><h3 class="font-bold">Handa ka na bang simulan ang iyong transaksyon?</h3><p class="mt-1 text-[13px] text-blue-100">Magrehistro ngayon upang magkaroon ng agarang access sa lahat ng serbisyo ng Barangay San Kalikid Sur.</p></div>
          <%= link_to "Magrehistro Ngayon →", new_user_registration_path, class: "shrink-0 rounded-md bg-white px-5 py-3 text-[13px] font-bold text-[#07349e] no-underline hover:bg-blue-50" %>
        </div>
      </div>
    </section>
  </main>

  <footer class="mx-4 mb-6 overflow-hidden rounded-2xl border border-blue-100 bg-[#edf3ff] sm:mx-6 lg:mx-8">
    <div class="h-1 bg-gradient-to-r from-[#244fc4] via-[#244fc4] to-emerald-600"></div>
    <div class="mx-auto grid max-w-[1320px] gap-4 p-5 sm:grid-cols-2 sm:p-7 lg:grid-cols-3 lg:p-8">
      <section class="rounded-xl bg-white/90 p-5 shadow-sm"><h2 class="text-[13px] font-bold uppercase text-[#07349e]">Proteksyon sa Ilalim ng Batas</h2><p class="mt-2 text-[13px] font-semibold text-slate-700">Republika ng Pilipinas • Republic Act No. 10173 (Batas sa Pagkapribado ng Datos ng 2012)</p><p class="mt-4 border-t border-slate-100 pt-3 text-[13px] leading-relaxed text-slate-600">Pinoprotektahan ang impormasyong ipinasa at ginagamit lamang para sa opisyal na transaksyon sa barangay.</p><p class="mt-4 text-[12px] font-semibold text-emerald-700">● Ligtas na Pagproseso ng mga Transaksyon</p></section>
      <section class="rounded-xl bg-white/90 p-5 shadow-sm"><h2 class="text-[13px] font-bold uppercase text-emerald-700">Maayos na Serbisyo ng Pamahalaan</h2><p class="mt-2 text-[13px] font-semibold text-slate-700">Anti-Red Tape Act (Batas Laban sa Red Tape / RA 11032)</p><p class="mt-3 text-[13px] leading-relaxed text-slate-600">Sinusuportahan ng sistemang ito ang maayos na paghahatid ng serbisyo ng pamahalaan.</p><div class="mt-4 border-t border-slate-100 pt-3"><h3 class="text-[12px] font-bold uppercase text-slate-700">Mga Serbisyo ng Barangay</h3><ul class="mt-2 space-y-1 text-[13px] text-[#244fc4]"><li>› Barangay Clearance</li><li>› Certificate of Residency</li><li>› Certificate of Indigency</li></ul></div></section>
      <section class="rounded-xl bg-white/90 p-5 shadow-sm"><h2 class="text-[13px] font-bold uppercase text-slate-700">● Tulong Pampubliko ng Barangay</h2><dl class="mt-4 space-y-3 text-[13px]"><div><dt class="font-bold uppercase text-slate-400">Tirahan</dt><dd class="mt-0.5 text-slate-700">Barangay Hall, Kalikid Sur, Cabanatuan City, Nueva Ecija</dd></div><div><dt class="font-bold uppercase text-slate-400">Telepono</dt><dd class="mt-0.5 text-slate-700">(044) 940-1234</dd></div><div><dt class="font-bold uppercase text-slate-400">Email</dt><dd class="mt-0.5 text-[#244fc4]">kalikidsur.cabanatuan@gmail.com</dd></div><div><dt class="font-bold uppercase text-slate-400">Oras ng Opisina</dt><dd class="mt-0.5 text-slate-700">Lunes hanggang Biyernes, 8:00 AM – 5:00 PM</dd></div></dl></section>
    </div>
    <div class="mx-5 flex flex-col gap-3 border-t border-blue-100 py-4 text-[12px] text-slate-500 sm:mx-7 sm:flex-row sm:items-center sm:justify-between"><span>© <%= Date.current.year %> Barangay Kalikid Sur Serbisyong Online ng Barangay</span><div class="flex gap-4"><a class="text-slate-500 no-underline hover:text-[#07349e]" href="#top">Patakaran sa Pagkapribado</a><span>·</span><a class="text-slate-500 no-underline hover:text-[#07349e]" href="#top">Mga Tuntunin sa Paggamit</a><span>·</span><a class="text-slate-500 no-underline hover:text-[#07349e]" href="#top">Makipag-ugnayan</a></div></div>
  </footer>
</div>



