<% active_item = local_assigns[:active] %>
<% base_link_classes = "rounded-md px-3 py-2 lg:px-4 lg:py-3 transition-colors hover:bg-[#07349e] hover:text-white" %>
<% active_classes = "font-semibold text-[#07349e]" %>
<% idle_classes = "text-slate-800" %>

<header class="fixed inset-x-0 top-0 z-[1100] m-0 w-full bg-white p-0 shadow-[0_3px_10px_rgba(15,23,42,0.18)]">
  <div class="mx-auto flex min-h-[92px] max-w-[1280px] flex-wrap items-center justify-between gap-3 px-4 py-2 sm:px-6 lg:flex-nowrap lg:gap-6 lg:px-6 lg:py-0">
    <%= link_to dashboard_path, class: "flex shrink-0 items-center gap-2.5 no-underline" do %>
      <span class="h-9 w-9 rounded-full bg-[#07349e] sm:h-10 sm:w-10 lg:h-12 lg:w-12" aria-hidden="true"></span>
      <span class="flex flex-col text-slate-900">
        <strong class="text-[16px] font-bold leading-tight tracking-[-0.04em] sm:text-[18px] lg:text-[30px]">KaSurbisyo</strong>
        <small class="mt-0.5 text-[8px] text-slate-600 sm:text-[9px] lg:text-[13px]">Digital System for Registered Residents</small>
      </span>
    <% end %>

    <nav class="flex w-full flex-wrap items-center justify-center gap-1 rounded-lg bg-white p-1 text-[11px] font-medium sm:gap-2 lg:w-auto lg:min-w-[720px] lg:justify-between lg:px-3 lg:py-2 lg:text-[15px]" aria-label="Main navigation">
      <%= link_to "Home", dashboard_path,
            class: "#{base_link_classes} #{active_item == :home ? active_classes : idle_classes}" %>
      <%= link_to "Requests (Kahilingan)", document_requests_path,
            class: "#{base_link_classes} #{active_item == :requests ? active_classes : idle_classes}" %>
      <%= link_to "Reports (Sumbong)", barangay_concerns_path,
            class: "#{base_link_classes} #{active_item == :reports ? active_classes : idle_classes}" %>
      <%= link_to "Profile", (current_user.profile.present? ? profile_path : new_profile_path),
            class: "#{base_link_classes} #{active_item == :profile ? active_classes : idle_classes}" %>
      <% if current_user.barangay_staff? %>
        <%= link_to "Admin", admin_dashboard_path,
              class: "#{base_link_classes} #{active_item == :admin ? active_classes : idle_classes}" %>
      <% end %>
    </nav>
  </div>
</header>
<div class="h-[92px]" aria-hidden="true"></div>
