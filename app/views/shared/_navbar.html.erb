<div class="flex p-4 items-center justify-between bg-neutral-100">
    <div>
        <%= link_to "Barangay Kalikid Sur", root_path %>
    </div>
    <nav class="flex items-center gap-4">
        <% if user_signed_in? %>
            <span>Logged in as: <%= current_user.email %></span>
            <!--<%= link_to "Dashboard", root_path %>-->
            <% if current_user.profile.present? %>
                <%= link_to "Profile", profile_path %>
            <% end %>
            <% if current_user.barangay_staff? %>
                <%= link_to "Admin", admin_dashboard_path %>
            <% end %>
            <%= link_to "My Concerns", barangay_concerns_path %>
            <%= link_to "Logout", destroy_user_session_path, data: { turbo_method: :delete } %>
        <% else %>
            <%= link_to "Login", new_user_session_path %>
            <%= link_to "Sign Up", new_user_registration_path %>
        <% end %>
    </nav>
</div>
