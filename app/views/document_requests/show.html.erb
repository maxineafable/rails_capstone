<%= turbo_frame_tag "remote_modal" do %>
  <% request = @document_request %>
  <% logs = request.status_logs.order(created_at: :asc).to_a %>
  <% processing_log = logs.find { |log| log.status == DocumentRequest.statuses.fetch("processing") } %>
  <% ready_log = logs.find { |log| log.status == DocumentRequest.statuses.fetch("ready_to_pickup") } %>
  <% claimed_log = logs.find { |log| log.status == DocumentRequest.statuses.fetch("claimed") } %>
  <% latest_remarks = logs.reverse.find { |log| log.staff_remarks.present? } %>
  <% current_step = request.pending? ? 1 : (request.processing? || request.rejected? ? 2 : 3) %>
  <% status_style = tagalog_status_class(request.status) %>
  <% document_icon = {
       "barangay_clearance" => "barangayclearance.svg",
       "certificate_of_indigency" => "certificateofindigency.svg",
       "certificate_of_residency" => "certificateofrecidency.svg"
     }.fetch(request.document_type, "documents.svg") %>
  <% status_message = if request.pending?
       "Natanggap na ang inyong kahilingan at naghihintay ng pagsusuri ng kawani ng barangay."
     elsif request.processing?
       "Kasalukuyang pinoproseso ng kawani ng barangay ang inyong kahilingan."
     elsif request.rejected?
       "Hindi naaprubahan ang inyong kahilingan. Basahin ang tala ng barangay sa ibaba."
     elsif request.ready_to_pickup?
       "Handa nang kunin ang inyong dokumento sa Barangay Hall. Magdala ng valid ID."
     else
       "Nakuha na ang dokumentong ito."
     end %>

  <% header_title = "Mga Detalye ng Kahilingan sa Dokumento" %>
  <% target_status = nil %>
  <% submit_text = "I-update ang Kahilingan" %>
  <% submit_class = "w-full cursor-pointer rounded-lg bg-[#07349e] px-4 py-3 text-sm font-semibold text-white hover:bg-[#0b2e83]" %>
  <% case @intent
     when "approve"
       header_title = "Aprubahan ang Kahilingan (Simulan ang Pagproseso)"
       target_status = "processing"
       submit_text = "Kumpirmahin ang Pag-apruba"
     when "reject"
       header_title = "Tanggihan ang Kahilingan sa Dokumento"
       target_status = "rejected"
       submit_text = "Kumpirmahin ang Pagtanggi"
       submit_class = "w-full cursor-pointer rounded-lg bg-rose-700 px-4 py-3 text-sm font-semibold text-white hover:bg-rose-800"
     when "ready"
       header_title = "Markahan bilang Handa nang Kunin"
       target_status = "ready_to_pickup"
       submit_text = "Markahan bilang Handa nang Kunin"
       submit_class = "w-full cursor-pointer rounded-lg bg-emerald-700 px-4 py-3 text-sm font-semibold text-white hover:bg-emerald-800"
     when "release"
       header_title = "Markahan bilang Nakuha na"
       target_status = "claimed"
       submit_text = "Markahan bilang Nakuha na"
     end %>
  <% show_action_panel = current_user.barangay_staff? && @intent.present? %>

  <div class="fixed inset-0 z-[1200] flex items-center justify-center bg-black/70 p-3 sm:p-6" onclick="if (event.target === this) document.getElementById('remote_modal').innerHTML = ''">
    <section class="relative max-h-[95vh] w-full max-w-[760px] overflow-y-auto rounded-2xl bg-white shadow-2xl" role="dialog" aria-modal="true" aria-labelledby="document-modal-title">
      <div class="sticky top-0 z-10 h-2 bg-gradient-to-r from-[#07349e] to-emerald-700"></div>

      <div class="space-y-5 px-5 py-5 sm:px-8 sm:py-7">
        <header class="flex items-center gap-4">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-blue-100" aria-hidden="true"><%= image_tag document_icon, class: "h-7 w-7 object-contain", alt: "" %></span>
          <div class="min-w-0">
            <p class="text-[10px] font-bold uppercase tracking-wide text-[#07349e]">Kahilingan sa Dokumento</p>
            <h2 id="document-modal-title" class="text-xl font-semibold text-slate-900"><%= tagalog_label(request.document_type) %></h2>
          </div>
        </header>

        <section class="grid gap-3 rounded-xl bg-[#eff3ff] p-4 sm:grid-cols-[1fr_auto] sm:items-center">
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-xs font-semibold text-slate-600">Kalagayan:</span>
            <span class="rounded-full px-3 py-1 text-[11px] font-bold uppercase <%= status_style %>">● <%= tagalog_status(request.status) %></span>
          </div>
          <div class="rounded-lg bg-white px-4 py-2 text-center sm:min-w-[270px]">
            <p class="text-[10px] font-bold uppercase tracking-wide text-slate-600">Numero ng Sanggunian</p>
            <div class="flex items-center justify-center gap-2">
              <span class="font-mono text-base font-bold tracking-wide text-[#07349e]"><%= request.tracking_number %></span>
              <button type="button" onclick="navigator.clipboard.writeText('<%= j request.tracking_number %>').then(() => { this.textContent = 'Nakopya'; })" class="text-[10px] font-semibold text-[#07349e] hover:underline">▢ Kopyahin</button>
            </div>
          </div>
        </section>

        <section class="rounded-xl border border-slate-100 p-4 sm:p-5" aria-label="Pag-usad ng kahilingan">
          <div class="mb-5 flex flex-wrap items-center justify-between gap-2">
            <h3 class="text-sm font-semibold text-slate-900">Pag-usad ng Kahilingan</h3>
            <span class="text-[10px] font-bold uppercase tracking-wide <%= request.ready_to_pickup? || request.claimed? ? 'text-emerald-700' : request.rejected? ? 'text-rose-700' : request.processing? ? 'text-[#07349e]' : 'text-orange-600' %>"><%= request.claimed? ? "Tapos na ang 3 sa 3 hakbang" : "Hakbang #{current_step} sa 3 · #{tagalog_status(request.status)}" %></span>
          </div>
          <div class="relative grid grid-cols-3 gap-1 before:absolute before:left-[16%] before:right-[16%] before:top-4 before:h-1 before:bg-[#dce4ff]">
            <% progress_width = request.claimed? || request.ready_to_pickup? ? "68%" : request.processing? || request.rejected? ? "34%" : "0%" %>
            <span class="absolute left-[16%] top-4 z-0 h-1 rounded-full bg-emerald-700 transition-[width] duration-700 ease-in-out" style="width: <%= progress_width %>" aria-hidden="true"></span>
            <% ["Naipasa", "Pinoproseso", "Handa nang Kunin"].each_with_index do |step_label, index| %>
              <% step_number = index + 1 %>
              <% complete = step_number < current_step || request.ready_to_pickup? || request.claimed? %>
              <% active = step_number == current_step && !request.rejected? %>
              <% circle_style = if request.rejected? && step_number == 2
                   "bg-rose-700 text-white"
                 elsif step_number == 1 || (step_number == 3 && (request.ready_to_pickup? || request.claimed?)) || (step_number == 2 && complete)
                   "bg-emerald-700 text-white"
                 elsif step_number == 2 && request.processing?
                   "bg-[#07349e] text-white"
                 else
                   "bg-[#dce4ff] text-slate-500"
                 end %>
              <div class="relative z-[1] flex flex-col items-center text-center">
                <span class="flex h-8 w-8 items-center justify-center rounded-full <%= circle_style %>">
                  <% if step_number == 2 %>
                    <%= image_tag "pinoproseso.svg", alt: "", class: "h-4 w-4 object-contain #{active || complete ? 'brightness-0 invert' : 'opacity-70'}" %>
                  <% elsif step_number == 3 %>
                    <%= image_tag "Handanangkunin.svg", alt: "", class: "h-4 w-4 object-contain #{active || complete ? 'brightness-0 invert' : 'opacity-70'}" %>
                  <% else %>
                    <%= complete || active ? "✓" : "○" %>
                  <% end %>
                </span>
                <span class="mt-1 text-[11px] font-semibold text-slate-800"><%= step_label %></span>
                <% step_time = index.zero? ? request.created_at : (index == 1 ? processing_log&.created_at : (claimed_log&.created_at || ready_log&.created_at)) %>
                <% if step_time.present? %><time class="text-[10px] font-semibold text-slate-600"><%= tagalog_date(step_time) %></time><% end %>
              </div>
            <% end %>
          </div>
        </section>

        <% if latest_remarks.present? %>
          <section class="rounded-xl <%= request.rejected? ? 'bg-rose-100' : 'bg-emerald-100/80' %> p-4" aria-label="Remarks from barangay">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="text-sm font-semibold text-slate-900">▱ Remarks from Barangay (Mga Tala mula sa Barangay)</h3>
              <time class="rounded bg-white px-2 py-1 text-[10px] font-semibold text-emerald-800"><%= tagalog_datetime(latest_remarks.created_at) %></time>
            </div>
            <p class="mt-2 whitespace-pre-line text-sm leading-relaxed text-slate-800"><%= latest_remarks.staff_remarks %></p>
          </section>
        <% else %>
          <section class="flex items-center gap-3 rounded-xl bg-blue-100 p-4" aria-live="polite">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#2445b8] font-bold text-white">i</span>
            <div class="flex-1 text-left"><p class="text-sm font-medium text-slate-900"><%= status_message %></p></div>
          </section>
        <% end %>

        <% if request.ready_to_pickup? %>
          <section class="rounded-xl bg-emerald-100 p-4">
            <div class="flex items-center gap-2">
              <%= image_tag "check.svg", alt: "", class: "h-5 w-5 shrink-0 object-contain" %>
              <p class="text-sm font-semibold text-emerald-900">Kunin ang dokumento sa Barangay Hall at magdala ng balidong ID.</p>
            </div>
          </section>
        <% end %>

        <section class="grid gap-3 sm:grid-cols-2">
          <div class="rounded-xl bg-[#eff3ff] p-4">
            <p class="text-[10px] font-bold uppercase tracking-wide text-slate-600">Layunin ng Kahilingan</p>
            <p class="mt-1 whitespace-pre-line text-sm font-semibold text-slate-900">“<%= request.purpose %>”</p>
          </div>
          <div class="rounded-xl bg-[#eff3ff] p-4">
            <p class="flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-wide text-slate-600"><%= image_tag "petsa.svg", alt: "", class: "h-3.5 w-3.5 shrink-0 object-contain" %> Petsa at Oras ng Pagsumite</p>
            <p class="mt-1 text-sm font-semibold text-slate-900"><%= tagalog_date(request.created_at) %></p>
            <p class="text-xs text-slate-600"><%= request.created_at.in_time_zone.strftime("%I:%M %p %Z") %></p>
          </div>
        </section>

        <% if request.document_type == "certificate_of_residency" %>
          <section class="rounded-xl bg-[#eff3ff] p-4"><p class="text-[10px] font-bold uppercase tracking-wide text-slate-600">Tagal ng Paninirahan</p><p class="mt-1 text-sm font-semibold"><%= request.years_of_residency %> taon</p></section>
        <% elsif request.document_type == "certificate_of_income" %>
          <section class="grid gap-3 sm:grid-cols-2">
            <div class="rounded-xl bg-[#eff3ff] p-4"><p class="text-[10px] font-bold uppercase tracking-wide text-slate-600">Hanapbuhay</p><p class="mt-1 text-sm font-semibold"><%= request.job %></p></div>
            <div class="rounded-xl bg-[#eff3ff] p-4"><p class="text-[10px] font-bold uppercase tracking-wide text-slate-600">Karaniwang Kita Buwan-buwan</p><p class="mt-1 text-sm font-semibold">₱<%= number_with_precision(request.monthly_income, precision: 2) %></p></div>
          </section>
        <% end %>

        <% if request.resident_remarks.present? %>
          <section>
            <h3 class="mb-2 text-sm font-semibold text-slate-900">▤ Additional Remarks (Karagdagang Tala)</h3>
            <p class="whitespace-pre-line rounded-xl border border-slate-100 p-4 text-sm italic leading-relaxed text-slate-800">“<%= request.resident_remarks %>”</p>
          </section>
        <% end %>

        <% if request.valid_id_image.attached? %>
          <section>
            <div class="mb-2 flex flex-wrap justify-between gap-2">
              <h3 class="flex items-center gap-2 text-sm font-semibold text-slate-900"><%= image_tag "larawan.svg", alt: "", class: "h-4 w-4 shrink-0 object-contain" %> Kalakip na Pagkakakilanlan (Balidong ID)</h3>
              <span class="text-[10px] font-semibold text-slate-600"><%= tagalog_label(request.valid_id_type) %></span>
            </div>
            <%= link_to rails_blob_path(request.valid_id_image, disposition: "inline"), target: "_blank", rel: "noopener", class: "block overflow-hidden rounded-xl bg-slate-100" do %>
              <%= image_tag request.valid_id_image, class: "max-h-[360px] w-full object-contain", alt: "In-upload na #{tagalog_label(request.valid_id_type)} para sa kahilingan sa dokumento" %>
            <% end %>
            <p class="rounded-b-lg bg-[#eff3ff] px-3 py-2 text-[10px] text-slate-600"><%= request.valid_id_image.filename %> · <%= number_to_human_size(request.valid_id_image.byte_size) %></p>
          </section>
        <% end %>

        <% if current_user.barangay_staff? %>
          <section>
            <h3 class="mb-2 text-sm font-semibold text-slate-900">Resident Information</h3>
            <div class="grid gap-3 rounded-xl bg-[#eff3ff] p-4 text-xs text-slate-700 sm:grid-cols-2">
              <p><strong>Residente:</strong> <%= request.resident.profile.first_name %> <%= request.resident.profile.last_name %></p>
              <p><strong>Email:</strong> <%= request.resident.email %></p>
              <p><strong>Address:</strong> <%= [request.resident.address&.purok && "Purok #{request.resident.address.purok}", request.resident.address&.barangay, request.resident.address&.city].compact_blank.join(", ").presence || "Not provided" %></p>
              <p><strong>Naipasa:</strong> <%= tagalog_datetime(request.created_at) %></p>
            </div>
          </section>
        <% end %>

        <% if show_action_panel %>
          <section class="rounded-xl border border-slate-100 p-4 sm:p-5">
            <h3 class="mb-3 text-sm font-semibold text-slate-900">Staff Action</h3>
            <%= form_with model: request, local: true do |f| %>
              <% if request.errors.any? %><div class="mb-3 rounded-lg bg-red-50 p-3 text-xs text-red-700"><%= request.errors.full_messages.to_sentence %></div><% end %>
              <%= f.hidden_field :status, value: target_status %>
              <%= f.label :staff_remarks, @intent == "reject" ? "Reason for Rejection *" : "Staff Remarks / Collection Notes", class: "mb-1 block text-xs font-semibold text-slate-700" %>
              <%= f.text_area :staff_remarks, rows: 4, required: @intent == "reject", placeholder: @intent == "reject" ? "State the specific reason for rejecting this document..." : "Add processing notes or collection details...", class: "w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:border-[#07349e] focus:outline-none focus:ring-2 focus:ring-blue-100" %>
              <%= f.submit submit_text, class: "mt-3 #{submit_class}" %>
            <% end %>
          </section>
        <% end %>
      </div>

      <footer class="sticky bottom-0 flex justify-end bg-[#eff3ff] px-5 py-4 sm:px-8">
        <button type="button" onclick="document.getElementById('remote_modal').innerHTML = ''" class="rounded-xl bg-red-700 px-8 py-3 text-sm font-semibold text-white shadow hover:bg-red-800">Isara</button>
      </footer>
    </section>
  </div>
<% end %>
