<% logs = request.status_logs.order(created_at: :asc).to_a %>
<% processing_log = logs.find { |log| log.status == DocumentRequest.statuses.fetch("processing") } %>
<% approved_log = logs.find { |log| log.status == DocumentRequest.statuses.fetch("approved") } %>
<% ready_log = logs.find { |log| log.status == DocumentRequest.statuses.fetch("ready_to_pickup") } %>
<% claimed_log = logs.find { |log| log.status == DocumentRequest.statuses.fetch("claimed") } %>
<% latest_remarks = logs.reverse.find { |log| log.staff_remarks.present? } %>
<% document_icon = { "barangay_clearance" => "paper.svg", "certificate_of_indigency" => "documents.svg", "certificate_of_residency" => "documents.svg" }.fetch(request.document_type, "documents.svg") %>
<% target_status = { "approve" => "processing", "reject" => "rejected", "mark_approved" => "approved", "ready" => "ready_to_pickup", "release" => "claimed" }[intent] %>
<% submit_text = { "approve" => "Kumpirmahin ang Pag-apruba", "reject" => "Kumpirmahin ang Pagtanggi", "mark_approved" => "Markahan bilang Naaprubahan", "ready" => "Markahan bilang Handa nang Kunin", "release" => "Markahan bilang Nakuha na" }[intent] || "I-update ang Kahilingan" %>
<% submit_class = intent == "reject" ? "bg-red-700 hover:bg-red-800" : (intent == "ready" ? "bg-emerald-700 hover:bg-emerald-800" : "bg-blue-800 hover:bg-blue-900") %>
<% show_action_panel = current_user.barangay_staff? && intent.present? %>
<% status_icon = request.claimed? ? "doublecheck.svg" : (request.ready_to_pickup? ? "ready.svg" : (request.approved? ? "check.svg" : (request.processing? ? "pinoproseso.svg" : "test.svg"))) %>
<% progress_index = request.claimed? ? 4 : (request.ready_to_pickup? ? 3 : (request.approved? ? 2 : (request.processing? ? 1 : 0))) %>
<% active_index = request.processing? ? 1 : (request.approved? ? 2 : (request.ready_to_pickup? ? 3 : nil)) %>
<% progress_width = "#{progress_index * 25}%" %>
<% approved_at = approved_log&.created_at || (ready_log&.created_at if ready_log.present?) %>
<% timeline = [
     ["Naipasa", request.created_at, true, "checkk.svg", nil],
     ["Pinoproseso", processing_log&.created_at, processing_log.present?, "pinoproseso.svg", "processing"],
     ["Naaprubahan", approved_at, approved_log.present? || ready_log.present?, "checkk.svg", "approved"],
     ["Handa nang Kunin", ready_log&.created_at, ready_log.present?, "ready.svg", "ready_to_pickup"],
     ["Nakuha", claimed_log&.created_at, claimed_log.present?, "doublecheck.svg", "claimed"]
   ] %>

<%= turbo_frame_tag "remote_modal" do %>
  <div class="modal-motion-backdrop fixed inset-0 z-[1200] flex items-center justify-center bg-black/70 p-3 sm:p-6" data-controller="modal-motion" data-action="click->modal-motion#backdrop">
    <section class="modal-motion-panel relative flex max-h-[95vh] w-full max-w-[760px] flex-col overflow-hidden rounded-2xl bg-white shadow-2xl" data-modal-motion-target="panel" role="dialog" aria-modal="true" aria-labelledby="document-modal-title">
      <div class="sticky top-0 z-20 h-2 shrink-0 bg-gradient-to-r from-[#07349e] to-emerald-700"></div>
      <header class="flex shrink-0 items-center justify-between gap-3 px-5 py-4 sm:px-8">
        <div>
          <p class="text-[10px] font-semibold uppercase tracking-[0.12em] text-slate-500">Dossier Overview</p>
          <h2 id="document-modal-title" class="sr-only">Mga Detalye ng Kahilingan sa Dokumento</h2>
        </div>
        <button type="button" data-action="click->modal-motion#close" class="rounded-full bg-slate-100 p-2 text-lg leading-none text-slate-600 hover:bg-slate-200" aria-label="Isara">×</button>
      </header>

      <div class="min-h-0 flex-1 space-y-4 overflow-y-auto px-5 pb-5 sm:px-8 sm:pb-7">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <span class="inline-flex items-center gap-2 rounded-full border px-3 py-1.5 text-[10px] font-semibold <%= tagalog_status_class(request.status) %>"><span class="h-2 w-2 rounded-full bg-current"></span><%= tagalog_status(request.status) %></span>
          <span class="text-[10px] font-medium text-slate-400">ID: #<%= request.tracking_number.last(6) %></span>
        </div>

        <section class="flex items-start gap-3" aria-label="Pag-uuri ng dokumento">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-blue-100 bg-blue-50"><%= image_tag document_icon, alt: "", class: "h-6 w-6 object-contain" %></span>
          <div class="min-w-0">
            <p class="text-[10px] font-semibold uppercase tracking-wide text-slate-500">Document Classification</p>
            <h3 class="text-lg font-bold leading-tight tracking-tight text-[#123b91] sm:text-xl"><%= tagalog_label(request.document_type) %></h3>
            <p class="mt-1 text-xs text-slate-600">Opisyal na dokumento ng Barangay Kalikid Sur</p>
          </div>
        </section>

        <section class="rounded-xl border border-blue-100 bg-blue-50/70 p-4" aria-label="Numero ng sanggunian">
          <p class="text-[10px] font-bold uppercase tracking-wide text-slate-500">Reference Number (Opisyal na Numero ng Reperensya)</p>
          <div class="mt-2 flex flex-wrap items-center justify-between gap-2">
            <span class="break-all font-mono text-base font-bold tracking-wide text-[#123b91]"><%= request.tracking_number %></span>
            <button type="button" aria-label="Kopyahin ang numero ng sanggunian" onclick="navigator.clipboard.writeText('<%= j request.tracking_number %>').then(() => { this.textContent = 'Nakopya'; })" class="inline-flex items-center gap-1.5 rounded-lg border border-blue-200 bg-white px-3 py-2 text-xs font-semibold text-[#123b91] hover:bg-blue-100"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"/></svg> Kopyahin</button>
          </div>
        </section>

        <section class="flex items-start gap-3 rounded-xl border border-slate-100 bg-slate-50 p-3.5">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-slate-200 bg-white"><%= image_tag "calendar.svg", alt: "", class: "h-4 w-4" %></span>
          <div><p class="text-[10px] font-bold uppercase tracking-wide text-slate-500">Date Filed / Petsa ng Paghiling</p><p class="text-sm font-semibold text-slate-800"><%= tagalog_datetime(request.created_at) %></p></div>
        </section>

        <section class="flex items-start gap-3 rounded-xl border border-slate-100 bg-slate-50 p-3.5">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-teal-100 bg-white text-teal-700">◎</span>
          <div class="min-w-0"><p class="text-[10px] font-bold uppercase tracking-wide text-slate-500">Stated Purpose / Layunin</p><p class="whitespace-pre-line text-sm font-semibold italic text-[#123b91]">“<%= request.purpose.presence || "Walang nakasaad na layunin" %>”</p></div>
        </section>

        <% if request.document_type == "certificate_of_residency" && request.years_of_residency.present? %>
          <p class="text-xs text-slate-700"><strong>Tagal ng Paninirahan:</strong> <%= request.years_of_residency %> taon</p>
        <% elsif request.document_type == "certificate_of_income" %>
          <p class="text-xs text-slate-700"><strong>Hanapbuhay:</strong> <%= request.job.presence || "Hindi nakatala" %> <span class="mx-1">•</span> <strong>Kita:</strong> <%= request.monthly_income.present? ? number_to_currency(request.monthly_income, unit: "₱") : "Hindi nakatala" %></p>
        <% end %>

        <section class="rounded-xl bg-[#eff3ff] p-4 sm:p-5">
          <h3 class="mb-4 flex items-center gap-2 font-semibold text-slate-900"><%= image_tag "resident.svg", alt: "", class: "h-5 w-5 object-contain" %> Impormasyon ng Residente</h3>
          <p class="text-[10px] font-bold uppercase tracking-wide text-slate-600">Buong Pangalan</p>
          <p class="mt-1 text-base font-semibold text-slate-900"><%= [request.resident&.profile&.first_name, request.resident&.profile&.middle_name, request.resident&.profile&.last_name, request.resident&.profile&.suffix].compact_blank.join(" ").presence || "Hindi nakatala" %></p>
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            <div><p class="text-[10px] font-bold uppercase tracking-wide text-slate-600">Numero ng Telepono</p><p class="mt-1 flex items-center gap-2 text-sm text-slate-800"><%= image_tag "phone.svg", alt: "", class: "h-4 w-4 object-contain" %> Hindi nakatala</p></div>
            <div><p class="text-[10px] font-bold uppercase tracking-wide text-slate-600">Email Address</p><p class="mt-1 flex items-center gap-2 break-all text-sm text-slate-800"><%= image_tag "email.svg", alt: "", class: "h-4 w-4 shrink-0 object-contain" %><%= request.resident&.email || "Hindi nakatala" %></p></div>
          </div>
          <% address = request.resident&.address %>
          <div class="mt-4"><p class="text-[10px] font-bold uppercase tracking-wide text-slate-600">Opisyal na Rehistradong Tirahan</p><p class="mt-1 flex items-start gap-2 text-sm leading-relaxed text-slate-800"><%= image_tag "location.svg", alt: "", class: "mt-0.5 h-4 w-4 shrink-0 object-contain" %><%= [address&.purok && "Purok #{address.purok}", address&.house_number, address&.street, address&.barangay, address&.city, address&.province].compact_blank.join(", ").presence || "Hindi nakatala" %></p></div>
        </section>

        <section class="rounded-xl border border-slate-100 p-4 sm:p-5" aria-label="Document tracking progress">
          <h3 class="text-sm font-bold text-slate-900">Katayuan ng Dokumento (Document Tracking Progress)</h3>
          <p class="mb-5 mt-1 text-xs leading-relaxed text-slate-500">Sinusubaybayan ang kasalukuyang yugto ng inyong pagsusuri sa barangay.</p>
          <div class="space-y-4">
            <% timeline.each_with_index do |(label, occurred_at, _logged, icon, _status_key), index| %>
              <% active = index == active_index %>
              <% reached = (occurred_at.present? && !active) || (request.pending? && index.zero?) || request.claimed? %>
              <% milestone_icon = if reached && index < 4
                   "checkk.svg"
                 elsif active && index == 1
                   "pinoproseso.svg"
                 elsif active && index == 3
                   "ready.svg"
                 elsif index == 4
                   "doublecheck.svg"
                 elsif index == 1
                   "pinoproseso.svg"
                 elsif index == 3
                   "ready.svg"
                 else
                   icon
                 end %>
              <div class="flex gap-3">
                <div class="relative flex w-8 shrink-0 justify-center">
                  <% unless index == timeline.length - 1 %><span class="absolute bottom-[-20px] top-8 w-px <%= reached ? 'bg-emerald-600' : 'bg-slate-200' %>" aria-hidden="true"></span><% end %>
                  <span class="relative z-[1] flex h-8 w-8 items-center justify-center rounded-full <%= active ? 'bg-[#123b91] text-white ring-4 ring-blue-100' : (reached ? 'bg-emerald-700 text-white' : 'bg-slate-100 text-slate-400 ring-1 ring-slate-200') %>"><%= image_tag milestone_icon, alt: "", class: "h-4 w-4 object-contain #{reached || active ? 'brightness-0 invert' : 'milestone-icon-muted'}" %></span>
                </div>
                <div class="min-w-0 flex-1 pb-2">
                  <% if reached %><span class="inline-flex rounded-md border border-emerald-200 bg-emerald-50 px-2 py-1 text-[9px] font-bold uppercase tracking-wide text-emerald-800">Tapos na (Completed)</span><% elsif active %><span class="inline-flex rounded-md bg-blue-100 px-2 py-1 text-[9px] font-bold uppercase tracking-wide text-blue-900">Kasalukuyang Sinusuri</span><% else %><span class="text-[9px] font-bold uppercase tracking-wide text-slate-400">Parating (Upcoming)</span><% end %>
                  <p class="mt-1 text-sm font-semibold text-slate-900"><%= index + 1 %>. <%= label %></p>
                  <% if occurred_at.present? %><time class="block text-xs text-slate-500"><%= tagalog_datetime(occurred_at) %></time><% else %><p class="text-xs text-slate-400"><%= request.rejected? ? "Hindi naisagawa" : "Hindi pa nagsisimula" %></p><% end %>
                </div>
              </div>
            <% end %>
          </div>
        </section>
        <% if request.valid_id_image.attached? %>
          <section>
            <h3 class="mb-3 flex items-center gap-2 font-semibold text-slate-900"><%= image_tag "clip.svg", alt: "", class: "h-5 w-5 object-contain" %> Mga Ipinadalang Suportang Dokumento</h3>
            <div class="flex flex-col gap-4 rounded-xl bg-[#eff3ff] p-4 sm:flex-row sm:items-center">
              <%= image_tag request.valid_id_image, class: "h-20 w-24 shrink-0 rounded-lg bg-white object-cover", alt: "Larawan ng #{tagalog_label(request.valid_id_type)}" %>
              <div class="min-w-0 flex-1">
                <span class="rounded bg-blue-100 px-2 py-1 text-[10px] font-bold uppercase text-blue-900"><%= tagalog_label(request.valid_id_type) %></span>
                <p class="mt-2 truncate text-xs font-semibold text-slate-800"><%= request.valid_id_image.filename %></p>
                <p class="text-xs text-slate-600"><%= number_to_human_size(request.valid_id_image.byte_size) %></p>
              </div>
              <%= link_to rails_blob_path(request.valid_id_image, disposition: "inline"), target: "_blank", rel: "noopener", class: "inline-flex h-10 shrink-0 items-center justify-center gap-2 rounded-xl bg-blue-800 px-4 text-sm font-semibold text-white shadow hover:bg-blue-900" do %>
                <%= image_tag "view.svg", alt: "", class: "h-5 w-5 object-contain brightness-0 invert" %> Tingnan
              <% end %>
            </div>
          </section>
        <% end %>

        <% if latest_remarks.present? %>
          <section class="rounded-xl bg-emerald-100/80 p-4 text-xs text-slate-700"><strong>Tala ng Barangay:</strong> <%= latest_remarks.staff_remarks %></section>
        <% end %>
        <% if show_action_panel %>
          <section class="rounded-xl border border-slate-100 bg-[#eff3ff] p-4 sm:p-5">
            <h3 class="mb-3 font-semibold text-slate-900">Aksyon ng Kawani</h3>
            <%= form_with model: request, local: true do |f| %>
              <% if request.errors.any? %><div class="mb-3 rounded-lg bg-red-50 p-3 text-xs text-red-700"><%= request.errors.full_messages.to_sentence %></div><% end %>
              <%= f.hidden_field :status, value: target_status %>
              <%= f.label :staff_remarks, class: "mb-1 block text-xs font-semibold text-slate-700" do %><%= intent == "reject" ? "Dahilan ng Pagtanggi " : "Tala ng Kawani / Detalye ng Pagkuha " %><% if intent == "reject" %><span class="text-red-600">*</span><% else %><span class="text-slate-500">(Opsyonal)</span><% end %><% end %>
              <%= f.text_area :staff_remarks, rows: 3, required: intent == "reject", class: "w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:border-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-100" %>
              <div class="mt-3">
                <%= f.submit submit_text, class: "cursor-pointer rounded-lg px-5 py-3 text-sm font-semibold text-white #{submit_class}" %>
              </div>
            <% end %>
          </section>
        <% end %>
      </div>

      <footer class="sticky bottom-0 flex shrink-0 flex-col items-stretch justify-between gap-2 bg-[#eff3ff] px-5 py-4 sm:flex-row sm:items-center sm:gap-3 sm:px-8">
        <p class="flex items-center gap-2 text-[9px] font-semibold leading-snug text-slate-600 sm:text-[10px]"><%= image_tag "checkk.svg", alt: "", class: "h-4 w-4 shrink-0 object-contain" %> Para sa pagkuha nang personal, magpakita ng isang balidong ID ng pamahalaan.</p>
        <button type="button" data-action="click->modal-motion#close" class="rounded-xl bg-red-700 px-8 py-3 text-sm font-semibold text-white shadow hover:bg-red-800">Isara</button>
      </footer>
    </section>
  </div>
  <style>
    .milestone-icon-muted {
      filter: brightness(0) saturate(100%) invert(28%) sepia(8%) saturate(581%) hue-rotate(198deg) brightness(94%) contrast(88%);
    }
  </style>
<% end %>
