<div id="cancel-request-modal" class="fixed inset-0 z-[1200] hidden items-center justify-center bg-black/75 px-4 py-6" data-cancel-modal onclick="if (event.target === this) this.classList.add('hidden')" role="presentation">
  <section class="w-full max-w-[520px] rounded-2xl bg-white px-7 py-9 text-center shadow-2xl sm:px-10 sm:py-10" role="alertdialog" aria-modal="true" aria-labelledby="cancel-request-title" aria-describedby="cancel-request-description">
    <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-red-100 text-red-700" aria-hidden="true">
      <svg class="h-9 w-9" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2 1 21h22L12 2Zm1 14h-2V9h2v7Zm0 3h-2v-2h2v2Z"/></svg>
    </div>
    <h2 id="cancel-request-title" class="font-serif text-[27px] font-bold leading-tight text-slate-900 sm:text-[30px]">Kanselahin ang kahilingang ito?</h2>
    <p class="mt-1 font-serif text-base text-slate-600">Ikansela ang kahilingan ito?</p>
    <p id="cancel-request-description" class="mt-5 text-sm font-semibold text-slate-800">Mawawala at hindi mase-save ang impormasyong inilagay ninyo.</p>
    <p class="mt-1 text-xs text-slate-600 sm:text-sm">Mawawala at hindi maitatala ang mga impormasyong nailagay sa form.</p>
    <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
      <button type="button" data-cancel-close class="rounded-lg bg-[#eff3ff] px-4 py-3.5 text-sm font-semibold text-[#07349e] hover:bg-[#e1eaff]">Huwag, Magpatuloy</button>
      <%= link_to "Oo, Kanselahin", select_document_type_path, class: "rounded-lg bg-red-700 px-4 py-3.5 text-sm font-semibold text-white no-underline shadow-md hover:bg-red-800" %>
    </div>
  </section>
</div>

<script>
  (() => {
    const initializeCancelModal = () => {
      const modal = document.querySelector("[data-cancel-modal]");
      if (!modal || modal.dataset.initialized) return;
      modal.dataset.initialized = "true";

      const closeModal = () => {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
      };

      document.querySelectorAll("[data-cancel-open]").forEach((trigger) => {
        trigger.addEventListener("click", () => {
          modal.classList.remove("hidden");
          modal.classList.add("flex");
          modal.querySelector("[data-cancel-close]").focus();
        });
      });

      modal.querySelectorAll("[data-cancel-close]").forEach((button) => button.addEventListener("click", closeModal));
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && !modal.classList.contains("hidden")) closeModal();
      });
    };

    document.addEventListener("turbo:load", initializeCancelModal);
    document.addEventListener("DOMContentLoaded", initializeCancelModal);
    initializeCancelModal();
  })();
</script>
