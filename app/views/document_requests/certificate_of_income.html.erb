<%
  # ---- Map your data here (adjust to your models) -------------------------
  name       = @income_name.to_s
  purok      = @income_address&.purok
  occupation = @document_request.job
  earnings   = @document_request.monthly_income.present? ? number_to_currency(@document_request.monthly_income, unit: "₱") : ""
  purpose    = @document_request.purpose
  issued_on  = @income_issued_on
  day        = issued_on.respond_to?(:day) ? issued_on.day.ordinalize : ""
  month      = issued_on.respond_to?(:strftime) ? issued_on.strftime("%B") : ""
  # ------------------------------------------------------------------------

  # Underlined fill-in. Prints the value, or a blank line of the PDF's width if empty.
  blank = ->(value, width) {
    value.present? ? %(<span class="fill">#{ERB::Util.h(value)}</span>).html_safe :
                     %(<span class="fill empty" style="min-width:#{width}"></span>).html_safe
  }
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Certificate of Income - <%= @income_name %></title>
  <style>
    /* Philippine long bond / folio: 8.5in x 13in */
    @page { size: 8.5in 13in; margin: 0; }

    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body { color: #000; font-family: Verdana, Tahoma, "Segoe UI", sans-serif; background: #e9e9e9; }

    .toolbar { padding: 16px; text-align: center; }
    .toolbar button { border: 0; border-radius: 7px; background: #07349e; color: #fff; cursor: pointer; padding: 11px 18px; font-size: 14px; font-weight: 700; }

    .page {
      position: relative;
      width: 8.5in;
      height: 13in;
      margin: 0 auto 24px;
      background: #fff;
      overflow: hidden;
      page-break-after: avoid;
    }

    /* Blue frame */
    .frame {
      position: absolute;
      top: .35in; left: .35in; right: .35in; bottom: .35in;
      border: 4px solid #4472c4;
    }

    /* Header */
    .header {
      position: absolute;
      top: .95in; left: 0; right: 0;
      display: flex; justify-content: center; align-items: center;
      gap: .35in;
    }
    .header img, .header .seal-placeholder { width: .98in; height: .98in; object-fit: contain; }
    .header .seal-placeholder { border: 1px dashed #999; border-radius: 50%; }
    .republic {
      width: 2.9in; text-align: center;
      font-family: "Times New Roman", Times, serif;
      font-size: 13pt; line-height: 1.2;
    }
    .republic strong { font-weight: 400; display: block; }

    .office {
      position: absolute; top: 2.0in; left: 0; right: 0;
      text-align: center;
      font-family: "Monotype Corsiva", "Lucida Calligraphy", "Palatino Linotype", "URW Chancery L", cursive;
      font-style: italic; font-size: 15pt; color: #4472c4; letter-spacing: .02em;
    }
    .rule {
      position: absolute; top: 2.57in; left: .5in; right: .5in;
      border-top: 1px solid #000;
    }

    /* Title */
    .title {
      position: absolute; top: 3.12in; left: 0; right: 0;
      margin: 0; text-align: center;
      font-family: "Segoe UI", Verdana, Tahoma, sans-serif;
      font-size: 26pt; font-weight: 700; letter-spacing: 0;
    }

    /* Watermark */
    .watermark {
      position: absolute; top: 3.7in; left: 1.2in;
      width: 6.1in; height: 5.7in;
      object-fit: contain; opacity: .22; z-index: 0;
    }

    /* Body copy */
    .body {
      position: absolute; top: 4.1in; left: 1in; right: .98in;
      z-index: 1;
      font-size: 11pt; line-height: 1.38; text-align: justify;
    }
    .body p { margin: 0 0 .13in; }
    .body p.indent { text-indent: .5in; }

    .fill { display: inline-block; border-bottom: 1px solid #000; line-height: 1.15; padding: 0 4px; text-align: center; font-weight: 700; text-indent: 0; }
    .fill.empty { border-bottom: 1px solid #000; height: 1em; }

    /* Signature */
    .sign { position: absolute; top: 7.65in; right: .98in; width: 3.3in; z-index: 1; }
    .certified { text-align: center; font-family: Calibri, Carlito, Verdana, sans-serif; font-size: 11pt; margin: 0 0 .5in 0; text-align: left; }
    .sign .name {
      display: block; text-align: right;
      font-family: "Segoe UI", Verdana, Tahoma, sans-serif;
      font-size: 14pt; font-weight: 700; text-decoration: underline;
    }
    .sign .position { display: block; text-align: center; font-size: 11pt; margin-top: 2px; }

    @media print {
      body { background: #fff; }
      .toolbar { display: none; }
      .page { margin: 0; box-shadow: none; }
      * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    }
  </style>
</head>
<body>
  <div class="toolbar"><button type="button" onclick="window.print()">I-print ang Certificate of Income</button></div>

  <div class="page">
    <div class="frame"></div>

    <div class="header">
      <%= image_tag "residency_certificate/barangay_emblem.png", alt: "Barangay Kalikid Sur seal" %>
      <div class="republic">
        Republic of the Philippines<br>
        Province of Nueva Ecija<br>
        City of Cabanatuan
        <strong>BARANGAY KALIKID SUR</strong>
      </div>
      <%= image_tag "residency_certificate/cabanatuan_seal.png", alt: "City of Cabanatuan seal" %>
    </div>

    <div class="office">Office of the Punong Barangay</div>
    <div class="rule"></div>

    <h1 class="title">CERTIFICATE OF INCOME</h1>

    <%= image_tag "residency_certificate/barangay_watermark.png", class: "watermark", alt: "" %>

    <div class="body">
      <p>To whom it may concern:</p>

      <p class="indent">
        This is to certify that, <%= blank.call(name, "2.6in") %> of legal age and a
        bona fide resident of <%= blank.call(purok, "1.2in") %> Kalikid Sur, Cabanatuan City, Nueva Ecija,
        is a/an <%= blank.call(occupation, "1.9in") %> and earns
        <%= blank.call(earnings, "3.3in") %> every month.
      </p>

      <p class="indent">
        This certification was issued upon the request of above-named person
        for <%= blank.call(purpose, "4.3in") %><strong>.</strong>
      </p>

      <p class="indent">
        Issued this <%= blank.call(day, ".75in") %> day of <%= blank.call(month, "1.9in") %><strong>, <%= issued_on.year %></strong>, at the office of
        the Punong Barangay Kalikid Sur, Cabanatuan City, Nueva Ecija.
      </p>
    </div>

    <div class="sign">
      <p class="certified">Certified by:</p>
      <span class="name">HON. NORMAN V. TACBIANAN</span>
      <span class="position">Punong Barangay</span>
    </div>
  </div>

  <script>
    window.addEventListener("load", () => window.setTimeout(() => window.print(), 250));
  </script>
</body>
</html>
