<div class="space-y-6">
  <div>
    <h2 class="text-2xl font-bold">
      Requesting: <%= @document_type.humanize %>
    </h2>
  </div>

  <div class="space-y-4">
    <h3 class="text-xl font-semibold">Resident Information</h3>

    <div>
      <label class="mb-1 block font-medium">First Name</label>
      <input
        type="text"
        value="<%= @profile.first_name %>"
        readonly
        autocomplete="off"
        class="w-full max-w-[500px] border bg-gray-100 p-2"
      >
    </div>

    <div>
      <label class="mb-1 block font-medium">Middle Name</label>
      <input
        type="text"
        value="<%= @profile.middle_name %>"
        readonly
        autocomplete="off"
        class="w-full max-w-[500px] border bg-gray-100 p-2"
      >
    </div>

    <div>
      <label class="mb-1 block font-medium">Last Name</label>
      <input
        type="text"
        value="<%= @profile.last_name %>"
        readonly
        class="w-full max-w-[500px] border bg-gray-100 p-2"
      >
    </div>

    <div>
      <label class="mb-1 block font-medium">Suffix</label>
      <input
        type="text"
        value="<%= @profile.suffix %>"
        readonly
        autocomplete="off"
        class="w-full max-w-[500px] border bg-gray-100 p-2"
      >
    </div>

    <div>
      <label class="mb-1 block font-medium">Birth Date</label>
      <input
        type="text"
        value="<%= @profile.birth_date.strftime("%B %d, %Y") %>"
        readonly
        autocomplete="off"
        class="w-full max-w-[500px] border bg-gray-100 p-2"
      >
    </div>

    <div>
      <label class="mb-1 block font-medium">Sex</label>
      <input
        type="text"
        value="<%= @profile.sex.humanize %>"
        readonly
        autocomplete="off"
        class="w-full max-w-[500px] border bg-gray-100 p-2"
      >
    </div>

    <div>
      <label class="mb-1 block font-medium">Address</label>
      <input
        type="text"
        value="<%= [@address.house_number, @address.street, @address.purok, @address.barangay, @address.city, @address.province].compact_blank.join(", ") %>"
        readonly
        autocomplete="off"
        class="w-full max-w-[500px] border bg-gray-100 p-2"
      >
    </div>
  </div>

  <%= form_with model: @document_request, url: document_requests_path, local: true do |f| %>
    <%= f.hidden_field :document_type, value: @document_type %>

    <div class="space-y-4">
      <div>
        <%= f.label :purpose, "Purpose of Request", class: "mb-1 block font-medium" %>
        <%= f.text_area :purpose, required: true, class: "w-full max-w-[500px] border p-2" %>
      </div>

      <% if @document_type == "certificate_of_residency" %>
        <div>
          <%= f.label :years_of_residency, "Number of Years in this Barangay", class: "mb-1 block font-medium" %>
          <%= f.number_field :years_of_residency, required: true, class: "border p-2" %>
        </div>
      <% end %>

      <% if @document_type == "certificate_of_income" || @document_type == "certificate_of_low_income" %>
        <div>
          <%= f.label :job, "Current Occupation", class: "mb-1 block font-medium" %>
          <%= f.text_field :job, required: true, class: "w-full max-w-[500px] border p-2" %>
        </div>

        <div>
          <%= f.label :monthly_income, "Average Monthly Income", class: "mb-1 block font-medium" %>
          <%= f.number_field :monthly_income, required: true, class: "border p-2" %>
        </div>
      <% end %>

      <div>
        <%= f.label :resident_remarks, "Additional Remarks (Optional)", class: "mb-1 block font-medium" %>
        <%= f.text_area :resident_remarks, class: "w-full max-w-[500px] border p-2" %>
      </div>
    </div>

    <div class="border-t pt-6">
      <h3 class="mb-4 text-xl font-semibold">Identity Verification</h3>

      <div class="space-y-4">
        <div>
          <%= f.label :valid_id_type, "Select ID Type Provided", class: "mb-1 block font-medium" %>
          <%= f.select :valid_id_type,
              DocumentRequest.valid_id_types.keys.map { |i| [i.humanize, i] },
              { include_blank: true },
              class: "border p-2" %>
        </div>

        <div>
          <%= f.label :valid_id_image, "Upload clear photo of ID", class: "mb-1 block font-medium" %>
          <%= f.file_field :valid_id_image, accept: "image/*", required: true %>
        </div>
      </div>
    </div>

    <%= f.submit "Submit Request",
        class: "cursor-pointer bg-blue-600 px-4 py-2 text-white hover:bg-blue-700" %>
  <% end %>
</div>
