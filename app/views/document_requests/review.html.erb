<div class="min-h-screen bg-[#f5f4f7] font-sans text-slate-900">
  <%= render "shared/navbar", active: :requests %>

  <main class="mx-auto max-w-[1120px] space-y-4 px-4 py-5 sm:px-6 sm:py-6 lg:space-y-6 lg:px-6 lg:py-8">
    <section class="rounded-xl bg-white px-5 py-5 shadow-sm sm:px-7 sm:py-6 lg:px-8 lg:py-8">
      <p class="mb-2 text-[9px] font-bold uppercase tracking-[0.1em] text-emerald-700 lg:text-[13px]">◉ Opisyal na Serbisyong Barangay</p>
      <h1 class="text-[23px] font-bold leading-tight tracking-[-0.04em] text-[#07349e] sm:text-[27px] lg:text-[32px]">Review &amp; Confirm Your Request <span class="font-normal text-slate-600">(Suriin ang Kahilingan)</span></h1>
      <p class="mt-2 max-w-[760px] text-xs leading-relaxed text-slate-600 lg:text-[15px]">Tingnan muna ang mga detalye ng iyong kahilingan. Siguraduhing tama ang lahat bago ito kumpirmahin.</p>
    </section>

    <section class="rounded-xl bg-white px-5 py-4 shadow-sm sm:px-7 lg:px-8" aria-label="Request progress">
      <div class="mx-auto flex max-w-[600px] items-center justify-center gap-3 sm:gap-5">
        <div class="flex items-center gap-2">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-emerald-700 text-sm font-bold text-white">✓</span>
          <span><strong class="block text-xs text-emerald-800 lg:text-[14px]">Step 1: Details</strong><small class="text-[10px] text-slate-600">Mga Detalye ng Kahilingan</small></span>
        </div>
        <div class="h-1 flex-1 bg-[#07349e]"></div>
        <div class="flex items-center gap-2">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-[#dce7ff] text-sm font-semibold text-slate-700">2</span>
          <span><strong class="block text-xs text-slate-800 lg:text-[14px]">Step 2: Review</strong><small class="text-[10px] text-slate-600">Pagsusuri at Pagpapatunay</small></span>
        </div>
      </div>
    </section>

    <% if @document_request.errors.any? %>
      <section class="rounded-xl border border-red-200 bg-red-50 px-5 py-4 text-red-800" role="alert">
        <h2 class="text-sm font-semibold">Please fix the following:</h2>
        <ul class="mt-2 list-disc space-y-1 pl-5 text-xs"><% @document_request.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
      </section>
    <% end %>

    <% document_details = {
      "barangay_clearance" => ["Barangay Clearance", "Para sa trabaho, negosyo, at iba pang opisyal na pangangailangan.", "BRGY-01", "6 buwan"],
      "certificate_of_indigency" => ["Certificate of Indigency", "Katibayan para sa mga nangangailangan ng tulong at benepisyo.", "IND-01", "Ayon sa layunin"],
      "certificate_of_residency" => ["Certificate of Residency", "Pagpapatunay ng iyong tirahan sa barangay.", "RES-01", "6 buwan"],
      "good_moral_character" => ["Certificate of Good Moral Character", "Pagpapatunay ng mabuting asal para sa opisyal na pangangailangan.", "GMC-01", "6 buwan"],
      "certificate_of_income" => ["Certificate of Income", "Pagpapatunay ng kita para sa opisyal na transaksyon.", "INC-01", "Ayon sa layunin"],
      "certificate_of_low_income" => ["Certificate of Low Income", "Katibayan ng mababang kita para sa mga benepisyo.", "LI-01", "Ayon sa layunin"]
    }.fetch(@document_type, [@document_type.humanize, "Opisyal na dokumento ng barangay.", "DOC-01", "Ayon sa layunin"]) %>

    <%= form_with url: document_requests_path, scope: :document_request, method: :post, local: true, data: { turbo: false } do |f| %>
      <%= f.hidden_field :document_type, value: @document_request.document_type %>
      <%= f.hidden_field :purpose, value: @document_request.purpose %>
      <%= f.hidden_field :resident_remarks, value: @document_request.resident_remarks %>
      <%= f.hidden_field :valid_id_type, value: @document_request.valid_id_type %>
      <%= f.hidden_field :years_of_residency, value: @document_request.years_of_residency %>
      <%= f.hidden_field :monthly_income, value: @document_request.monthly_income %>
      <%= f.hidden_field :job, value: @document_request.job %>
      <% if @document_request.valid_id_image.attached? %>
        <%= f.hidden_field :valid_id_image, value: @document_request.valid_id_image.blob.signed_id %>
      <% end %>

      <div class="space-y-4 lg:space-y-5">
        <section class="overflow-hidden rounded-xl bg-white shadow-sm" aria-labelledby="review-document-title">
          <div class="flex items-center justify-between gap-3 bg-[#eff3ff] px-5 py-4 sm:px-6">
            <h2 id="review-document-title" class="text-sm font-semibold text-slate-800 lg:text-[16px]">▤ Document Type <span class="font-normal text-slate-600">(Uri ng Dokumento)</span></h2>
            <button type="button" onclick="history.back()" class="shrink-0 bg-transparent text-[10px] font-semibold text-[#07349e] hover:underline lg:text-[13px]">✎ Edit Details (Baguhin)</button>
          </div>
          <div class="flex items-start gap-4 p-5 sm:px-6 sm:py-6">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-[#dce7ff] text-xl text-[#07349e]" aria-hidden="true">▣</span>
            <div>
              <h3 class="text-lg font-bold text-[#07349e] lg:text-[20px]"><%= document_details[0] %> <span class="rounded-full bg-[#e1eaff] px-2 py-1 align-middle text-[9px] font-semibold text-[#07349e]">Form <%= document_details[2] %></span></h3>
              <p class="mt-1 max-w-[560px] text-xs leading-relaxed text-slate-600 lg:text-[14px]"><%= document_details[1] %></p>
              <p class="mt-2 text-[10px] font-semibold text-slate-600 lg:text-[12px]">Validity: <%= document_details[3] %> <span class="mx-2 text-slate-300">•</span> Form Code: <%= document_details[2] %></p>
              <% if @document_type == "certificate_of_residency" %><p class="mt-1 text-xs text-slate-600">Years of residency: <%= @document_request.years_of_residency %></p><% end %>
              <% if @document_type == "certificate_of_income" %><p class="mt-1 text-xs text-slate-600">Job: <%= @document_request.job %> · Monthly income: ₱<%= @document_request.monthly_income %></p><% end %>
            </div>
          </div>
        </section>

        <section class="rounded-xl bg-white p-5 shadow-sm sm:p-6" aria-labelledby="review-purpose-title">
          <div class="flex items-center justify-between gap-3">
            <h2 id="review-purpose-title" class="text-sm font-semibold text-slate-800 lg:text-[16px]">▤ Purpose of Request <span class="font-normal text-slate-600">(Layunin ng Kahilingan)</span></h2>
            <span class="rounded-full bg-[#e1eaff] px-3 py-1 text-[9px] font-semibold text-[#07349e]">Request Purpose</span>
          </div>
          <div class="mt-4 rounded-lg bg-[#eff3ff] p-4">
            <p class="text-[10px] font-bold uppercase tracking-wide text-slate-500">Isinaad na Layunin:</p>
            <p class="mt-1 whitespace-pre-line text-sm font-semibold text-slate-800">“<%= @document_request.purpose %>”</p>
          </div>
        </section>

        <section class="rounded-xl bg-white p-5 shadow-sm sm:p-6" aria-labelledby="review-id-title">
          <div class="flex items-center justify-between gap-3">
            <h2 id="review-id-title" class="text-sm font-semibold text-slate-800 lg:text-[16px]">▣ Attached Identification &amp; Proof <span class="font-normal text-slate-600">(Kalakip na Dokumento)</span></h2>
            <span class="rounded-full bg-emerald-200 px-3 py-1 text-[9px] font-semibold text-emerald-800">✓ ID Attached</span>
          </div>
          <% if @document_request.valid_id_image.attached? %>
            <div class="mt-4 flex flex-col gap-4 rounded-lg bg-[#eff3ff] p-4 sm:flex-row sm:items-center">
              <%= image_tag @document_request.valid_id_image, class: "h-16 w-24 rounded-md border border-white object-cover", alt: "Uploaded identification document" %>
              <div class="min-w-0 flex-1">
                <p class="truncate text-sm font-semibold text-slate-800"><%= @document_request.valid_id_image.filename %></p>
                <p class="text-xs text-slate-600"><%= @document_request.valid_id_type.humanize %> · <%= number_to_human_size(@document_request.valid_id_image.byte_size) %></p>
                <p class="mt-1 text-[10px] font-semibold text-emerald-700">✓ File attached and ready for submission</p>
              </div>
              <%= link_to "◉ View Full Preview", url_for(@document_request.valid_id_image), target: "_blank", rel: "noopener", class: "rounded-md bg-white px-3 py-2 text-center text-[10px] font-semibold text-[#07349e] no-underline hover:bg-blue-50" %>
            </div>
          <% else %>
            <p class="mt-4 rounded-lg bg-red-50 p-4 text-xs text-red-700">No ID image is attached. Go back and upload a valid ID.</p>
          <% end %>
        </section>

        <% if @document_request.resident_remarks.present? %>
          <section class="rounded-xl bg-white p-5 shadow-sm sm:p-6" aria-labelledby="review-remarks-title">
            <h2 id="review-remarks-title" class="text-sm font-semibold text-slate-800 lg:text-[16px]">☰ Additional Remarks <span class="font-normal text-slate-600">(Karagdagang Paalala o Kahilingan)</span></h2>
            <p class="mt-3 whitespace-pre-line rounded-lg bg-[#eff3ff] p-4 text-sm italic leading-relaxed text-slate-700">“<%= @document_request.resident_remarks %>”</p>
          </section>
        <% end %>

        <section class="rounded-xl bg-white p-5 shadow-sm sm:p-6">
          <label class="flex cursor-pointer items-start gap-3">
            <%= check_box_tag :accepted_declaration, "1", @accepted_declaration || params[:accepted_declaration] == "1", id: "accepted_declaration", required: true, onchange: "document.getElementById('document-request-submit').disabled = !this.checked", class: "mt-1 h-5 w-5 shrink-0 rounded border-slate-300 text-[#07349e] focus:ring-[#07349e]" %>
            <span>
              <span class="block text-sm font-semibold text-slate-800">Panunumpa sa Kawastuhan at Pagsang-ayon (Sworn Declaration)</span>
              <span class="mt-1 block text-xs leading-relaxed text-slate-600">Pinatutunayan ko na ang lahat ng impormasyong ibinigay ko ay totoo, tama, at kumpleto. Nauunawaan ko na ang maling pahayag o pekeng dokumento ay maaaring magdulot ng karagdagang pagsusuri at kaukulang legal na aksyon alinsunod sa batas at Data Privacy Act of 2012 (R.A. 10173).</span>
              <span class="mt-2 block text-[10px] font-semibold text-emerald-700">⛨ Protected by Barangay Resident Privacy Standards</span>
            </span>
          </label>
        </section>

        <div class="space-y-2 pb-4">
          <%= f.submit "Submit Request (Isumite ang Kahilingan) ➤", id: "document-request-submit", disabled: !(@accepted_declaration || params[:accepted_declaration] == "1"), class: "w-full cursor-pointer rounded-lg bg-[#07349e] px-5 py-4 text-center text-xs font-bold text-white shadow-sm transition hover:bg-[#0b2e83] disabled:cursor-not-allowed disabled:bg-slate-300 disabled:text-slate-600 disabled:hover:bg-slate-300 lg:text-[14px]" %>
          <button type="button" onclick="history.back()" class="w-full rounded-lg bg-[#eff3ff] px-5 py-3 text-xs font-semibold text-slate-700 hover:bg-[#e1eaff] lg:text-[13px]">☷ Bumalik sa Step 1 (Edit Details)</button>
          <button type="button" data-cancel-open class="block w-full py-2 text-center text-xs font-semibold text-red-700 hover:underline">ⓧ Kanselahin ang Kahilingan (Cancel)</button>
        </div>
      </div>
    <% end %>
  </main>
  <%= render "cancel_confirmation_modal" %>
</div>
