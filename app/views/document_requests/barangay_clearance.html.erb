<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Barangay Clearance - <%= @clearance_name %></title>
  <style>
    * { box-sizing: border-box; }
    html, body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    body { margin: 0; background: #e7e9ee; color: #000; }
    .toolbar { display: flex; justify-content: center; padding: 16px; font-family: Arial, sans-serif; }
    .toolbar button { border: 0; border-radius: 7px; background: #07349e; color: #fff; cursor: pointer; padding: 11px 18px; font-size: 14px; font-weight: 700; }

    /* Page = 8.5in x 13in (612 x 936 pt). Every coordinate below was measured from the reference PDF. */
    .page { position: relative; width: 8.5in; height: 13in; margin: 0 auto 24px; overflow: hidden; background: #fff; box-shadow: 0 10px 35px #0002; }
    .frame { position: absolute; left: .334in; top: .334in; width: 7.841in; height: 12.341in; border: .042in solid #000; box-shadow: inset 0 0 0 .008in #fff, inset 0 0 0 .016in #000; }

    .t { position: absolute; margin: 0; white-space: pre; line-height: 1; font-kerning: none; font-variant-ligatures: none; text-rendering: geometricPrecision; }
    .t.b, .t b, .v.b { font-weight: 700; }
    .tnr { font-family: "Times New Roman", "Liberation Serif", Times, serif; }
    .cal { font-family: Calibri, Carlito, "Segoe UI", Arial, sans-serif; }
    .cam { font-family: Cambria, Caladea, Georgia, serif; }
    .imp { font-family: Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif; }
    .bod { font-family: "Bodoni MT Black", "Bodoni MT", "Bodoni 72", Didot, "Playfair Display", serif; font-weight: 400; }
    .ele { font-family: Elephant, "Bookman Old Style", Georgia, serif; font-weight: 400; }
    .cal.b { font-weight: 700; }

    /* justified lines (width is set per line so line breaks match the PDF) */
    .j { white-space: normal; text-align: justify; text-align-last: justify; }

    /* blank = a typed-in field drawn like the underscores in the PDF */
    .blank { height: .96em; border-bottom: .06em solid #000; overflow-x: clip; overflow-y: visible; text-align: left; white-space: nowrap; }
    .blank.in { display: inline-block; position: static; margin: 0; overflow: visible; text-align: center; text-align-last: center; vertical-align: baseline; }
    .v { font-size: .86em; }
    .v.b, .j .v { font-size: 1em; }

    .img { position: absolute; object-fit: fill; max-width: none; }
    .watermark { left: .322in; top: 2.53in; width: 7.793in; height: 7.793in; opacity: .145; object-fit: contain; }
    .bar { position: absolute; background: #000; display: block; }
    .box { position: absolute; background: #fff; }
    .dash { --c: #001f60; background:
        linear-gradient(90deg, var(--c) 4pt, transparent 4pt) top left / 5.5pt .5pt repeat-x,
        linear-gradient(90deg, var(--c) 4pt, transparent 4pt) bottom left / 5.5pt .5pt repeat-x,
        linear-gradient(180deg, var(--c) 4pt, transparent 4pt) top left / .5pt 5.5pt repeat-y,
        linear-gradient(180deg, var(--c) 4pt, transparent 4pt) top right / .5pt 5.5pt repeat-y,
        #fff; }
    .dashline { position: absolute; left: .394in; top: 10.345in; width: 7.717in; height: 2.25pt; background: repeating-linear-gradient(90deg, #0033cc 0 4.5pt, transparent 4.5pt 9pt); }

    @page { size: 8.5in 13in; margin: 0; }
    @media print {
      body { background: #fff; }
      .toolbar { display: none; }
      .page { width: 8.5in; height: 13in; margin: 0; box-shadow: none; break-after: avoid; }
    }
    @media screen and (max-width: 850px) {
      body { overflow-x: auto; }
      .page { margin-left: 0; }
    }
  </style>
</head>
