<% purok = current_user.address&.purok %>

<div class="min-h-screen bg-[#f5f4f7] font-sans text-slate-900">
  <%= render "shared/navbar", active: :requests %>

  <main class="mx-auto max-w-[1280px] space-y-4 px-4 py-5 sm:px-6 sm:py-6 lg:space-y-6 lg:px-6 lg:py-8">

    <!-- Page Header -->
    <section class="flex flex-col gap-4 rounded-lg bg-white p-4 shadow-sm sm:flex-row sm:items-center sm:justify-between sm:px-5 sm:py-4 lg:gap-8 lg:px-8 lg:py-7" aria-labelledby="document-select-title">

      <div class="min-w-0">
        <p class="mb-1 text-[8px] font-bold tracking-[0.08em] text-emerald-700 lg:mb-2 lg:text-[13px]">
          ◉ OPISYAL NA SERBISYONG BARANGAY
        </p>

        <h1 id="document-select-title" class="text-[18px] font-bold leading-tight tracking-[-0.04em] text-[#07349e] sm:text-[20px] lg:text-[30px]">
          Request a Barangay Document
          <span class="font-normal text-slate-700">
            (Humiling ng Opisyal na Dokumento)
          </span>
        </h1>

        <p class="mt-1 max-w-[900px] text-[10px] leading-relaxed text-slate-600 lg:mt-2 lg:text-[16px]">
          Mabilis at transparent na paghiling ng mga opisyal na sertipikasyon at clearance alinsunod sa Citizen's Charter.
        </p>
      </div>

      <div class="flex shrink-0 items-center gap-2 rounded-md bg-[#eff3ff] px-3 py-2.5 sm:min-w-[150px] lg:gap-3 lg:px-5 lg:py-4">
        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-[#244fbd] text-white lg:h-11 lg:w-11" aria-hidden="true">
          <svg class="h-4 w-4 lg:h-5 lg:w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
            <path d="M7 3.5h7l4.5 4.5v12.5H7z"/>
            <path d="M14 3.5V8h4.5M10 12h5m-5 3h5"/>
          </svg>
        </span>

        <span class="flex flex-col">
          <small class="text-[7px] font-semibold uppercase tracking-wide text-slate-600 lg:text-[13px]">
            Resident Record
          </small>

          <strong class="text-[9px] font-semibold text-slate-900 lg:text-[15px]">
            <%= purok.present? ? "Purok #{purok} · Kalikid Sur" : "Kalikid Sur Resident" %>
          </strong>
        </span>
      </div>
    </section>

    <!-- Available Documents -->
    <section class="space-y-3.5 lg:space-y-5" aria-label="Available documents">

      <%= link_to new_type_document_requests_path(document_type: "barangay_clearance"), class: "group flex min-h-[106px] items-center justify-between gap-4 rounded-lg border-l-4 border-[#07349e] bg-white px-5 py-5 shadow-sm no-underline transition hover:-translate-y-0.5 hover:shadow-md sm:px-6 sm:py-6 lg:min-h-[140px] lg:gap-6 lg:border-l-[6px] lg:px-8 lg:py-8" do %>
        <span>
          <strong class="block text-[22px] font-medium leading-tight tracking-[-0.03em] text-[#07349e] sm:text-[25px] lg:text-[30px]">
            Barangay Clearance
          </strong>

          <span class="mt-1 block text-[11px] leading-relaxed text-slate-700 sm:text-xs lg:mt-2 lg:text-[16px]">
            Para sa trabaho, negosyo, at iba pang opisyal na pangangailangan.
          </span>
        </span>

        <svg class="h-6 w-6 shrink-0 text-[#07349e] transition-transform group-hover:translate-x-1 lg:h-7 lg:w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M3 12h17m-7-7 7 7-7 7"/>
        </svg>
      <% end %>

      <%= link_to new_type_document_requests_path(document_type: "certificate_of_indigency"), class: "group flex min-h-[106px] items-center justify-between gap-4 rounded-lg border-l-4 border-[#07349e] bg-white px-5 py-5 shadow-sm no-underline transition hover:-translate-y-0.5 hover:shadow-md sm:px-6 sm:py-6 lg:min-h-[140px] lg:gap-6 lg:border-l-[6px] lg:px-8 lg:py-8" do %>
        <span>
          <strong class="block text-[22px] font-medium leading-tight tracking-[-0.03em] text-[#07349e] sm:text-[25px] lg:text-[30px]">
            Certificate of Indigency
          </strong>

          <span class="mt-1 block text-[11px] leading-relaxed text-slate-700 sm:text-xs lg:mt-2 lg:text-[16px]">
            Para sa iba’t ibang uri ng tulong para sa mga nangangailangan.
          </span>
        </span>

        <svg class="h-6 w-6 shrink-0 text-[#07349e] transition-transform group-hover:translate-x-1 lg:h-7 lg:w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M3 12h17m-7-7 7 7-7 7"/>
        </svg>
      <% end %>

      <%= link_to new_type_document_requests_path(document_type: "certificate_of_residency"), class: "group flex min-h-[106px] items-center justify-between gap-4 rounded-lg border-l-4 border-[#07349e] bg-white px-5 py-5 shadow-sm no-underline transition hover:-translate-y-0.5 hover:shadow-md sm:px-6 sm:py-6 lg:min-h-[140px] lg:gap-6 lg:border-l-[6px] lg:px-8 lg:py-8" do %>
        <span>
          <strong class="block text-[22px] font-medium leading-tight tracking-[-0.03em] text-[#07349e] sm:text-[25px] lg:text-[30px]">
            Certificate of Residency
          </strong>

          <span class="mt-1 block text-[11px] leading-relaxed text-slate-700 sm:text-xs lg:mt-2 lg:text-[16px]">
            Para sa pagpapatunay ng iyong tirahan at iba pang opisyal na pangangailangan.
          </span>
        </span>

        <svg class="h-6 w-6 shrink-0 text-[#07349e] transition-transform group-hover:translate-x-1 lg:h-7 lg:w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M3 12h17m-7-7 7 7-7 7"/>
        </svg>
      <% end %>

      <%= link_to new_type_document_requests_path(document_type: "good_moral_character"), class: "group flex min-h-[106px] items-center justify-between gap-4 rounded-lg border-l-4 border-[#07349e] bg-white px-5 py-5 shadow-sm no-underline transition hover:-translate-y-0.5 hover:shadow-md sm:px-6 sm:py-6 lg:min-h-[140px] lg:gap-6 lg:border-l-[6px] lg:px-8 lg:py-8" do %>
        <span>
          <strong class="block text-[22px] font-medium leading-tight tracking-[-0.03em] text-[#07349e] sm:text-[25px] lg:text-[30px]">
            Certificate of Good Moral Character
          </strong>

          <span class="mt-1 block text-[11px] leading-relaxed text-slate-700 sm:text-xs lg:mt-2 lg:text-[16px]">
            Para sa mga nangangailangan ng Certificate ng mabuting asal.
          </span>
        </span>

        <svg class="h-6 w-6 shrink-0 text-[#07349e] transition-transform group-hover:translate-x-1 lg:h-7 lg:w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M3 12h17m-7-7 7 7-7 7"/>
        </svg>
      <% end %>

      <%= link_to new_type_document_requests_path(document_type: "certificate_of_income"), class: "group flex min-h-[106px] items-center justify-between gap-4 rounded-lg border-l-4 border-[#07349e] bg-white px-5 py-5 shadow-sm no-underline transition hover:-translate-y-0.5 hover:shadow-md sm:px-6 sm:py-6 lg:min-h-[140px] lg:gap-6 lg:border-l-[6px] lg:px-8 lg:py-8" do %>
        <span>
          <strong class="block text-[22px] font-medium leading-tight tracking-[-0.03em] text-[#07349e] sm:text-[25px] lg:text-[30px]">
            Certificate of Income
          </strong>

          <span class="mt-1 block text-[11px] leading-relaxed text-slate-700 sm:text-xs lg:mt-2 lg:text-[16px]">
            Para sa pagpapatunay ng kita para sa iba’t ibang opisyal na transaksyon.
          </span>
        </span>

        <svg class="h-6 w-6 shrink-0 text-[#07349e] transition-transform group-hover:translate-x-1 lg:h-7 lg:w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M3 12h17m-7-7 7 7-7 7"/>
        </svg>
      <% end %>

      <%= link_to new_type_document_requests_path(document_type: "certificate_of_low_income"), class: "group flex min-h-[106px] items-center justify-between gap-4 rounded-lg border-l-4 border-[#07349e] bg-white px-5 py-5 shadow-sm no-underline transition hover:-translate-y-0.5 hover:shadow-md sm:px-6 sm:py-6 lg:min-h-[140px] lg:gap-6 lg:border-l-[6px] lg:px-8 lg:py-8" do %>
        <span>
          <strong class="block text-[22px] font-medium leading-tight tracking-[-0.03em] text-[#07349e] sm:text-[25px] lg:text-[30px]">
            Certificate of Low Income
          </strong>

          <span class="mt-1 block text-[11px] leading-relaxed text-slate-700 sm:text-xs lg:mt-2 lg:text-[16px]">
            Para sa mga benepisyong nangangailangan ng patunay na mababang kita.
          </span>
        </span>

        <svg class="h-6 w-6 shrink-0 text-[#07349e] transition-transform group-hover:translate-x-1 lg:h-7 lg:w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M3 12h17m-7-7 7 7-7 7"/>
        </svg>
      <% end %>

    </section>

    <div class="pb-2 pt-1 text-center text-[10px] text-slate-500 lg:pt-3 lg:text-[13px]">
      <%= link_to "← Back to Dashboard", root_path, class: "font-medium text-[#07349e] underline" %>
    </div>

  </main>
</div>
