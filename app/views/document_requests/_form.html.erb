<%= form_with model: document_request, local: true do |f| %>
  <div>
    <%= f.label :document_type %>
    <%= f.select :document_type, DocumentRequest.document_types.keys.map { |d| [tagalog_label(d), d] } %>
  </div>

  <%# Dynamic Input Placeholders (Toggle these via vanilla JS depending on type) %>
  <div>
    <%= f.label :years_of_residency %>
    <%= f.number_field :years_of_residency %>
  </div>

  <div>
    <%= f.label :purpose %>
    <%= f.text_area :purpose, required: true %>
  </div>

  <br><hr><br>
  <h3>Mga Detalye ng Pagpapatunay</h3>

  <div>
    <%= f.label :valid_id_type, "Uri ng Ipinakitang ID" %>
    <%= f.select :valid_id_type, DocumentRequest.valid_id_types.keys.map { |i| [tagalog_label(i), i] }, { include_blank: "Pumili ng uri ng ID" }, { required: true } %>
  </div>

  <br>

  <div>
    <%= f.label :valid_id_image, "Mag-upload ng Malinaw na Larawan ng ID" %>
    <%= f.file_field :valid_id_image, accept: 'image/*', required: true %>
  </div>

  <br>

  <div>
    <%= f.submit "Ipasa Kahilingan" %>
  </div>
<% end %>
