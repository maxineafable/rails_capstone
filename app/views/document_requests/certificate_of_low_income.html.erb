<%
  # ---- Map your data here (adjust to your models) -------------------------
  name       = @low_income_name.to_s
  address    = @low_income_address_line.to_s   # purok, house number, and subdivision only
  job        = @document_request.respond_to?(:job) ? @document_request.job.to_s : ""
  income     = if @document_request.respond_to?(:monthly_income) && @document_request.monthly_income.present?
                 number_to_currency(@document_request.monthly_income, unit: "₱")
               else
                 ""
               end
  requester  = (@low_income_requester.presence || name).to_s                   # "upon the request of ____"
  issued_on  = @low_income_issued_on
  day        = issued_on.respond_to?(:day) ? issued_on.day.ordinalize : ""
  month      = issued_on.respond_to?(:strftime) ? issued_on.strftime("%B") : ""
  year       = issued_on.respond_to?(:year) ? issued_on.year : 2026
  # ------------------------------------------------------------------------

  # Underlined fill-in: prints the value, or an empty line of the PDF's width.
  blank = ->(value, width) {
    value.present? ? %(<span class="fill">#{ERB::Util.h(value)}</span>).html_safe :
                     %(<span class="fill empty" style="min-width:#{width}"></span>).html_safe
  }
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Certificate of Low Income - <%= @low_income_name %></title>
  <style>
    /* Philippine long bond / folio: 8.5in x 13in */
    @page { size: 8.5in 13in; margin: 0; }
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body { color: #000; font-family: Verdana, Tahoma, "Segoe UI", sans-serif; background: #e9e9e9; }

    .toolbar { padding: 16px; text-align: center; font-family: Arial, sans-serif; }
    .toolbar button { border: 0; border-radius: 7px; background: #07349e; color: #fff; cursor: pointer; padding: 11px 18px; font-size: 14px; font-weight: 700; }

    .page { position: relative; width: 8.5in; height: 13in; margin: 0 auto 24px; background: #fff; overflow: hidden; }

    /* Blue frame */
    .frame { position: absolute; top: .35in; left: .35in; right: .35in; bottom: .35in; border: 4px solid #4472c4; }

    /* Header */
    .header { position: absolute; top: .95in; left: 0; right: 0; display: flex; justify-content: center; align-items: center; gap: .35in; }
    .header img { width: .98in; height: .98in; object-fit: contain; }
    .republic { width: 2.9in; text-align: center; font-family: "Times New Roman", Times, serif; font-size: 13pt; line-height: 1.2; }
    .republic strong { font-weight: 400; display: block; }

    .office { position: absolute; top: 2.0in; left: 0; right: 0; text-align: center;
              font-family: "Monotype Corsiva", "Lucida Calligraphy", "Palatino Linotype", "URW Chancery L", cursive;
              font-style: italic; font-size: 15pt; color: #4472c4; letter-spacing: .02em; }
    .rule { position: absolute; top: 2.57in; left: .5in; right: .5in; border-top: 1px solid #000; }

    /* Title */
    .title { position: absolute; top: 2.68in; left: 0; right: 0; margin: 0; text-align: center; line-height: .4in;
             font-family: "Segoe UI", Calibri, Verdana, Tahoma, sans-serif; font-size: 26pt; font-weight: 700; }

    /* Watermark */
    .watermark { position: absolute; top: 3.6in; left: 1.3in; width: 5.9in; height: 5.9in; object-fit: contain; opacity: .22; z-index: 0; }

    /* Body copy: 11pt on a ~.275in line pitch, like the PDF */
    .body { position: absolute; top: 3.49in; left: 1in; right: .98in; z-index: 1; font-size: 11pt; line-height: .275in; text-align: justify; }
    .body p { margin: 0 0 .24in; }
    .body p.indent { text-indent: .5in; }
    .body p.p1 { margin-bottom: .10in; }
    .body p.p3 { margin-bottom: .23in; }

    .fill { display: inline-block; border-bottom: 1px solid #000; line-height: 1.1; padding: 0 4px; text-align: center; font-weight: 700; text-indent: 0; }
    .fill.empty { height: 1em; }

    /* Signature */
    .certified { position: absolute; top: 7.55in; left: 4.51in; z-index: 1; font-family: Calibri, Carlito, Verdana, sans-serif; font-size: 11pt; line-height: .275in; }
    .signame { position: absolute; top: 8.35in; left: 4.51in; width: 2.86in; z-index: 1; text-align: right; white-space: nowrap;
               font-family: "Segoe UI", Verdana, Tahoma, sans-serif; font-size: 14pt; font-weight: 700; text-decoration: underline; line-height: .2in; }
    .sigpos { position: absolute; top: 8.62in; left: 4.51in; width: 2.86in; z-index: 1; text-align: center; font-size: 11pt; line-height: .2in; }

    @media print {
      body { background: #fff; }
      .toolbar { display: none; }
      .page { margin: 0; }
      * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    }
  </style>
</head>
<body>
  <div class="toolbar"><button type="button" onclick="window.print()">I-print ang Certificate of Low Income</button></div>

  <main class="page" aria-label="Certification of Low Income">
    <div class="frame"></div>

    <div class="header">
      <%= image_tag "residency_certificate/barangay_emblem.png", alt: "Barangay Kalikid Sur seal" %>
      <div class="republic">
        Republic of the Philippines<br>
        Province of Nueva Ecija<br>
        City of Cabanatuan
        <strong>BARANGAY KALIKID SUR</strong>
      </div>
      <%= image_tag "residency_certificate/cabanatuan_seal.png", alt: "City of Cabanatuan seal" %>
    </div>

    <div class="office">Office of the Punong Barangay</div>
    <div class="rule"></div>

    <h1 class="title">CERTIFICATION OF LOW INCOME</h1>

    <%= image_tag "residency_certificate/barangay_emblem.png", alt: "", class: "watermark" %>

    <div class="body">
      <p>To Whom It May Concern:</p>

      <p class="indent p1">
        This is to certify that <%= blank.call(name, "2.7in") %> of legal age, and
        a resident of <%= blank.call(address, "1.55in") %> Kalikid Sur, Cabanatuan City, Nueva Ecija, is
        belong to an indigent family.
      </p>

      <p class="indent">
        This further certifies that the above-name mentioned is currently
        working as <%= blank.call(job, "1.65in") %> with a monthly income of <%= blank.call(income, "1.55in") %>.
      </p>

      <p class="indent p3">
        This certification is issued upon the request of <%= blank.call(requester, "1.85in") %>
        for whatever legal purposes it may serve.
      </p>

      <p class="indent">
        Issued this <%= blank.call(day, ".7in") %> day of <%= blank.call(month, "1.75in") %><strong>, <%= year %></strong> at the office of
        the Punong Barangay, Kalikid Sur, Cabanatuan City, Nueva Ecija.
      </p>
    </div>

    <div class="certified">Certified by:</div>
    <div class="signame">HON. NORMAN V. TACBIANAN</div>
    <div class="sigpos">Punong Barangay</div>
  </main>

  <script>
    window.addEventListener("load", () => window.setTimeout(() => window.print(), 250));
  </script>
</body>
</html>
