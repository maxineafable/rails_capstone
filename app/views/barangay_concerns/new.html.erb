<div class="min-h-screen bg-[#f5f4f7] font-sans text-slate-900">
  <%= render "shared/navbar", active: :reports %>

  <div class="mx-auto max-w-[1280px] space-y-4 px-4 py-5 sm:px-6 sm:py-6 lg:space-y-6 lg:px-6 lg:py-8">
    <section class="relative overflow-hidden rounded-lg bg-white px-5 py-5 shadow-sm sm:px-7 sm:py-6 lg:px-9 lg:py-8" aria-labelledby="concern-title">
      <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-[#07349e] via-[#2457c5] to-emerald-700"></div>
      <h1 id="concern-title" class="text-[20px] font-bold tracking-[-0.04em] text-[#07349e] sm:text-[22px] lg:text-[30px]">Report a Community Concern</h1>
      <p class="mt-1 text-[10px] font-medium text-emerald-700 lg:text-[13px]">Mag-ulat ng Suliranin o Sumbong sa Barangay Kalikid Sur</p>
      <p class="mt-2 max-w-[900px] text-[10px] leading-relaxed text-slate-600 lg:mt-3 lg:text-[13px]">Tulungang nating panatilihing ligtas, maayos, at malinis ang ating pamayanan. Ang bawat ulat ay direktang natatanggap ng Lupon at Barangay para sa kaukulang aksyon.</p>
    </section>

    <%= render "form", barangay_concern: @barangay_concern %>
  </div>
</div>
