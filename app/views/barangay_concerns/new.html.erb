<div class="space-y-4">
  <div>
    <h2 class="text-2xl font-bold">Report a Public Concern / Issue</h2>
    <p class="text-gray-600">
      Submit community feedback regarding peace, infrastructure, or other neighborhood problems.
    </p>
  </div>

  <%= render "form", barangay_concern: @barangay_concern %>

  <div id="map" class="h-100 w-full"></div>

  <script>
    document.addEventListener("turbo:load", () => {
        const map = L.map('map').setView([15.4786, 121.0502], 15);

        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
        }).addTo(map);

        let marker = null

        map.on('click', e => {
          const lat = e.latlng.lat;
          const lng = e.latlng.lng;

          document.getElementById('latitude').value = lat.toFixed(6);
          document.getElementById('longitude').value = lng.toFixed(6);

          if (marker) {
            marker.setLatLng(e.latlng);
          } else {
            marker = L.marker(e.latlng).addTo(map)
          }
        })
    })
  </script>
</div>
