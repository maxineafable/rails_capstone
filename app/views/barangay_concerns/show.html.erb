<div class="grid grid-cols-3 gap-8">
    <div class="col-span-2 space-y-6">
        <section>
          <h3 class="mb-4 text-xl font-semibold">Barangay Concern Log</h3>

          <div class="border-l-2 pl-4">
            <% @barangay_concern.status_logs.order(created_at: :asc).each do |log| %>
              <div class="mb-5">
                <p class="font-medium">
                  <%= log.human_status %>
                </p>

                <p class="text-sm text-gray-500">
                  <%= log.created_at.strftime("%B %d, %Y at %I:%M %p") %>
                </p>

                <% if log.staff_remarks.present? %>
                  <p class="mt-1 text-sm text-gray-600">
                    Staff Update: <%= log.staff_remarks %>
                  </p>
                <% end %>
              </div>
            <% end %>
          </div>
        </section>

        <div>
            <h2 class="text-2xl font-bold">
            Community Concern Report #<%= @barangay_concern.id %>
            </h2>
        </div>

        <div class="space-y-2">
            <p>
            <strong>Filed By:</strong>
            <%= @barangay_concern.resident.profile.first_name %>
            <%= @barangay_concern.resident.profile.last_name %>
            </p>

            <p>
                <strong>Ticket:</strong>
                <%= @barangay_concern.tracking_number %>
            </p>

            <p>
            <strong>Category:</strong>
            <%= @barangay_concern.category.humanize %>
            </p>

            <p>
            <strong>Details / Reason:</strong>
            <%= @barangay_concern.reason %>
            </p>

            <p>
                <strong>Location</strong>
                <%= @barangay_concern.location_description %>
            </p>

            <p>
            <strong>Resident Notes:</strong>
            <%= @barangay_concern.resident_remarks.presence || "None" %>
            </p>

            <p>
            <strong>Current Status:</strong>
            <span class="font-semibold"><%= @barangay_concern.status_logs.last.human_status %></span>
            </p>

            <p>
                <strong>Current Staff Remarks:</strong>
                <span class="font-semibold"><%= @barangay_concern.status_logs.last.staff_remarks %></span>
                <%= @barangay_concern.status_logs.last.staff_remarks.presence || "No updates from the staff yet." %>
            </p>

            <p>
            <strong>Date Filed:</strong>
            <%= @barangay_concern.created_at.strftime("%B %d, %Y") %>
            </p>

            <% if @barangay_concern.assigned_staff.present? %>
              <p>
                <strong>Assigned staff:</strong>
                <%= @barangay_concern.assigned_staff.profile.first_name %>
                <%= @barangay_concern.assigned_staff.profile.last_name %>
                (<%= @barangay_concern.assigned_staff.staff.position.humanize %>)
              </p>
            <% end %>
        </div>

        <% if @barangay_concern.evidence_image.attached? %>
            <div>
            <p class="mb-2 font-semibold">Uploaded Evidence Photo:</p>

            <%= image_tag @barangay_concern.evidence_image, class: "block max-w-[400px] border" %>
            </div>
        <% end %>

        <% if @barangay_concern.latitude.present? && @barangay_concern.longitude.present? %>
          <div>
            <h3 class="text-lg font-semibold">Report Location</h3>

            <div id="map" class="h-100 w-full rounded"
                data-lat="<%= @barangay_concern.latitude %>"
                data-lng="<%= @barangay_concern.longitude %>"
            ></div>
          </div>

          <script>
            document.addEventListener("turbo:load", function() {
              const mapDiv = document.querySelector('#map')
              if (!mapDiv) return

              const latitude = parseFloat(mapDiv.dataset.lat);
              const longitude = parseFloat(mapDiv.dataset.lng);

              if (!latitude || !longitude) return

              const map = L.map("map").setView(
                [latitude, longitude],
                15
              );

              console.log(map)

              L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                  maxZoom: 19,
                  attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
              }).addTo(map);

              L.marker([latitude, longitude])
                .addTo(map)
                .bindPopup("Reported location")
                .openPopup();
            });
          </script>
        <% end %>
    </div>

    <% if current_user.barangay_staff? %>
        <section>
            <h3 class="mb-4 text-xl font-semibold">Barangay Staff Action Panel</h3>

            <%= form_with model: @barangay_concern, local: true do |f| %>
            <% if @barangay_concern.errors.any? %>
                <div class="mb-6 text-red-600">
                    <h3 class="mb-2 font-semibold">
                    Please fix the following errors:
                    </h3>

                    <ul class="list-disc pl-5">
                    <% @barangay_concern.errors.full_messages.each do |message| %>
                        <li><%= message %></li>
                    <% end %>
                    </ul>
                </div>
            <% end %>

            <div class="mb-4">
                <%= f.label :status, "Update Case Status", class: "mb-1 block font-medium" %>
                <%= f.select :status, BarangayConcern.statuses.keys.map { |s| [s.humanize, s] }, {}, class: "border p-2" %>
            </div>

            <div class="mb-4">
              <%= f.label :assigned_staff_id, "Assign Staff", class: "mb-1 block font-medium" %>

              <%= f.select :assigned_staff_id,
                  User.includes(:profile, :staff).where.associated(:staff).map { |s|
                    [
                      "#{s.profile.first_name} #{s.profile.last_name} - #{s.staff.position.humanize}",
                      s.id
                    ]
                  },
                  { include_blank: "Select Staff" },
                  class: "border p-2" %>
            </div>

            <div class="mb-4">
                <%= f.label :staff_remarks, "Staff Resolution Notes / Actions Taken", class: "mb-1 block font-medium" %>
                <%= f.text_area :staff_remarks, rows: 3, class: "w-full max-w-[500px] border p-2" %>
            </div>

            <%= f.submit "Update Case Tracking", class: "cursor-pointer bg-blue-600 px-4 py-2 text-white hover:bg-blue-700" %>
            <% end %>

            <div class="mt-4">
            <%= link_to "← Back to Admin Console", admin_dashboard_path, class: "text-blue-600 hover:underline" %>
            </div>
        </section>
    <% else %>
        <section class="border-t pt-6">
            <p>
            <strong>Official Action Summary:</strong>
            <%= @barangay_concern.status_logs.last.staff_remarks.presence || "This issue is currently awaiting official review." %>
            </p>

            <div class="mt-4">
            <%= link_to "← Back to Dashboard", root_path, class: "text-blue-600 hover:underline" %>
            </div>
        </section>
    <% end %>
</div>
