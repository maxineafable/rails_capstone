<%= turbo_frame_tag "remote_modal" do %>
  <div class="fixed inset-0 z-100 flex items-center justify-center bg-black/50 p-4">
    <div class="max-h-[90vh] w-full max-w-2xl overflow-y-auto rounded-lg bg-white shadow-lg">

      <div class="h-1 bg-gradient-to-r from-blue-800 to-emerald-700"></div>

      <div class="p-6">

        <!-- Header -->
        <div class="mb-5 flex items-start gap-3">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-indigo-100 text-blue-800">
            <span class="text-lg">≡</span>
          </div>

          <div>
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="text-lg font-semibold text-gray-900">Update Status</h3>

              <span class="rounded-full bg-indigo-100 px-2 py-0.5 text-xs font-medium text-blue-800">
                Opsiyal na Aksyon
              </span>
            </div>

            <p class="mt-1 text-sm text-gray-500">
              Baguhin ang progreso at italaga ang taong kakailangan para sa ulat na ito.
            </p>
          </div>
        </div>

        <%= form_with model: @barangay_concern, local: true do |f| %>

          <!-- Validation Errors -->
          <% if @barangay_concern.errors.any? %>
            <div class="mb-4 rounded-md bg-red-50 p-3 text-sm text-red-700">
              <p class="mb-1 font-semibold">Please fix the following errors:</p>

              <ul class="list-disc pl-5">
                <% @barangay_concern.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <!-- Reference Details -->
          <div class="mb-5 rounded-lg bg-blue-50 p-3">
            <div class="mb-3">
              <p class="text-xs font-semibold uppercase text-gray-500">
                Reference Number
              </p>

              <p class="mt-1 font-mono text-sm font-bold text-blue-900">
                <%= @barangay_concern.tracking_number.presence || "Not yet assigned" %>
              </p>
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div>
                <p class="text-xs font-semibold text-gray-600">Category</p>

                <p class="mt-1 text-sm text-gray-900">
                  <%= @barangay_concern.category.humanize %>
                </p>
              </div>

              <div>
                <p class="text-xs font-semibold text-gray-600">Reported By</p>

                <p class="mt-1 text-sm text-gray-900">
                  <%= @barangay_concern.resident.profile.first_name %>
                  <%= @barangay_concern.resident.profile.last_name %>
                </p>
              </div>
            </div>
          </div>

          <!-- Status -->
          <div class="mb-5">
            <div class="mb-2 flex items-center justify-between gap-2">
              <%= f.label :status, "Katayuan (Status)",
                  class: "text-sm font-semibold text-gray-800" %>

              <span class="text-xs font-medium text-blue-700">
                <%= @barangay_concern.status.humanize %>
              </span>
            </div>

            <%= f.select :status,
                BarangayConcern.statuses.keys.map { |s| [s.humanize, s] },
                {},
                class: "w-full rounded-md border border-gray-300 bg-white px-3 py-2.5 text-sm focus:border-blue-700 focus:outline-none" %>
          </div>

          <!-- Assigned Staff -->
          <div class="mb-5">
            <div class="mb-2 flex items-center justify-between gap-2">
              <%= f.label :assigned_staff_id, "Itatalagang Kawani (Assign Personnel)",
                  class: "text-sm font-semibold text-gray-800" %>

              <span class="shrink-0 text-xs text-emerald-700">
                <%= @barangay_concern.assigned_staff_id.present? ? "May nakatalaga" : "Hindi pa naitalaga" %>
              </span>
            </div>

            <%= f.select :assigned_staff_id,
                User.includes(:profile, :staff).where.associated(:staff).map { |staff_user|
                  [
                    "#{staff_user.profile&.first_name} #{staff_user.profile&.last_name} - #{staff_user.staff.position.humanize}",
                    staff_user.id
                  ]
                },
                { include_blank: "Pumili ng kawani..." },
                class: "w-full rounded-md border border-gray-300 bg-white px-3 py-2.5 text-sm focus:border-blue-700 focus:outline-none" %>

            <p class="mt-2 text-xs text-gray-500">
              Pumili ng partikular na opisyal o pangkat na tutugon sa pagbisita sa lokasyon.
            </p>
          </div>

          <!-- Remarks -->
          <div class="mb-5">
            <%= f.label :staff_remarks, "Karagdagang Tala (Remarks - Optional)",
                class: "mb-2 block text-sm font-semibold text-gray-800" %>

            <%= f.text_area :staff_remarks,
                rows: 3,
                placeholder: "Ilagay ang mga aksyon na ginawa o susunod na hakbang...",
                class: "w-full rounded-md border border-gray-300 px-3 py-2.5 text-sm focus:border-blue-700 focus:outline-none" %>

            <p class="mt-2 text-xs text-gray-500">
              Ilagay lamang ang mga detalye tungkol sa iskedyul, aksyon, o follow-up.
            </p>
          </div>

          <!-- Actions -->
          <div class="flex flex-col-reverse gap-3 sm:flex-row">
            <%= link_to "Kanselahin / Cancel",
                barangay_concern_path(@barangay_concern),
                class: "flex flex-1 items-center justify-center rounded-md bg-indigo-50 px-4 py-2.5 text-center text-sm font-semibold text-gray-800 hover:bg-indigo-100" %>

            <%= f.submit "I-save ang Pagbabago / Save Changes",
                class: "flex-1 cursor-pointer rounded-md bg-blue-800 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-900" %>
          </div>

        <% end %>

      </div>
    </div>
  </div>
<% end %>