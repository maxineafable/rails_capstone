<%= form_with model: barangay_concern, local: true do |f| %>
  <% if barangay_concern.errors.any? %>
    <div class="mb-5 text-red-600">
      <h4 class="mb-2 font-semibold">Please fix the errors below:</h4>

      <ul class="list-disc pl-5">
        <% barangay_concern.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-4">
    <div>
      <%= f.label :category, "Report Category", class: "mb-1 block font-medium" %>
      <%= f.select :category,
          BarangayConcern.categories.keys.map { |c| [c.humanize, c] },
          { include_blank: "Select a Category" },
          { required: true, class: "border p-2" } %>
    </div>

    <div>
      <%= f.label :reason, "Details / Reason of Report", class: "mb-1 block font-medium" %>
      <%= f.text_area :reason,
          required: true,
          rows: 5,
          placeholder: "Describe the issue or incident clearly...",
          class: "w-full max-w-[500px] border p-2" %>
    </div>

    <div>
      <%= f.label :resident_remarks, "Additional Remarks (Optional)", class: "mb-1 block font-medium" %>
      <%= f.text_area :resident_remarks,
          rows: 3,
          class: "w-full max-w-[500px] border p-2" %>
    </div>

    <div>
      <%= f.label :evidence_image, "Upload Photo / Evidence (Optional)", class: "mb-1 block font-medium" %>
      <%= f.file_field :evidence_image, accept: "image/*" %>
    </div>

    <%= f.submit "Submit Report",
        class: "cursor-pointer bg-blue-600 px-4 py-2 text-white hover:bg-blue-700" %>
  </div>
<% end %>
