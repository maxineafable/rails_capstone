<%= form_with model: barangay_concern, local: true, html: { class: "space-y-3.5" } do |f| %>
  <% if barangay_concern.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-800" role="alert">
      <h2 class="mb-2 font-semibold">Pakisuri ang mga detalye / Please fix the following:</h2>
      <ul class="list-inside list-disc space-y-1"><% barangay_concern.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
    </div>
  <% end %>

  <%= f.hidden_field :latitude, id: "latitude" %>
  <%= f.hidden_field :longitude, id: "longitude" %>

  <section class="rounded-lg bg-white p-4 sm:px-5 sm:py-4" aria-labelledby="category-heading">
    <div class="mb-3 flex items-center justify-between gap-2">
      <h2 id="category-heading" class="text-[12px] font-semibold text-[#07349e]"><span class="mr-1 inline-flex h-4 w-4 items-center justify-center rounded-full bg-[#244fbd] text-[9px] text-white">1</span>Select Category / Pumili ng Kategorya <span class="text-red-600">*</span></h2>
      <span class="text-[8px] font-medium text-slate-600">Required</span>
    </div>

    <% categories = [["Drainage", "Daluyan / Kanal", "health_and_sanitation", "≋"], ["Roads", "Kalsada / Lubak", "infrastructure", "╫"], ["Street lights", "Siraing Ilaw sa Poste", "peace_and_order", "☼"], ["Garbage", "Basura / Kalinisan", "waste_management", "▤"], ["Other", "Iba Pang Suliranin", "others", "⊞"]] %>
    <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 md:grid-cols-5 md:gap-3">
      <% categories.each do |title, translation, value, icon| %>
        <% category_id = "concern_category_#{value}" %>
        <div class="relative">
          <%= f.radio_button :category, value, id: category_id, required: true, class: "peer sr-only" %>
          <label for="<%= category_id %>" class="flex min-h-[76px] cursor-pointer flex-col items-center justify-center rounded-lg border border-transparent bg-[#eff3ff] px-2 py-2 text-center text-slate-800 transition hover:border-[#9eb4ff] peer-checked:border-[#244fbd] peer-checked:bg-[#e1e9ff] peer-checked:ring-1 peer-checked:ring-[#244fbd] peer-focus-visible:ring-2 peer-focus-visible:ring-[#244fbd]">
            <span class="mb-1 text-[18px] font-semibold leading-none text-[#244fbd]" aria-hidden="true"><%= icon %></span>
            <span class="text-[9px] font-semibold"><%= title %></span>
            <span class="text-[8px] leading-tight text-slate-600"><%= translation %></span>
          </label>
        </div>
      <% end %>
    </div>
    <p class="mt-2 rounded-md bg-[#eff3ff] px-2.5 py-2 text-[9px] leading-relaxed text-slate-700"><span class="font-semibold text-[#244fbd]">ⓘ</span> Ang pagpili ng tamang kategorya ay awtomatikong nagpapadala ng sumbong sa nakatalagang Barangay upang mapabilis ang inspeksyon.</p>
  </section>

  <section class="rounded-lg bg-white p-4 sm:px-5 sm:py-4" aria-labelledby="description-heading">
    <div class="mb-3 flex items-center justify-between gap-2">
      <h2 id="description-heading" class="text-[12px] font-semibold text-[#07349e]"><span class="mr-1 inline-flex h-4 w-4 items-center justify-center rounded-full bg-[#244fbd] text-[9px] text-white">2</span>Issue Description / Detalye ng Sumbong <span class="text-red-600">*</span></h2>
      <span class="text-[8px] font-medium text-slate-600">Kinakailangan</span>
    </div>
    <p class="mb-3 text-[9px] text-slate-600">Magbigay ng kumpletong detalye upang madaling matukoy at maaksiyunan ng mga kawani ng barangay.</p>

    <div class="mb-3">
      <%= f.label :location_description, "Purok / Sona ng Insidente · Eksaktong Lokasyon", class: "mb-1 block text-[9px] font-medium" %>
      <%= f.text_field :location_description, required: true, placeholder: "Hal. Purok 3, malapit sa Barangay Hall", class: "h-10 w-full rounded-md border-0 bg-[#eff3ff] px-3 text-[10px] outline-none placeholder:text-slate-500 focus:ring-2 focus:ring-[#244fbd]/30" %>
    </div>

    <div>
      <%= f.label :reason, "Paglalarawan ng nangyari", class: "mb-1 block text-[9px] font-medium" %>
      <%= f.text_area :reason, required: true, maxlength: 500, rows: 5, placeholder: "Ilarawan ang problema, kailan ito nangyari, at iba pang detalyeng makatutulong sa pagsisiyasat.", class: "min-h-[115px] w-full resize-y rounded-md border-0 bg-[#eff3ff] px-3 py-2.5 text-[10px] leading-relaxed outline-none placeholder:text-slate-500 focus:ring-2 focus:ring-[#244fbd]/30" %>
      <p class="mt-1 text-right text-[8px] text-[#07349e]"><span id="reason-character-count"><%= barangay_concern.reason.to_s.length %></span> / 500 characters</p>
    </div>

    <div class="mt-3">
      <%= f.label :resident_remarks, "Karagdagang Tala / Additional Remarks (Optional)", class: "mb-1 block text-[9px] font-medium" %>
      <%= f.text_area :resident_remarks, rows: 2, class: "min-h-[56px] w-full resize-y rounded-md border-0 bg-[#eff3ff] px-3 py-2 text-[10px] outline-none focus:ring-2 focus:ring-[#244fbd]/30" %>
    </div>

    <div class="mt-4">
      <h3 class="mb-1 text-[10px] font-semibold text-slate-900">Pin ang lokasyon sa mapa <span class="font-normal text-slate-500">(Optional)</span></h3>
      <p class="mb-2 text-[9px] text-slate-600">Pindutin ang mapa upang markahan ang lugar ng insidente.</p>
      <div id="concern-map" class="h-[220px] w-full overflow-hidden rounded-lg border border-[#dce4ff] bg-[#eff3ff] sm:h-[260px]" role="application" aria-label="Map to select incident location"></div>
      <p class="mt-1.5 text-[8px] text-slate-500">© OpenStreetMap contributors · Mag-zoom o i-drag ang mapa para mas eksaktong lokasyon.</p>
    </div>
  </section>

  <section class="rounded-lg bg-white p-4 sm:px-5 sm:py-4" aria-labelledby="evidence-heading">
    <h2 id="evidence-heading" class="mb-1 text-[12px] font-semibold text-[#07349e]"><span class="mr-1 inline-flex h-4 w-4 items-center justify-center rounded-full bg-[#244fbd] text-[9px] text-white">3</span>Photo of the Concern / Larawan ng Sitwasyon <span class="text-[9px] font-normal text-slate-600">(Optional)</span></h2>
    <p class="mb-3 text-[9px] leading-relaxed text-slate-600">Maglakip ng malinaw na larawan ng sira o sitwasyon upang agad makita ang tamang lugar at kalagayan.</p>
    <label class="flex min-h-[110px] cursor-pointer flex-col items-center justify-center rounded-lg bg-[#f7f8ff] px-4 py-4 text-center hover:bg-[#eff3ff]">
      <span class="mb-2 flex h-8 w-8 items-center justify-center rounded-full bg-[#dce4ff] text-base text-[#244fbd]" aria-hidden="true">⇧</span>
      <span class="text-[10px] font-semibold">Kumuha ng larawan o mag-browse mula sa cellphone</span>
      <span class="mt-1 text-[8px] text-slate-500">Tumatanggap ng JPG, PNG at iba pang image format.</span>
      <%= f.file_field :evidence_image, accept: "image/*", capture: "environment", class: "mt-3 block w-full max-w-[350px] text-[9px] file:mr-2 file:cursor-pointer file:rounded-md file:border-0 file:bg-[#dce7ff] file:px-3 file:py-2 file:text-[9px] file:font-semibold file:text-[#07349e]" %>
    </label>
  </section>

  <section class="rounded-lg bg-white p-3 sm:px-5 sm:py-4">
    <%= f.submit "➤  Submit Report (Isumite ang Sumbong)", class: "h-10 w-full cursor-pointer rounded-md border-0 bg-[#2445b8] text-[10px] font-semibold text-white shadow-sm hover:bg-[#17379f] focus:outline-none focus:ring-2 focus:ring-[#2445b8]/40 focus:ring-offset-2" %>
    <%= link_to "Kanselahin ang Form (Cancel)", root_path, class: "mt-1 block rounded-md bg-[#eff3ff] px-3 py-2.5 text-center text-[9px] font-medium text-slate-800 no-underline hover:bg-[#e1e9ff]" %>
    <p class="mt-2 text-center text-[8px] text-slate-500">Protected in accordance with the Data Privacy Act.</p>
  </section>
<% end %>

<script>
  document.addEventListener("turbo:load", () => {
      const map = L.map('concern-map').setView([15.4786, 121.0502], 15);

      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 19,
          attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
      }).addTo(map);

      let marker = null

      map.on('click', e => {
        const lat = e.latlng.lat;
        const lng = e.latlng.lng;

        document.getElementById('latitude').value = lat.toFixed(6);
        document.getElementById('longitude').value = lng.toFixed(6);

        if (marker) {
          marker.setLatLng(e.latlng);
        } else {
          marker = L.marker(e.latlng).addTo(map)
        }
      })
  })
</script>