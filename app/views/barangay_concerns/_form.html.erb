<%= form_with model: barangay_concern, local: true, html: { class: "space-y-3.5 lg:space-y-6", data: { required_validation: true } } do |f| %>
  <div data-required-summary class="mb-4 hidden rounded-lg border border-red-300 bg-red-50 px-4 py-3 text-sm font-semibold text-red-800" role="alert" tabindex="-1">
    May mga kinakailangang patlang na hindi pa napupunan. Pakisuri ang mga naka-highlight.
  </div>
  <% if barangay_concern.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-800 lg:p-6 lg:text-[20px]" role="alert">
      <h2 class="mb-2 font-semibold">Pakisuri ang mga detalye:</h2>
      <ul class="list-inside list-disc space-y-1"><% barangay_concern.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
    </div>
  <% end %>

  <%= f.hidden_field :latitude, id: "latitude" %>
  <%= f.hidden_field :longitude, id: "longitude" %>

  <section class="rounded-lg bg-white p-4 sm:px-5 sm:py-4 lg:p-8" aria-labelledby="category-heading">
    <div class="mb-3 flex items-center justify-between gap-2 lg:mb-5 lg:gap-4">
      <h2 id="category-heading" class="text-[12px] font-semibold text-[#07349e] lg:text-[20px]"><span class="mr-1 inline-flex h-4 w-4 items-center justify-center rounded-full bg-[#244fbd] text-[9px] text-white lg:h-6 lg:w-6 lg:text-[13px]">1</span>Pumili ng Kategorya <span class="text-red-600">*</span></h2>
      <span class="text-[8px] font-medium text-slate-600 lg:text-[13px]">Kinakailangan</span>
    </div>

    <% categories = [["Drainage", "Daluyan / Kanal", "health_and_sanitation", "drainage.svg"], ["Roads", "Kalsada / Lubak", "infrastructure", "roads.svg"], ["Street lights", "Siraing Ilaw sa Poste", "peace_and_order", "streetlight.svg"], ["Garbage", "Basura / Kalinisan", "waste_management", "garbage.svg"], ["Other", "Iba Pang Suliranin", "others", "others.svg"]] %>
    <div data-category-group class="grid grid-cols-2 gap-2 sm:grid-cols-3 md:grid-cols-5 md:gap-3 lg:gap-4">
      <% categories.each do |title, translation, value, icon| %>
        <% category_id = "concern_category_#{value}" %>
        <div class="relative">
          <%= f.radio_button :category, value, id: category_id, required: true, class: "peer sr-only" %>
          <label for="<%= category_id %>" class="flex min-h-[76px] cursor-pointer lg:min-h-[132px] lg:px-4 lg:py-4 flex-col items-center justify-center rounded-lg border border-transparent bg-[#eff3ff] px-2 py-2 text-center text-slate-800 transition hover:border-[#9eb4ff] peer-checked:border-[#244fbd] peer-checked:bg-[#e1e9ff] peer-checked:ring-1 peer-checked:ring-[#244fbd] peer-focus-visible:ring-2 peer-focus-visible:ring-[#244fbd]">
            <%= image_tag icon, alt: "", class: "mb-1 h-7 w-7 object-contain lg:mb-2 lg:h-10 lg:w-10", aria: { hidden: true } %>
            <span class="text-[9px] font-semibold lg:text-[15px]"><%= title %></span>
            <span class="text-[8px] leading-tight text-slate-600 lg:text-[13px]"><%= translation %></span>
          </label>
        </div>
      <% end %>
    </div>
    <p data-category-error class="mt-2 hidden text-xs font-semibold text-red-700">Pumili ng kategorya upang magpatuloy.</p>
    <p class="mt-3 rounded-md bg-[#eff3ff] px-3 py-2.5 text-[9px] leading-relaxed text-slate-700 lg:mt-6 lg:px-4 lg:py-3 lg:text-[13px]"><span class="font-semibold text-[#244fbd]">ⓘ</span> Ang pagpili ng tamang kategorya ay awtomatikong nagpapadala ng sumbong sa nakatalagang Barangay upang mapabilis ang inspeksyon.</p>
  </section>

  <section class="rounded-lg bg-white p-4 sm:px-5 sm:py-4 lg:p-8" aria-labelledby="description-heading">
    <div class="mb-3 flex items-center justify-between gap-2 lg:mb-5 lg:gap-4">
      <h2 id="description-heading" class="text-[12px] font-semibold text-[#07349e] lg:text-[20px]"><span class="mr-1 inline-flex h-4 w-4 items-center justify-center rounded-full bg-[#244fbd] text-[9px] text-white lg:h-6 lg:w-6 lg:text-[13px]">2</span>Detalye ng Suliranin <span class="text-red-600">*</span></h2>
      <span class="text-[8px] font-medium text-slate-600 lg:text-[13px]">Kinakailangan</span>
    </div>
    <p class="mb-4 text-[9px] text-slate-600 lg:mb-5 lg:text-[13px]">Magbigay ng kumpletong detalye upang madaling matukoy at maaksiyunan ng mga kawani ng barangay.</p>

    <div class="mb-3">
      <%= f.label :location_description, class: "mb-1 block text-[9px] font-medium lg:text-[15px]" do %>Purok / Sona ng Insidente · Eksaktong Lokasyon <span class="text-red-600">*</span><% end %>
      <%= f.text_field :location_description, required: true, placeholder: "Hal. Purok 3, malapit sa Barangay Hall", class: "h-10 w-full rounded-md border-0 bg-[#eff3ff] px-3 text-[10px] lg:h-14 lg:px-4 lg:text-[16px] outline-none placeholder:text-slate-500 focus:ring-2 focus:ring-[#244fbd]/30" %>
    </div>

    <div>
      <%= f.label :reason, class: "mb-1 block text-[9px] font-medium lg:text-[15px]" do %>Paglalarawan ng nangyari <span class="text-red-600">*</span><% end %>
      <%= f.text_area :reason, required: true, maxlength: 500, rows: 5, placeholder: "Ilarawan ang problema, kailan ito nangyari, at iba pang detalyeng makatutulong sa pagsisiyasat.", class: "min-h-[115px] w-full resize-y rounded-md border-0 bg-[#eff3ff] px-3 py-2.5 text-[10px] lg:min-h-[180px] lg:px-4 lg:py-4 lg:text-[16px] leading-relaxed outline-none placeholder:text-slate-500 focus:ring-2 focus:ring-[#244fbd]/30" %>
      <p class="mt-1 text-right text-[8px] text-[#07349e] lg:text-[13px]"><span id="reason-character-count"><%= barangay_concern.reason.to_s.length %></span> / 500 character</p>
    </div>

    <div class="mt-3">
      <%= f.label :resident_remarks, "Karagdagang Tala (Opsyonal)", class: "mb-1 block text-[9px] font-medium lg:text-[15px]" %>
      <%= f.text_area :resident_remarks, rows: 2, class: "min-h-[56px] w-full resize-y rounded-md border-0 bg-[#eff3ff] px-3 py-2 text-[10px] lg:min-h-[88px] lg:px-4 lg:py-3 lg:text-[16px] outline-none focus:ring-2 focus:ring-[#244fbd]/30" %>
    </div>

    <div class="mt-5 lg:mt-6">
      <h3 class="mb-2 text-[10px] font-semibold text-slate-900 lg:text-[13px]">I-pin ang lokasyon sa mapa <span class="font-normal text-slate-500">(Opsyonal)</span></h3>
      <p class="mb-2 text-[9px] text-slate-600 lg:text-[13px]">Pindutin ang mapa upang markahan ang lugar ng insidente.</p>
      <div id="concern-map" class="h-[220px] w-full overflow-hidden rounded-lg border border-[#dce4ff] bg-[#eff3ff] sm:h-[260px] lg:h-[400px]" role="application" aria-label="Map to select incident location"></div>
      <p class="mt-2 text-[8px] text-slate-500 lg:text-[13px]">© OpenStreetMap contributors · Mag-zoom o i-drag ang mapa para mas eksaktong lokasyon.</p>
    </div>
  </section>

  <section class="rounded-lg bg-white p-4 sm:px-5 sm:py-4 lg:p-8" aria-labelledby="evidence-heading">
    <h2 id="evidence-heading" class="mb-2 text-[12px] font-semibold text-[#07349e] lg:text-[20px]"><span class="mr-1 inline-flex h-4 w-4 items-center justify-center rounded-full bg-[#244fbd] text-[9px] text-white lg:h-6 lg:w-6 lg:text-[13px]">3</span>Larawan ng Suliranin <span class="text-[9px] font-normal text-slate-600 lg:text-[13px]">(Opsyonal)</span></h2>
    <p class="mb-4 text-[9px] leading-relaxed text-slate-600 lg:mb-5 lg:text-[13px]">Maglakip ng malinaw na larawan ng sira o sitwasyon upang agad makita ang tamang lugar at kalagayan.</p>
    <div class="rounded-xl bg-[#F6F8FF] p-5 text-center sm:p-7">
      <div class="mx-auto flex h-11 w-11 items-center justify-center rounded-full bg-indigo-100 text-blue-800" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 16V8m0 0-3 3m3-3 3 3"/><path stroke-linecap="round" stroke-linejoin="round" d="M20 16.5a4 4 0 0 0-3.5-3.97A5 5 0 0 0 7 11a3.5 3.5 0 0 0-.5 6.96"/><path stroke-linecap="round" stroke-linejoin="round" d="M8 19h8"/></svg>
      </div>
      <p class="mt-3 text-xs font-semibold text-slate-800 lg:text-[13px]">I-drag ang file dito o pumili ng paraan ng pag-upload</p>
      <p class="mt-1 text-[11px] text-slate-600 lg:text-[13px]">JPG o PNG. Pumili ng nakatalang larawan o gamitin ang camera ng inyong telepono.</p>
      <div class="mt-4 grid w-full gap-2 sm:grid-cols-2">
        <%= f.file_field :evidence_image, id: "concern-evidence-gallery", accept: "image/*", class: "peer sr-only", data: { photo_picker: true, other_picker: "concern-evidence-camera", filename_target: "concern-evidence-filename", preview_target: "concern-evidence-preview", camera_group: "concern-evidence", upload_target: "concern-evidence-gallery" } %>
        <label for="concern-evidence-gallery" class="flex min-h-11 cursor-pointer items-center justify-center gap-2 rounded-lg bg-blue-100 px-4 py-2 text-xs font-semibold text-blue-900 transition hover:bg-blue-200 peer-focus-visible:ring-2 peer-focus-visible:ring-blue-400 lg:text-[13px]">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 5h16v14H4z"/><circle cx="9" cy="10" r="1.5"/><path d="m5 17 5-4 3 2 3-3 4 4"/></svg>
          Pumili ng larawan
        </label>
        <input id="concern-evidence-camera" name="barangay_concern[evidence_camera]" type="file" accept="image/*" capture="environment" class="peer sr-only" data-photo-picker data-other-picker="concern-evidence-gallery" data-filename-target="concern-evidence-filename" data-preview-target="concern-evidence-preview" data-camera-group="concern-evidence" data-upload-target="concern-evidence-gallery">
        <button type="button" data-camera-open="concern-evidence" class="flex min-h-11 cursor-pointer items-center justify-center gap-2 rounded-lg bg-blue-100 px-4 py-2 text-xs font-semibold text-blue-900 transition hover:bg-blue-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 lg:text-[13px]">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h3l1.5-2h7L17 7h3v12H4z"/><circle cx="12" cy="13" r="3.5"/></svg>
          Gamitin ang camera
        </button>
      </div>
      <div id="concern-evidence-camera-panel" class="mx-auto mt-4 hidden w-full max-w-md rounded-xl border border-blue-200 bg-white p-3" aria-live="polite">
        <p id="concern-evidence-camera-message" class="mb-2 text-xs font-semibold text-slate-700">Iharap ang larawan ng suliranin sa camera.</p>
        <video id="concern-evidence-camera-video" class="max-h-72 w-full rounded-lg bg-slate-900 object-contain" autoplay playsinline muted></video>
        <img id="concern-evidence-camera-captured" class="hidden max-h-72 w-full rounded-lg object-contain" alt="Larawang kuha ng suliranin">
        <div class="mt-3 flex flex-wrap justify-center gap-2">
          <button type="button" data-camera-action="capture" data-camera-group="concern-evidence" class="rounded-lg bg-[#07349e] px-4 py-2 text-xs font-semibold text-white hover:bg-[#0b2e83]">Kumuha ng Larawan</button>
          <button type="button" data-camera-action="retake" data-camera-group="concern-evidence" class="hidden rounded-lg bg-blue-100 px-4 py-2 text-xs font-semibold text-blue-900 hover:bg-blue-200">Kumuha Muli</button>
          <button type="button" data-camera-action="use" data-camera-group="concern-evidence" class="hidden rounded-lg bg-emerald-700 px-4 py-2 text-xs font-semibold text-white hover:bg-emerald-800">Gamitin ang Larawan</button>
          <button type="button" data-camera-action="cancel" data-camera-group="concern-evidence" class="rounded-lg bg-slate-100 px-4 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-200">Isara</button>
          <button type="button" data-camera-action="fallback" data-camera-group="concern-evidence" class="hidden rounded-lg bg-blue-100 px-4 py-2 text-xs font-semibold text-blue-900 hover:bg-blue-200">Pumili ng larawan sa device</button>
        </div>
      </div>
      <p id="concern-evidence-filename" class="mt-3 min-h-4 text-[10px] text-slate-600" aria-live="polite">Wala pang napipiling larawan</p>
      <div class="mx-auto mt-3 hidden w-full max-w-sm overflow-hidden rounded-lg border border-blue-200 bg-white p-2" id="concern-evidence-preview-container">
        <img id="concern-evidence-preview" class="max-h-64 w-full object-contain" alt="Preview ng larawang kalakip na katibayan">
      </div>
      <p class="mt-1 text-[10px] font-medium text-slate-600">Opsyonal ang larawan. Maaari kang pumili ng ibang larawan o kumuha muli.</p>
    </div>
  </section>

  <section class="rounded-lg bg-white p-3 sm:px-5 sm:py-4 lg:p-6">
    <%= f.submit "➤  Isumite ang Ulat", class: "h-10 w-full cursor-pointer rounded-md border-0 bg-[#2445b8] text-[10px] lg:h-14 lg:text-[13px] font-semibold text-white shadow-sm hover:bg-[#17379f] focus:outline-none focus:ring-2 focus:ring-[#2445b8]/40 focus:ring-offset-2" %>
    <button type="button" data-concern-cancel-open class="mt-2 block w-full rounded-md bg-[#eff3ff] px-3 py-2.5 text-center text-[9px] font-medium text-slate-800 hover:bg-[#e1e9ff] lg:py-3.5 lg:text-[13px]">Kanselahin ang Form (Kanselahin)</button>
    <p class="mt-3 text-center text-[8px] text-slate-500 lg:text-[13px]">Pinoprotektahan ang inyong datos alinsunod sa Data Privacy Act.</p>
  </section>
<% end %>

<%= render "cancel_confirmation_modal" %>

<script>
  document.addEventListener("turbo:load", () => {
      const map = L.map('concern-map').setView([15.4786, 121.0502], 15);

      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 19,
          attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
      }).addTo(map);

      let marker = null

      map.on('click', e => {
        const lat = e.latlng.lat;
        const lng = e.latlng.lng;

        document.getElementById('latitude').value = lat.toFixed(6);
        document.getElementById('longitude').value = lng.toFixed(6);

        if (marker) {
          marker.setLatLng(e.latlng);
        } else {
          marker = L.marker(e.latlng).addTo(map)
        }
      })
  })
</script>
