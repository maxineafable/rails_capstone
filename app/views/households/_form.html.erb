<%= form_with model: household, local: true, class: "h-full flex flex-col" do |f| %>

  <!-- STICKY DRAWER PANEL HEADER CONTROLS -->
  <div class="sticky top-0 z-10 flex items-center justify-between border-b bg-gray-50 p-5">
    <div>
      <h2 class="text-xl font-bold text-gray-800">
        <%= household.new_record? ? "Create New Household Record" : "Edit Household Record" %>
      </h2>
      <p class="mt-0.5 text-xs text-gray-500 font-medium">
        Barangay Census Registry Operations
      </p>
    </div>

    <!-- CLOSES DRAWER VIA THE ASSIGNABLE INTERFACE METHOD -->
    <%= link_to "✕", "#",
                class: "rounded-lg p-2 text-xl text-gray-400 hover:bg-gray-100 hover:text-gray-700 transition",
                data: { action: "click->remote-modal#close" } %>
  </div>

  <!-- MAIN SCROLLABLE FORM BODY BOX CONTAINER CONTENT -->
  <div class="flex-1 overflow-y-auto p-6 space-y-8 bg-slate-50/50">

    <% if household.errors.any? %>
      <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700">
        <h4 class="font-semibold">Please review the following errors:</h4>
        <ul class="mt-2 list-disc pl-5">
          <% household.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- SECTION A: ADDRESS FIELDS REGISTRY MATRIX -->
    <section class="bg-white rounded-xl border p-5 shadow-sm space-y-4">
      <div class="border-b pb-2">
        <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider">
          SECTION A: Household Address & Identifiers
        </h3>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <%= f.label :house_number, "House/Bldg Number *", class: "mb-1 block text-xs font-semibold text-gray-600 uppercase tracking-wider" %>
          <%= f.text_field :house_number, required: true, class: "w-full rounded border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none" %>
        </div>

        <div>
          <%= f.label :street, "Street *", class: "mb-1 block text-xs font-semibold text-gray-600 uppercase tracking-wider" %>
          <%= f.text_field :street, required: true, class: "w-full rounded border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none" %>
        </div>

        <div>
          <%= f.label :purok, "Purok Sector *", class: "mb-1 block text-xs font-semibold text-gray-600 uppercase tracking-wider" %>
          <%= f.text_field :purok, required: true, class: "w-full rounded border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none" %>
        </div>

        <div>
          <%= f.label :date_accomplished, "Survey Completion Date *", class: "mb-1 block text-xs font-semibold text-gray-600 uppercase tracking-wider" %>
          <%= f.date_field :date_accomplished, value: household.date_accomplished || Date.current, required: true, class: "w-full rounded border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none" %>
        </div>
      </div>
    </section>

    <!-- SECTION B: NESTED FAMILY SUB-ROWS WRAPPERS CONTAINER -->
    <section class="space-y-4">
      <div class="border-b pb-2 px-1">
        <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider">
          SECTION B: Family Members Details
        </h3>
        <p class="mt-1 text-xs text-gray-500">
          Enter the personal information details for each resident living in this household cell.
        </p>
      </div>

      <div id="members-forms-list" class="space-y-4">
        <%= f.fields_for :household_members do |m| %>
          <!-- NESTED CARD LAYOUT RECORD ROWS -->
          <div class="bg-white rounded-xl border border-gray-200 p-5 shadow-sm space-y-6 relative group hover:border-gray-300 transition">
            
            <div class="flex items-center justify-between border-b pb-2">
              <h4 class="text-sm font-bold text-gray-700 flex items-center gap-2">
                <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-slate-100 text-xs text-slate-600 font-mono">
                  <%= m.index + 1 %>
                </span>
                Resident Member Row
              </h4>
            </div>

            <!-- NAME ENTITIES SUB-ROWS GRID CONTAINER -->
            <div class="space-y-4">
              <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div>
                  <%= m.label :first_name, "First Name *", class: "mb-1 block text-xs font-semibold text-gray-600 uppercase tracking-wider" %>
                  <%= m.text_field :first_name, required: true, class: "w-full rounded border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none" %>
                </div>

                <div>
                  <%= m.label :middle_name, "Middle Name", class: "mb-1 block text-xs font-semibold text-gray-600 uppercase tracking-wider" %>
                  <%= m.text_field :middle_name, class: "w-full rounded border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none" %>
                </div>

                <div>
                  <%= m.label :last_name, "Last Name *", class: "mb-1 block text-xs font-semibold text-gray-600 uppercase tracking-wider" %>
                  <%= m.text_field :last_name, required: true, class: "w-full rounded border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none" %>
                </div>

                <div>
                  <%= m.label :suffix, "Suffix", class: "mb-1 block text-xs font-semibold text-gray-600 uppercase tracking-wider" %>
                  <%= m.text_field :suffix, placeholder: "Jr/Sr", class: "w-full rounded border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none" %>
                </div>
              </div>
            </div>

            <!-- BIOMETRIC ATTRIBUTES MATRIX -->
            <div class="border-t border-slate-100 pt-4 space-y-4">
              <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div>
                  <%= m.label :birth_date, "Birth Date *", class: "mb-1 block text-xs font-semibold text-gray-600 uppercase tracking-wider" %>
                  <%= m.date_field :birth_date, required: true, class: "w-full rounded border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none" %>
                </div>

                <div>
                  <%= m.label :birth_place, "Birth Place *", class: "mb-1 block text-xs font-semibold text-gray-600 uppercase tracking-wider" %>
                  <%= m.text_field :birth_place, required: true, class: "w-full rounded border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none" %>
                </div>

                <div>
                  <%= m.label :sex, "Sex *", class: "mb-1 block text-xs font-semibold text-gray-600 uppercase tracking-wider" %>
                  <%= m.select :sex, HouseholdMember.sexes.keys.map { |s| [s.humanize, s] }, { include_blank: "Select" }, { required: true, class: "w-full rounded border border-gray-300 bg-white px-3 py-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none" } %>
                </div>

                <div>
                  <%= m.label :civil_status, "Civil Status *", class: "mb-1 block text-xs font-semibold text-gray-600 uppercase tracking-wider" %>
                  <%= m.select :civil_status, HouseholdMember.civil_statuses.keys.map { |c| [c.humanize, c] }, { include_blank: "Select" }, { required: true, class: "w-full rounded border border-gray-300 bg-white px-3 py-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none" } %>
                </div>

                <div>
                  <%= m.label :citizenship, "Citizenship", class: "mb-1 block text-xs font-semibold text-gray-600 uppercase tracking-wider" %>
                  <%= m.text_field :citizenship, class: "w-full rounded border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none" %>
                </div>

                <div>
                  <%= m.label :occupation, "Occupation / Livelihood", class: "mb-1 block text-xs font-semibold text-gray-600 uppercase tracking-wider" %>
                  <%= m.text_field :occupation, placeholder: "Driver, Teacher, None", class: "w-full rounded border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none" %>
                </div>

                <div class="sm:col-span-2">
                <%= f.label :relationship_to_head, "Relationship To Head",
                    class: "mb-1 block text-xs font-semibold text-gray-600 uppercase tracking-wider" %>

                <%= f.text_field :relationship_to_head,
                    value: "Head",
                    readonly: true,
                    class: "w-full rounded border border-gray-200 bg-gray-50 px-3 py-2 text-sm text-gray-500 cursor-not-allowed focus:outline-none" %>
              </div>


              </div>
            </div>

          </div>
        <% end %>
      </div>
    </section>

  </div>

  <!-- STICKY BOTTOM BUTTON BAR ACTION LAYOUT -->
  <div class="sticky bottom-0 z-10 flex items-center justify-end gap-3 border-t bg-gray-50 p-4">
    <%= link_to "Cancel", "#",
                class: "rounded-lg border bg-white px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-100 transition",
                data: { action: "click->remote-modal#close" } %>

    <%= f.submit "Save Census Registry File",
                 class: "cursor-pointer rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-blue-700 transition" %>
  </div>

<% end %>
