<%= form_with model: household, local: true, class: "flex h-full min-h-0 flex-col" do |f| %>
  <header class="flex shrink-0 items-start justify-between gap-5 border-b border-slate-100 bg-white px-5 py-5 sm:px-8 lg:px-10">
    <div>
      <p class="text-[10px] font-bold uppercase tracking-[0.08em] text-[#07349e] lg:text-[11px]">Talaan ng Populasyon at Sambahayan (RBI Form A) <span class="mx-1 text-slate-300">•</span> <span class="normal-case tracking-normal text-slate-600">Barangay Kalikid Sur</span></p>
      <h1 class="mt-2 text-[25px] font-bold leading-tight tracking-[-0.04em] text-slate-900 sm:text-[28px]">Magdagdag ng Sambahayan</h1>
      <p class="mt-1 text-xs text-slate-500">Gumawa ng talaan ng sambahayan at ilagay ang pinuno nito.</p>
    </div>
    <button type="button" onclick="const drawer = this.closest('[data-household-drawer]'); drawer.classList.add('animate-slide-out'); setTimeout(() => document.getElementById('remote_modal').innerHTML = '', 220)" class="shrink-0 rounded-lg p-2 text-2xl leading-none text-slate-500 transition hover:bg-slate-100 hover:text-slate-900" aria-label="Isara ang pormularyo ng pagdaragdag ng sambahayan">×</button>
  </header>

  <%= f.hidden_field :date_accomplished, value: household.date_accomplished || Date.current %>

  <div class="min-h-0 flex-1 space-y-4 overflow-y-auto bg-white px-5 py-4 sm:px-8 lg:px-10">
    <% if household.errors.any? %>
      <section class="rounded-lg border border-red-200 bg-red-50 p-4 text-xs text-red-800" role="alert">
        <h2 class="font-semibold">Pakisuri ang sumusunod:</h2>
        <ul class="mt-1 list-inside list-disc"><% household.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
      </section>
    <% end %>

    <section class="flex gap-3 rounded-xl bg-[#eff3ff] p-4 sm:p-5">
      <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-[#2445b8]"><%= image_tag "peopleplus.svg", alt: "", class: "h-5 w-5 object-contain brightness-0 invert" %></span>
      <div>
        <h2 class="text-xs font-bold text-[#07349e] lg:text-[14px]">Gumagawa ng bagong sambahayan — ang taong ito ang magiging pinuno nito</h2>
        <span class="mt-1 inline-flex rounded-full bg-[#17379f] px-2.5 py-1 text-[8px] font-bold uppercase tracking-wide text-white">Awtomatikong Itinalagang Pinuno</span>
        <p class="mt-1 max-w-2xl text-[11px] leading-relaxed text-slate-600 lg:text-[13px]">Bilang unang kasapi, awtomatikong itatalaga ang taong ito bilang pinuno ng sambahayan alinsunod sa memorandum ng DILG.</p>
      </div>
    </section>

    <%= f.fields_for :household_members do |m| %>
    <% occupations = ["Carpenter", "Driver", "Farmer", "Government Employee", "Household Worker", "Private Employee", "Self-employed", "Student", "Unemployed"] %>
    <% custom_occupation = m.object.occupation.present? && !occupations.include?(m.object.occupation) %>
    <section class="rounded-xl border border-slate-100 p-4 sm:p-5" aria-labelledby="household-head-title">
      <div class="mb-4 flex items-center gap-2">
        <span class="flex h-6 w-6 items-center justify-center rounded-full bg-indigo-100 text-[11px] font-bold text-[#07349e]">1</span>
        <h2 id="household-head-title" class="text-sm font-bold text-slate-900">Sino ang taong ito?</h2>
      </div>
      <%= m.hidden_field :relationship_to_head, value: "Head" %>
      <div class="grid gap-x-4 gap-y-3 sm:grid-cols-2">
          <div>
            <%= m.label :last_name, class: "mb-1 block text-[10px] font-semibold text-slate-800 lg:text-[12px]" do %>Apelyido <span class="text-red-600">*</span><% end %>
            <%= m.text_field :last_name, required: true, placeholder: "Hal. Dela Cruz", class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-3 text-xs outline-none transition placeholder:text-slate-400 focus:border-[#2445b8] focus:ring-2 focus:ring-blue-100 lg:text-[14px]" %>
          </div>
          <div>
            <%= m.label :first_name, class: "mb-1 block text-[10px] font-semibold text-slate-800 lg:text-[12px]" do %>Pangalan <span class="text-red-600">*</span><% end %>
            <%= m.text_field :first_name, required: true, placeholder: "Hal. Juan", class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-3 text-xs outline-none transition placeholder:text-slate-400 focus:border-[#2445b8] focus:ring-2 focus:ring-blue-100 lg:text-[14px]" %>
          </div>
          <div>
            <%= m.label :middle_name, "Gitnang Pangalan (Opsyonal)", class: "mb-1 block text-[10px] font-semibold text-slate-800 lg:text-[12px]" %>
            <%= m.text_field :middle_name, placeholder: "Hal. Santos", class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-3 text-xs outline-none transition placeholder:text-slate-400 focus:border-[#2445b8] focus:ring-2 focus:ring-blue-100 lg:text-[14px]" %>
          </div>
          <div>
            <%= m.label :suffix, "Dugtong sa Pangalan (Opsyonal)", class: "mb-1 block text-[10px] font-semibold text-slate-800 lg:text-[12px]" %>
            <%= m.select :suffix, ["Jr.", "Sr.", "II", "III", "IV", "V"], { include_blank: "Pumili ng dugtong sa pangalan..." }, { class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-3 text-xs outline-none transition focus:border-[#2445b8] focus:ring-2 focus:ring-blue-100 lg:text-[14px]" } %>
          </div>
      </div>
    </section>

    <section class="rounded-xl border border-slate-100 p-4 sm:p-5" aria-labelledby="household-address-title">
      <div class="mb-4 flex items-center gap-2">
        <span class="flex h-7 w-7 items-center justify-center rounded-full bg-emerald-100"><%= image_tag "location.svg", alt: "", class: "h-4 w-4 object-contain" %></span>
        <h2 id="household-address-title" class="text-sm font-bold text-slate-900">Saan nakatira ang sambahayan?</h2>
      </div>
      <div class="grid gap-x-4 gap-y-3 sm:grid-cols-2">
        <div>
          <%= f.label :purok, class: "mb-1 block text-[10px] font-semibold text-slate-800 lg:text-[12px]" do %>Purok / Lugar <span class="text-red-600">*</span><% end %>
          <%= f.select :purok, (1..7).map { |number| ["Purok #{number}", number.to_s] }, { include_blank: "Pumili ng Purok..." }, { required: true, class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-3 text-xs outline-none transition focus:border-[#2445b8] focus:ring-2 focus:ring-blue-100 lg:text-[14px]" } %>
        </div>
        <div>
          <%= f.label :street, "Subdibisyon / Kalye (Opsyonal)", class: "mb-1 block text-[10px] font-semibold text-slate-800 lg:text-[12px]" %>
          <%= f.select :street, ["Villa Emilia Subd.", "Elizaville Subd", "Carmen Park Subd.", "AGL Heights Subd.", "Cristina Homes", "United Village", "Cabanatuan East", "San Fernando Village"], { include_blank: "Pumili ng kalye / sitio / subdibisyon..." }, { class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-3 text-xs outline-none transition focus:border-[#2445b8] focus:ring-2 focus:ring-blue-100 lg:text-[14px]" } %>
        </div>
        <div>
          <%= f.label :house_number, "Numero ng Bahay / Lote (Opsyonal)", class: "mb-1 block text-[10px] font-semibold text-slate-800 lg:text-[12px]" %>
          <%= f.text_field :house_number, placeholder: "Hal. Bloke 2, Lote 14", class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-3 text-xs outline-none transition placeholder:text-slate-400 focus:border-[#2445b8] focus:ring-2 focus:ring-blue-100 lg:text-[14px]" %>
        </div>
      </div>
    </section>

    <section class="rounded-xl border border-slate-100 p-4 sm:p-5" aria-labelledby="household-member-details-title">
      <div class="mb-4 flex items-center gap-2">
        <span class="flex h-6 w-6 items-center justify-center rounded-full bg-indigo-100 text-[11px] font-bold text-[#07349e]">2</span>
        <h2 id="household-member-details-title" class="text-sm font-bold text-slate-900">Dagdag na impormasyon <span class="font-normal text-slate-500">(Iba pang mahalagang impormasyon)</span></h2>
      </div>
      <div class="grid gap-x-4 gap-y-3 sm:grid-cols-2">
          <div>
            <%= m.label :birth_date, class: "mb-1 flex items-center gap-1.5 text-[10px] font-semibold text-slate-800 lg:text-[12px]" do %><%= image_tag "calendar.svg", alt: "", class: "h-4 w-4 object-contain" %> Petsa ng Kapanganakan <span class="text-red-600">*</span><% end %>
            <%= m.date_field :birth_date, required: true, class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-3 text-xs outline-none transition focus:border-[#2445b8] focus:ring-2 focus:ring-blue-100 lg:text-[14px]" %>
          </div>
          <div>
            <%= m.label :birth_place, class: "mb-1 block text-[10px] font-semibold text-slate-800 lg:text-[12px]" do %>Lugar ng Kapanganakan <span class="text-red-600">*</span><% end %>
            <%= m.text_field :birth_place, required: true, placeholder: "Hal. Lungsod ng Cabanatuan", class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-3 text-xs outline-none transition placeholder:text-slate-400 focus:border-[#2445b8] focus:ring-2 focus:ring-blue-100 lg:text-[14px]" %>
          </div>
          <div>
            <%= m.label :sex, class: "mb-1 block text-[10px] font-semibold text-slate-800 lg:text-[12px]" do %>Kasarian <span class="text-red-600">*</span><% end %>
            <%= m.select :sex, HouseholdMember.sexes.keys.map { |sex| [tagalog_label(sex), sex] }, { include_blank: "Pumili ng kasarian..." }, { required: true, class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-3 text-xs outline-none transition focus:border-[#2445b8] focus:ring-2 focus:ring-blue-100 lg:text-[14px]" } %>
          </div>
          <div>
            <%= m.label :civil_status, class: "mb-1 block text-[10px] font-semibold text-slate-800 lg:text-[12px]" do %>Katayuang Sibil <span class="text-red-600">*</span><% end %>
            <%= m.select :civil_status, HouseholdMember.civil_statuses.keys.map { |status| [tagalog_label(status), status] }, { include_blank: "Pumili ng katayuan..." }, { required: true, class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-3 text-xs outline-none transition focus:border-[#2445b8] focus:ring-2 focus:ring-blue-100 lg:text-[14px]" } %>
          </div>
          <div>
            <%= m.label :citizenship, class: "mb-1 block text-[10px] font-semibold text-slate-800 lg:text-[12px]" do %>Pagkamamamayan <span class="text-red-600">*</span><% end %>
            <%= m.text_field :citizenship, required: true, placeholder: "Filipino", class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-3 text-xs outline-none transition placeholder:text-slate-400 focus:border-[#2445b8] focus:ring-2 focus:ring-blue-100 lg:text-[14px]" %>
          </div>
          <div>
            <%= m.label :occupation, class: "mb-1 block text-[10px] font-semibold text-slate-800 lg:text-[12px]" do %>Hanapbuhay <span class="text-red-600">*</span><% end %>
            <%= m.select :occupation, occupations.map { |occupation| [occupation, occupation] } + [["Iba pa", "Other"]], { include_blank: "Pumili ng hanapbuhay...", selected: custom_occupation ? "Other" : m.object.occupation }, { required: true, onchange: "const customField = this.parentElement.querySelector('[data-custom-occupation]'); const customInput = customField.querySelector('input'); const showCustom = this.value === 'Other'; customField.classList.toggle('hidden', !showCustom); customInput.disabled = !showCustom; if (showCustom) customInput.focus();", class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-3 text-xs outline-none transition focus:border-[#2445b8] focus:ring-2 focus:ring-blue-100 lg:text-[14px]" } %>
            <div data-custom-occupation class="<%= custom_occupation ? 'mt-2' : 'mt-2 hidden' %>">
              <%= m.text_field :occupation, value: (m.object.occupation if custom_occupation), disabled: !custom_occupation, required: custom_occupation, placeholder: "Ilagay ang hanapbuhay", class: "w-full rounded-lg border border-slate-200 bg-white px-3 py-3 text-xs outline-none transition placeholder:text-slate-400 focus:border-[#2445b8] focus:ring-2 focus:ring-blue-100 lg:text-[14px]" %>
            </div>
          </div>
      </div>
    </section>
    <% end %>

    <div class="flex items-start gap-2 rounded-lg bg-[#e7efff] px-4 py-3 text-[10px] font-medium leading-relaxed text-slate-700 lg:text-[11px]">
      <%= image_tag "shield.svg", alt: "", class: "mt-0.5 h-4 w-4 shrink-0 object-contain" %>
      <p>Sumusunod ang mga tala sa Republic Act 10173 (Batas sa Pagkapribado ng Datos) at mga alituntunin ng DILG para sa talaan ng barangay.</p>
    </div>
  </div>

  <footer class="flex shrink-0 items-center justify-between gap-3 border-t border-slate-100 bg-white px-5 py-4 sm:px-8 lg:px-10">
    <button type="button" onclick="const drawer = this.closest('[data-household-drawer]'); drawer.classList.add('animate-slide-out'); setTimeout(() => document.getElementById('remote_modal').innerHTML = '', 220)" class="rounded-lg bg-red-700 px-6 py-3 text-xs font-semibold text-white transition hover:bg-red-800 lg:min-w-[160px] lg:text-[13px]">Kanselahin</button>
    <%= f.submit "I-save ang Sambahayan", class: "cursor-pointer rounded-lg bg-[#2445b8] px-6 py-3 text-xs font-semibold text-white shadow-sm transition hover:bg-[#17379f] lg:min-w-[205px] lg:text-[13px]" %>
  </footer>
<% end %>
