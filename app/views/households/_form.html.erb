<%= form_with model: household, local: true do |f| %>

  <% if household.errors.any? %>
    <div class="mb-6 rounded border border-red-200 bg-red-50 p-4 text-sm text-red-700">
      <h4 class="font-semibold">
        Please review the following errors:
      </h4>

      <ul class="mt-2 list-disc pl-5">
        <% household.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- SECTION A -->
  <fieldset class="mb-6 rounded border border-gray-300 p-5">
    <legend class="px-2 text-sm font-semibold text-gray-800">
      SECTION A: HOUSEHOLD ADDRESS & IDENTIFIER INFO
    </legend>

    <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">

      <div>
        <%= f.label :house_number, "House/Bldg Number *",
                    class: "mb-1 block text-sm font-medium text-gray-700" %>

        <%= f.text_field :house_number,
                         required: true,
                         class: "w-full rounded border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none" %>
      </div>

      <div>
        <%= f.label :street, "Street *",
                    class: "mb-1 block text-sm font-medium text-gray-700" %>

        <%= f.text_field :street,
                         required: true,
                         class: "w-full rounded border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none" %>
      </div>

      <div>
        <%= f.label :purok, "Purok Sector *",
                    class: "mb-1 block text-sm font-medium text-gray-700" %>

        <%= f.text_field :purok,
                         required: true,
                         class: "w-full rounded border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none" %>
      </div>

      <div>
        <%= f.label :date_accomplished, "Survey Completion Date *",
                    class: "mb-1 block text-sm font-medium text-gray-700" %>

        <%= f.date_field :date_accomplished,
                         value: household.date_accomplished || Date.current,
                         required: true,
                         class: "w-full rounded border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none" %>
      </div>

    </div>
  </fieldset>

  <!-- SECTION B -->
  <fieldset class="mb-6 rounded border border-gray-300 p-5">
    <legend class="px-2 text-sm font-semibold text-gray-800">
      SECTION B: HOUSEHOLD FAMILY MEMBERS LIST DETAILS
    </legend>

    <p class="mt-2 text-sm text-gray-500">
      Enter the personal information for each resident living in this household.
    </p>

    <div id="members-forms-list" class="mt-5">
      <%= f.fields_for :household_members do |m| %>

        <div class="mb-6 border-b border-dashed border-gray-300 pb-6 last:mb-0 last:border-b-0">

          <h4 class="mb-4 text-sm font-semibold text-gray-800">
            Resident Member
          </h4>

          <!-- NAME & RELATIONSHIP -->
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5">

            <div>
              <%= m.label :first_name, "First Name *",
                          class: "mb-1 block text-sm font-medium text-gray-700" %>

              <%= m.text_field :first_name,
                               required: true,
                               class: "w-full rounded border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none" %>
            </div>

            <div>
              <%= m.label :middle_name, "Middle Name",
                          class: "mb-1 block text-sm font-medium text-gray-700" %>

              <%= m.text_field :middle_name,
                               class: "w-full rounded border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none" %>
            </div>

            <div>
              <%= m.label :last_name, "Last Name *",
                          class: "mb-1 block text-sm font-medium text-gray-700" %>

              <%= m.text_field :last_name,
                               required: true,
                               class: "w-full rounded border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none" %>
            </div>

            <div>
              <%= m.label :suffix, "Suffix",
                          class: "mb-1 block text-sm font-medium text-gray-700" %>

              <%= m.text_field :suffix,
                               placeholder: "Jr/Sr",
                               class: "w-full rounded border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none" %>
            </div>

            

          </div>

          <!-- PERSONAL INFORMATION -->
          <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">

            <div>
              <%= m.label :birth_date, "Birth Date *",
                          class: "mb-1 block text-sm font-medium text-gray-700" %>

              <%= m.date_field :birth_date,
                               required: true,
                               class: "w-full rounded border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none" %>
            </div>

            <div>
              <%= m.label :birth_place, "Birth Place *",
                          class: "mb-1 block text-sm font-medium text-gray-700" %>

              <%= m.text_field :birth_place,
                               required: true,
                               class: "w-full rounded border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none" %>
            </div>

            <div>
              <%= m.label :sex, "Sex *",
                          class: "mb-1 block text-sm font-medium text-gray-700" %>

              <%= m.select :sex,
                           HouseholdMember.sexes.keys.map { |s| [s.humanize, s] },
                           { include_blank: "Select" },
                           {
                             required: true,
                             class: "w-full rounded border border-gray-300 bg-white px-3 py-2 text-sm focus:border-blue-500 focus:outline-none"
                           } %>
            </div>

            <div>
              <%= m.label :civil_status, "Civil Status *",
                          class: "mb-1 block text-sm font-medium text-gray-700" %>

              <%= m.select :civil_status,
                           HouseholdMember.civil_statuses.keys.map { |c| [c.humanize, c] },
                           { include_blank: "Select" },
                           {
                             required: true,
                             class: "w-full rounded border border-gray-300 bg-white px-3 py-2 text-sm focus:border-blue-500 focus:outline-none"
                           } %>
            </div>

            <div>
              <%= m.label :citizenship, "Citizenship",
                          class: "mb-1 block text-sm font-medium text-gray-700" %>

              <%= m.text_field :citizenship,
                               class: "w-full rounded border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none" %>
            </div>

            <div>
              <%= m.label :occupation, "Occupation / Source of Livelihood",
                          class: "mb-1 block text-sm font-medium text-gray-700" %>

              <%= m.text_field :occupation,
                               placeholder: "Driver, Teacher, None",
                               class: "w-full rounded border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none" %>
            </div>

          </div>

        </div>

      <% end %>
    </div>
  </fieldset>

  <!-- ACTIONS -->
  <div class="flex items-center gap-3">
    <%= f.submit "Save Census Registry File",
                 class: "rounded bg-blue-600 px-5 py-2.5 text-sm font-medium text-white hover:bg-blue-700" %>

    <%= link_to "Cancel and Return",
                admin_residents_path,
                class: "text-sm text-gray-600 hover:text-gray-800" %>
  </div>

<% end %>