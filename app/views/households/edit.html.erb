<%= turbo_frame_tag "remote_modal" do %>
  <!-- OVERLAY BACKDROP SHADOW EFFECT -->
  <div class="fixed inset-0 z-50 flex justify-end bg-black/40 backdrop-blur-sm">
    
    <!-- RIGHT SIDE SLIDING DRAWER SHEET PANEL CONTAINER -->
    <div class="h-screen w-full max-w-2xl overflow-y-auto bg-white shadow-2xl flex flex-col animate-slide-in">

      <%= form_with model: @household, local: true, class: "h-full flex flex-col" do |f| %>

        <!-- STICKY DRAWER PANEL HEADER CONTROLS -->
        <div class="sticky top-0 z-10 flex items-center justify-between border-b bg-gray-50 p-5">
          <div>
            <h2 class="text-xl font-bold text-gray-800">
              Edit Household Information
            </h2>
            <p class="mt-0.5 text-xs text-gray-500 font-medium">
              Modifying Record #<%= @household.id %> · Barangay Census Registry
            </p>
          </div>

          <!-- CLOSES DRAWER VIA THE ASSIGNABLE INTERFACE METHOD -->
          <%= link_to "✕", "#",
                      class: "rounded-lg p-2 text-xl text-gray-400 hover:bg-gray-100 hover:text-gray-700 transition",
                      data: { action: "click->remote-modal#close" } %>
        </div>

        <!-- MAIN FORM BODY AREA -->
        <div class="flex-1 overflow-y-auto p-6 space-y-6 bg-slate-50/50">

          <% if @household.errors.any? %>
            <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700">
              <h4 class="font-semibold">Please fix the following errors:</h4>
              <ul class="mt-2 list-disc pl-5">
                <% @household.errors.full_messages.each do |msg| %>
                  <li><%= msg %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <!-- MAIN FIELD ENTITIES FORM CARD -->
          <section class="bg-white rounded-xl border p-5 shadow-sm space-y-4">
            <div class="border-b pb-2">
              <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider">
                Location & Survey Information
              </h3>
            </div>

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <%= f.label :house_number, "House / Building Number *", class: "mb-1 block text-xs font-semibold text-gray-600 uppercase tracking-wider" %>
                <%= f.text_field :house_number, required: true, class: "w-full rounded border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none" %>
              </div>

              <div>
                <%= f.label :street, "Street *", class: "mb-1 block text-xs font-semibold text-gray-600 uppercase tracking-wider" %>
                <%= f.text_field :street, required: true, class: "w-full rounded border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none" %>
              </div>

              <div>
                <%= f.label :purok, "Purok *", class: "mb-1 block text-xs font-semibold text-gray-600 uppercase tracking-wider" %>
                <%= f.text_field :purok, required: true, class: "w-full rounded border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none" %>
              </div>

              <div>
                <%= f.label :date_accomplished, "Date Accomplished *", class: "mb-1 block text-xs font-semibold text-gray-600 uppercase tracking-wider" %>
                <%= f.date_field :date_accomplished, required: true, class: "w-full rounded border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none" %>
              </div>
            </div>
          </section>

        </div>

        <!-- STICKY BOTTOM BUTTON BAR ACTION LAYOUT -->
        <div class="sticky bottom-0 z-10 flex items-center justify-end gap-3 border-t bg-gray-50 p-4">
          <%= link_to "Cancel", "#",
                      class: "rounded-lg border bg-white px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-100 transition",
                      data: { action: "click->remote-modal#close" } %>

          <%= f.submit "Update Household",
                       class: "cursor-pointer rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-blue-700 transition" %>
        </div>

      <% end %>

    </div>
  </div>
<% end %>
