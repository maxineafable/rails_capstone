<%# app/views/households/edit.html.erb %>

<div class="flex">
  <%= render "admin/sidebar" %>

  <div class="flex-1 space-y-6 p-8">

    <header class="rounded-xl border bg-white p-6">
      <h2 class="text-2xl font-bold text-gray-800">
        Edit Household Information
      </h2>

      <p class="mt-1 text-sm text-gray-500">
        Modify household information for Record #<%= @household.id %>
      </p>
    </header>

    <section class="rounded-xl border bg-white p-6">

      <% if @household.errors.any? %>
        <div class="mb-6 rounded border border-red-200 bg-red-50 p-4 text-sm text-red-700">
          <h4 class="font-semibold">Please fix the following errors:</h4>

          <ul class="mt-2 list-disc pl-5">
            <% @household.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @household, local: true do |f| %>

        <div>
          <h3 class="mb-4 text-lg font-semibold text-gray-800">
            Household Information
          </h3>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">

            <div>
              <%= f.label :house_number, "House / Building Number *",
                          class: "mb-1 block text-sm font-medium text-gray-700" %>

              <%= f.text_field :house_number,
                               required: true,
                               class: "w-full rounded border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none" %>
            </div>

            <div>
              <%= f.label :street, "Street *",
                          class: "mb-1 block text-sm font-medium text-gray-700" %>

              <%= f.text_field :street,
                               required: true,
                               class: "w-full rounded border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none" %>
            </div>

            <div>
              <%= f.label :purok, "Purok *",
                          class: "mb-1 block text-sm font-medium text-gray-700" %>

              <%= f.text_field :purok,
                               required: true,
                               class: "w-full rounded border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none" %>
            </div>

            <div>
              <%= f.label :date_accomplished, "Date Accomplished *",
                          class: "mb-1 block text-sm font-medium text-gray-700" %>

              <%= f.date_field :date_accomplished,
                               required: true,
                               class: "w-full rounded border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none" %>
            </div>

          </div>
        </div>

        <div class="mt-6 flex items-center gap-3 border-t pt-6">
          <%= f.submit "Update Household",
                       class: "rounded bg-blue-600 px-5 py-2.5 text-sm font-medium text-white hover:bg-blue-700" %>

          <%= link_to "Cancel",
                      household_path(@household),
                      class: "rounded border px-5 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-50" %>
        </div>

      <% end %>
    </section>

  </div>
</div>